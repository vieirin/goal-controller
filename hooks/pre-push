#!/bin/bash

# Block push if commits being pushed fail oxfmt --check or oxlint.
# Runs tests only for packages touched by the push (and their dependents).

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO="0000000000000000000000000000000000000000"
TMP="$(mktemp)"
ALL="$(mktemp)"
trap 'rm -f "$TMP" "$ALL"' EXIT

# Collect every path in the commits being pushed (one ref line per push).
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi
  if [ "$remote_sha" = "$ZERO" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      range="$(git merge-base origin/main "$local_sha")..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  git diff --name-only "$range"
done | awk 'NF && !seen[$0]++' >"$ALL"

# Lint/format: source-like files that still exist in the tree.
awk '
  /node_modules\// { next }
  /\.(ts|tsx|js|jsx|mjs|cjs|json|css)$/ { print }
' "$ALL" | while IFS= read -r file; do
  [ -f "$file" ] && printf '%s\n' "$file"
done >"$TMP"

if [ ! -s "$TMP" ]; then
  echo "✅ No source files in push range to lint/format-check."
else
  COUNT="$(wc -l <"$TMP" | tr -d ' ')"
  echo "🔍 Checking format (oxfmt) on ${COUNT} file(s)..."
  # shellcheck disable=SC2046
  if ! pnpm exec oxfmt --check $(cat "$TMP"); then
    echo ""
    echo "❌ Format check failed. Push aborted."
    echo "Run: pnpm format"
    echo "Or commit again so the post-commit hook can amend formatting."
    exit 1
  fi
  echo "✅ Format check passed."
  echo ""

  # oxlint lints JS/TS only: given nothing else (a JSON or CSS change) it exits with an error
  LINT="$(grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' "$TMP" || true)"
  if [ -z "$LINT" ]; then
    echo "✅ No JS/TS files in push range to lint."
    echo ""
  else
    echo "🔍 Running oxlint on $(printf '%s\n' "$LINT" | wc -l | tr -d ' ') file(s)..."
    # shellcheck disable=SC2086
    if ! pnpm exec oxlint --ignore-pattern '**/node_modules/**' $LINT; then
      echo ""
      echo "❌ Oxlint errors found. Push aborted."
      echo "Run: pnpm lint:fix"
      exit 1
    fi
    echo "✅ Oxlint passed."
    echo ""
  fi
fi

# Packages whose sources or package.json changed in the push, plus dependents
# (dialect ← goal-language ← goal-tree ← lib ← ui).
PKGS="$(
  awk '
    BEGIN { d=0; gl=0; gt=0; l=0; u=0 }
    /^packages\/dialect\// { d=1 }
    /^packages\/goal-language\// { gl=1 }
    /^packages\/goal-tree\// { gt=1 }
    /^packages\/lib\// { l=1 }
    /^packages\/ui\// { u=1 }
    END {
      if (d) { gl=1; gt=1; l=1; u=1 }
      if (gl) { gt=1; l=1; u=1 }
      if (gt) { l=1; u=1 }
      if (l) { u=1 }
      if (d) print "dialect"
      if (gl) print "goal-language"
      if (gt) print "goal-tree"
      if (l) print "lib"
      if (u) print "ui"
    }
  ' "$ALL"
)"

if [ -z "$PKGS" ]; then
  echo "✅ No package sources in push range; skipping tests."
  echo "✅ All checks passed. Proceeding with push..."
  exit 0
fi

echo "🔍 Affected packages: $(printf '%s' "$PKGS" | tr '\n' ' ')"

# Build only what the suites below need (lib/ui import the other packages' out/).
BUILD_PLAN="$(
  printf '%s\n' "$PKGS" | awk '
    /^(ui|lib)$/ { l=1 }
    /^goal-tree$/ { t=1 }
    /^goal-language$/ { g=1 }
    /^dialect$/ { d=1 }
    END {
      if (l) { print "build:lib"; exit }
      if (t) { print "tree"; exit }
      if (g) { print "lang"; exit }
      if (d) { print "dialect"; exit }
    }
  '
)"
case "$BUILD_PLAN" in
  build:lib)
    echo "🔨 Building lib (and its dependencies)..."
    pnpm run build:lib
    ;;
  tree)
    echo "🔨 Building dialect, goal-language, goal-tree..."
    pnpm run build:dialect && pnpm run build:goal-language && pnpm run build:goal-tree
    ;;
  lang)
    echo "🔨 Building dialect, goal-language..."
    pnpm run build:dialect && pnpm run build:goal-language
    ;;
  dialect)
    echo "🔨 Building dialect..."
    pnpm run build:dialect
    ;;
esac

echo "🔍 Running tests for affected packages..."
failed=0
while IFS= read -r pkg; do
  [ -z "$pkg" ] && continue
  echo "→ @goal-controller/$pkg"
  if ! pnpm --filter "@goal-controller/$pkg" run test; then
    failed=1
    break
  fi
done <<<"$PKGS"

if [ "$failed" -ne 0 ]; then
  echo ""
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed. Proceeding with push..."
exit 0
