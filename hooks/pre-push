#!/bin/bash

# Block push if commits being pushed fail oxfmt --check or oxlint.
# Also runs the test suite.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

ZERO="0000000000000000000000000000000000000000"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then
    continue
  fi
  if [ "$remote_sha" = "$ZERO" ]; then
    if git rev-parse --verify origin/main >/dev/null 2>&1; then
      range="$(git merge-base origin/main "$local_sha")..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  git diff --name-only "$range" | while IFS= read -r file; do
    case "$file" in
      *node_modules*|*antlr*) continue ;;
    esac
    case "$file" in
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css)
        if [ -f "$file" ]; then
          printf '%s\n' "$file"
        fi
        ;;
    esac
  done
done | awk 'NF && !seen[$0]++' >"$TMP"

if [ ! -s "$TMP" ]; then
  echo "✅ No source files in push range to lint/format-check."
else
  COUNT="$(wc -l <"$TMP" | tr -d ' ')"
  echo "🔍 Checking format (oxfmt) on ${COUNT} file(s)..."
  # shellcheck disable=SC2046
  if ! pnpm exec oxfmt --check $(cat "$TMP"); then
    echo ""
    echo "❌ Format check failed. Push aborted."
    echo "Run: pnpm format"
    echo "Or commit again so the post-commit hook can amend formatting."
    exit 1
  fi
  echo "✅ Format check passed."
  echo ""

  # oxlint lints JS/TS only: given nothing else (a JSON or CSS change) it exits with an error
  LINT="$(grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' "$TMP" || true)"
  if [ -z "$LINT" ]; then
    echo "✅ No JS/TS files in push range to lint."
    echo ""
  else
    echo "🔍 Running oxlint on $(printf '%s\n' "$LINT" | wc -l | tr -d ' ') file(s)..."
    # shellcheck disable=SC2086
    if ! pnpm exec oxlint --ignore-pattern '**/antlr/**' --ignore-pattern '**/node_modules/**' $LINT; then
      echo ""
      echo "❌ Oxlint errors found. Push aborted."
      echo "Run: pnpm lint:fix"
      exit 1
    fi
    echo "✅ Oxlint passed."
    echo ""
  fi
fi

echo "🔍 Running tests..."
if ! pnpm test; then
  echo ""
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed. Proceeding with push..."
exit 0
