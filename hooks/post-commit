#!/bin/bash

# Format and auto-fix committed files with oxfmt/oxlint, then amend if needed.
# Ensures pushes already contain linted, formatted code.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Avoid rewriting commits that are already on the remote
if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  if git merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
    echo "⏭️  HEAD is already on the remote; skipping format amend."
    exit 0
  fi
fi

echo "🎨 Running oxfmt + oxlint --fix on committed files..."

COMMITTED_FILES="$(git diff-tree --no-commit-id --name-only -r HEAD)"

FILES=()
while IFS= read -r file; do
  case "$file" in
    *node_modules*) continue ;;
  esac
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.json|*.css)
      if [ -f "$file" ]; then
        FILES+=("$file")
      fi
      ;;
  esac
done <<< "$COMMITTED_FILES"

if [ ${#FILES[@]} -eq 0 ]; then
  echo "✅ No source files to format or lint."
  exit 0
fi

echo "Files:"
for file in "${FILES[@]}"; do
  echo "  - $file"
done

pnpm exec oxfmt "${FILES[@]}"
pnpm exec oxlint --fix "${FILES[@]}" || true

HAS_CHANGES=false
for file in "${FILES[@]}"; do
  if ! git diff --quiet -- "$file"; then
    git add -- "$file"
    HAS_CHANGES=true
  fi
done

if [ "$HAS_CHANGES" = true ]; then
  echo "📝 Amending commit with lint/format fixes..."
  git commit --amend --no-edit --no-verify >/dev/null
  echo "✅ Commit amended."
else
  echo "✅ Already linted and formatted."
fi

exit 0
