node_modules/
packages/*/node_modules/

# Build outputs
out/
packages/lib/out/
packages/ui/.next/
packages/ui/.next-e2e/
packages/ui/out/
# Next rewrites this to the active distDir's routes.d.ts (.next for dev, .next-e2e
# for e2e, goal-controller#424): no single committed content can match both, and
# tsc doesn't need the file to exist (next dev/build regenerate it when missing).
packages/ui/next-env.d.ts

# Playwright e2e
packages/ui/test-results/
packages/ui/playwright-report/

# Output directory
output/

# Database
packages/ui/data/
data/

# Logs
logs/
*.log

# Python
__pycache__/
*.pyc

# edgeV2 conformance harness scratch files (left behind if a run is interrupted)
experiments/edgev2-conformance/**/.manifest.json
experiments/edgev2-conformance/**/.prism.sh
examples/edgeV2/generated/**/.manifest.json
examples/edgeV2/generated/**/.prism.sh

# Environment files
.env*.local
venv/

# Editor
.DS_Store
.vscode/
.idea/

# pnpm
.pnpm-debug.log
node_modules/.ignored
.vercel

packages/ui/.next/
packages/lib/out/
