{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "examples/**",
    "dissertationExamples/**",
    "old_examples/**",
    "experiments/**",
    "input/**",
    "output/**",
    "logs/**",
    "reference/**",
    "result_plots/**",
    "packages/lib/test/dialect/reference/**",
    "packages/goal-language/src/generated/**",
    "packages/lib/test/engines/edgeFamily/antlr-oracle.json"
  ]
}
