const int decision_GG0 = 2;
const int decision_GG0_ = 4;
module GG0 //committed 
gG0: [0..1] init 0;
gG0_chosen: [0..2] init 0;
[pursue_GG0] !gG0_achieved & gG0 = 0 -> (gG0'=1);
[pursue_GG1] !gG0_achieved & gG0=1 & gG0_chosen=0 & GG0_achievable*N>decision_GG0 & gG8=0  & (GG1_achievable/(GG1_achievable+GG8_achievable+0))*N > decision_GG0_ -> (gG0_chosen'=1); 
[pursue_GG1] !gG0_achieved & gG0=1 & gG0_chosen=1 & GG1_achievable*N > decision_GG1 -> true;
[pursue_GG8] !gG0_achieved & gG0=1 & gG0_chosen=0 & GG0_achievable*N>decision_GG0 & gG1=0  & (GG8_achievable/(GG1_achievable+GG8_achievable+0))*N > decision_GG0_ & !((GG1_achievable/(GG1_achievable+GG8_achievable+0))*N > decision_GG0_) -> (gG0_chosen'=2); 
[pursue_GG8] !gG0_achieved & gG0=1 & gG0_chosen=2 & GG8_achievable*N > decision_GG8 -> true;
[skip_GG0] gG0_chosen=0 & !gG0_achieved & gG0=1 & gG1=0 & gG8=0 & GG0_achievable * N <= decision_GG0 -> (gG0'=0);
[skip_GG0] !gG0_achieved & gG0=1 & gG1=0 & gG0_chosen=1 & GG1_achievable*N <= decision_GG1 -> (gG0'=0);
[skip_GG0] !gG0_achieved & gG0=1 & gG8=0 & gG0_chosen=2 & GG8_achievable*N <= decision_GG8 -> (gG0'=0);
[achieved_GG0] gG0=1 & gG0_achieved & gG1=0 & gG8=0 -> (gG0'=0); 
 endmodule
formula gG0_achieved = (false | gG1_achieved | gG8_achieved);
formula GG0_achievable = gG0_chosen=1 ? GG1_achievable:gG0_chosen=2 ? GG8_achievable:(0 + GG1_achievable + GG8_achievable - 1 * GG1_achievable * GG8_achievable );
