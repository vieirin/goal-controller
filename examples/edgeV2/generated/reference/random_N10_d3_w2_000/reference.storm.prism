dtmc
const int N=10;
const double GT3_achievable = 0.8;
formula gT3_achieved = (gT3_achieved_=1);
const int decision_GT3 = 2;
module taskT3 
gT3: [0..1] init 0;
gT3_achieved_: [0..1] init 0;
[pursue_GT3] gT3=0 & gT3_achieved_=0 -> (gT3'=1);
[try_GT3] gT3=1 & gT3_achieved_=0 -> GT3_achievable: (gT3_achieved_'=1) + 1-GT3_achievable: (gT3'=0);
[achieved_GT3] gT3=1 & gT3_achieved_=1 -> (gT3'=0);
endmodule


const double GT4_achievable = 0.8;
formula gT4_achieved = (gT4_achieved_=1);
const int decision_GT4 = 2;
module taskT4 
gT4: [0..1] init 0;
gT4_achieved_: [0..1] init 0;
[pursue_GT4] gT4=0 & gT4_achieved_=0 -> (gT4'=1);
[try_GT4] gT4=1 & gT4_achieved_=0 -> GT4_achievable: (gT4_achieved_'=1) + 1-GT4_achievable: (gT4'=0);
[achieved_GT4] gT4=1 & gT4_achieved_=1 -> (gT4'=0);
endmodule


const int decision_GG2 = 2;
const int decision_GG2_ = 4;
module GG2 //interleaved 
gG2: [0..1] init 0;
[pursue_GG2] !gG2_achieved & gG2 = 0 -> (gG2'=1);
[pursue_GT3] !gG2_achieved & gG2=1 & GT3_achievable*N>decision_GT3 -> true; 
[pursue_GT4] !gG2_achieved & gG2=1 & GT4_achievable*N>decision_GT4 -> true; 
[skip_GG2] !gG2_achieved & gG2=1 & gT3=0 & gT4=0 & !(GT3_achievable*N>decision_GT3 | GT4_achievable*N>decision_GT4 | false) -> (gG2'=0);
[achieved_GG2] gG2=1 & gG2_achieved & gT3=0 & gT4=0 -> (gG2'=0); 
 endmodule
formula gG2_achieved = (true & gT3_achieved & gT4_achieved);
formula GG2_achievable = gG2_achieved ? 0 : 1* (!gT3_achieved ? GT3_achievable : 1)* (!gT4_achieved ? GT4_achievable : 1);


