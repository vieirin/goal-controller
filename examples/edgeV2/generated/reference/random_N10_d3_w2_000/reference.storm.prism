const int decision_GG8 = 2;
const int decision_GG8_ = 4;
module GG8 //non-idempotent 
gG8: [0..1] init 0;
[pursue_GG8] !gG8_achieved & gG8 = 0 -> (gG8'=1);
[pursue_GG9] !gG8_achieved & gG8=1 & GG8_achievable*N>decision_GG8 & gG12=0  & (GG9_achievable/(GG9_achievable+GG12_achievable+0))*N > decision_GG8_ -> true; 
[pursue_GG12] !gG8_achieved & gG8=1 & GG8_achievable*N>decision_GG8 & gG9=0  & (GG12_achievable/(GG9_achievable+GG12_achievable+0))*N > decision_GG8_ & !((GG9_achievable/(GG9_achievable+GG12_achievable+0))*N > decision_GG8_) -> true; 
