const int decision_GG5 = 2;
const int decision_GG5_ = 4;
module GG5 //fixed 
gG5: [0..1] init 0;
[pursue_GG5] !gG5_achieved & gG5 = 0 -> (gG5'=1);
[pursue_GT6] !gG5_achieved & gG5=1 & GG5_achievable*N>decision_GG5 & gT7=0-> true; 
[pursue_GT7] !gG5_achieved & gG5=1 & GG5_achievable*N>decision_GG5 & gT6_achieved & gT6=0-> true; 
[skip_GG5] !gG5_achieved & gG5=1 & gT6=0 & gT7=0 & GG5_achievable * N <= decision_GG5 -> (gG5'=0);
[achieved_GG5] gG5=1 & gG5_achieved & gT6=0 & gT7=0 -> (gG5'=0); 
 endmodule
formula gG5_achieved = (true & gT6_achieved & gT7_achieved);
formula GG5_achievable = gG5_achieved ? 0 : 1* (!gT6_achieved ? GT6_achievable : 1)* (!gT7_achieved ? GT7_achievable : 1);


const int decision_GG1 = 2;
const int decision_GG1_ = 4;
module GG1 //non-idempotent 
gG1: [0..1] init 0;
[pursue_GG1] !gG1_achieved & gG1 = 0 -> (gG1'=1);
[pursue_GG2] !gG1_achieved & gG1=1 & GG1_achievable*N>decision_GG1 & gG5=0  & (GG2_achievable/(GG2_achievable+GG5_achievable+0))*N > decision_GG1_ -> true; 
[pursue_GG5] !gG1_achieved & gG1=1 & GG1_achievable*N>decision_GG1 & gG2=0  & (GG5_achievable/(GG2_achievable+GG5_achievable+0))*N > decision_GG1_ & !((GG2_achievable/(GG2_achievable+GG5_achievable+0))*N > decision_GG1_) -> true; 
[skip_GG1] !gG1_achieved & gG1=1 & gG2=0 & gG5=0 & GG1_achievable * N <= decision_GG1 -> (gG1'=0);
[achieved_GG1] gG1=1 & gG1_achieved & gG2=0 & gG5=0 -> (gG1'=0); 
 endmodule
formula gG1_achieved = (false | gG2_achieved | gG5_achieved);
formula GG1_achievable = 0 + GG2_achievable + GG5_achievable - (1 * GG2_achievable * GG5_achievable );


