endmodule


const int decision_GG3 = 2;
const int decision_GG3_ = 4;
module GG3 //flexible
gG3: [0..1] init 0;
[pursue_GG3] !gG3_achieved & gG3 = 0 -> (gG3'=1);
[pursue_GT4] !gG3_achieved & gG3=1 & GG3_achievable*N>decision_GG3 & gT5=0  & GT4_relative*N>decision_GG3_ -> true; 
[pursue_GT5] !gG3_achieved & gG3=1 & GG3_achievable*N>decision_GG3 & gT4=0  & GT5_relative*N>decision_GG3_ & !GT4_relative*N>decision_GG3_ -> true; 
[skip_GG3] !gG3_achieved & gG3=1 & gT4=0 & gT5=0 & GG3_achievable * N <= decision_GG3 -> (gG3'=0);
[achieved_GG3] gG3=1 & gG3_achieved & gT4=0 & gT5=0 -> (gG3'=0); 
 endmodule
formula gG3_achieved = (true & gT4_achieved & gT5_achieved);
formula GG3_achievable = gG3_achieved ? 0 : 1* (!gT4_achieved ? GT4_achievable : 1)* (!gT5_achieved ? GT5_achievable : 1);
formula GT4_relative = gT4_achieved ? 0 : GT4_achievable/(GT4_achievable + (gT5_achieved ? 0 : GT5_achievable));
formula GT5_relative = gT5_achieved ? 0 : GT5_achievable/(GT5_achievable + (gT4_achieved ? 0 : GT4_achievable));


