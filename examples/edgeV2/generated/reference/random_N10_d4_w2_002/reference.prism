[skip_GG6] !gG6_achieved & gG6=1 & gT7=0 & gG6_failed<3 & GT7_achievable*N <= decision_GT7 -> (gG6'=0);
[pursue_GT7] !gG6_achieved & gG6=1 & gG6_failed=3 & GG6_achievable*N>decision_GG6 & gT8=0  & (GT7_achievable/(GT7_achievable+GT8_achievable+0))*N > decision_GG6_  -> true; 
