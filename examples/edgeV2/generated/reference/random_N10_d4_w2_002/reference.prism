const int N=10;
const double GT4_achievable = 0.8;
formula gT4_achieved = (gT4_achieved_=1);
const int decision_GT4 = 2;
module taskT4 
gT4: [0..1] init 0;
gT4_achieved_: [0..1] init 0;
[pursue_GT4] gT4=0 & gT4_achieved_=0 -> (gT4'=1);
[try_GT4] gT4=1 & gT4_achieved_=0 -> GT4_achievable: (gT4_achieved_'=1) + 1-GT4_achievable: (gT4'=0);
[achieved_GT4] gT4=1 & gT4_achieved_=1 -> (gT4'=0);
endmodule


