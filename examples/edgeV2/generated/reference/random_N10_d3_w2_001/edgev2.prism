dtmc

const int N = 10;
const int decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G12;
const int decision_G2;
const int _decision_G2;
const int decision_G5;
const int _decision_G5;
const int decision_G8;
const int decision_G9;
const int _decision_G9;
const int decision_T10;
const int decision_T11;
const int decision_T13;
const int decision_T14;
const int decision_T3;
const int decision_T4;
const int decision_T6;
const int decision_T7;


// ID: G0
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G1, G8
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G8] !g0_achieved & g0_state=1 & G8_achievable*N > decision_G8 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g8_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g8_state=0 & !(G1_achievable*N > decision_G1 | G8_achievable*N > decision_G8) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g8_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g8_achieved ? G8_achievable : 1);

// ID: G1
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G2, G5
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g5_state=0 & G2_relative*N > _decision_G1 -> true;
  [pursue_G5] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & G5_relative*N > _decision_G1 & !(G2_relative*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g5_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g5_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved & g5_achieved);
formula G1_achievable = g1_achieved ? 0 : (!g2_achieved ? G2_achievable : 1) * (!g5_achieved ? G5_achievable : 1);
formula G2_relative = g2_achieved ? 0 : G2_achievable/(G2_achievable + (g5_achieved ? 0 : G5_achievable));
formula G5_relative = g5_achieved ? 0 : G5_achievable/(G5_achievable + (g2_achieved ? 0 : G2_achievable));

// ID: G2
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T3, T4
module G2
  g2_state : [0..1] init 0;
  t3_failed : [0..3] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed<3 & T3_achievable*N > decision_T3 -> (t3_failed'=t3_failed+1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed=3 & G2_achievable*N > decision_G2 & t4_state=0 & (T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & t3_failed=3 & G2_achievable*N > decision_G2 & t3_state=0 & (T4_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 & !((T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t3_failed<3 & T3_achievable*N <= decision_T3 -> (g2_state'=0);
  [skip_G2] t3_failed=3 & !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved | (t3_failed=3 & t4_achieved));
formula G2_achievable = T3_achievable + T4_achievable - (T3_achievable * T4_achievable);

// ID: G5
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T6, T7
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t7_state=0 & (T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 -> true;
  [pursue_T7] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t6_state=0 & (T7_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 & !((T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5) -> true;

  [achieved_G5] g5_state=1 & g5_achieved & t6_state=0 & t7_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & t6_state=0 & t7_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (t6_achieved | t7_achieved);
formula G5_achievable = T6_achievable + T7_achievable - (T6_achievable * T7_achievable);

// ID: G8
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G9, G12
module G8
  g8_state : [0..1] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_G9] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & g12_state=0 -> true;
  [pursue_G12] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & g9_achieved & g9_state=0 -> true;

  [achieved_G8] g8_state=1 & g8_achieved & g9_state=0 & g12_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & g9_state=0 & g12_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (g9_achieved & g12_achieved);
formula G8_achievable = g8_achieved ? 0 : (!g9_achieved ? G9_achievable : 1) * (!g12_achieved ? G12_achievable : 1);

// ID: G9
// Name: goal
// Type: choice
// Relation to children: or
// Children: T10, T11
module G9
  g9_state : [0..1] init 0;
  g9_chosen : [0..2] init 0;

  [pursue_G9] !g9_achieved & g9_state=0 -> (g9_state'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & g9_chosen=0 & G9_achievable*N > decision_G9 & t11_state=0 & (T10_achievable/(T10_achievable+T11_achievable))*N > _decision_G9 -> (g9_chosen'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & g9_chosen=1 & T10_achievable*N > decision_T10 -> true;
  [pursue_T11] !g9_achieved & g9_state=1 & g9_chosen=0 & G9_achievable*N > decision_G9 & t10_state=0 & (T11_achievable/(T10_achievable+T11_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable))*N > _decision_G9) -> (g9_chosen'=2);
  [pursue_T11] !g9_achieved & g9_state=1 & g9_chosen=2 & T11_achievable*N > decision_T11 -> true;

  [achieved_G9] g9_state=1 & g9_achieved & t10_state=0 & t11_state=0 -> (g9_state'=0);
  
  [skip_G9] g9_chosen=0 & !g9_achieved & g9_state=1 & t10_state=0 & t11_state=0 & G9_achievable*N <= decision_G9 -> (g9_state'=0);
  [skip_G9] !g9_achieved & g9_state=1 & t10_state=0 & g9_chosen=1 & T10_achievable*N <= decision_T10 -> (g9_state'=0);
  [skip_G9] !g9_achieved & g9_state=1 & t11_state=0 & g9_chosen=2 & T11_achievable*N <= decision_T11 -> (g9_state'=0);
endmodule

formula g9_achieved = (t10_achieved | t11_achieved);
formula G9_achievable = g9_chosen=1 ? T10_achievable : g9_chosen=2 ? T11_achievable : (T10_achievable + T11_achievable - (T10_achievable * T11_achievable));

// ID: G12
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T13, T14
module G12
  g12_state : [0..1] init 0;

  [pursue_G12] !g12_achieved & g12_state=0 -> (g12_state'=1);
  [pursue_T13] !g12_achieved & g12_state=1 & G12_achievable*N > decision_G12 & t14_state=0 -> true;
  [pursue_T14] !g12_achieved & g12_state=1 & G12_achievable*N > decision_G12 & t13_achieved & t13_state=0 -> true;

  [achieved_G12] g12_state=1 & g12_achieved & t13_state=0 & t14_state=0 -> (g12_state'=0);
  
  [skip_G12] !g12_achieved & g12_state=1 & t13_state=0 & t14_state=0 & G12_achievable*N <= decision_G12 -> (g12_state'=0);
endmodule

formula g12_achieved = (t13_achieved & t14_achieved);
formula G12_achievable = g12_achieved ? 0 : (!t13_achieved ? T13_achievable : 1) * (!t14_achieved ? T14_achievable : 1);


const double T10_achievable = 0.8;
const double T11_achievable = 0.8;
const double T13_achievable = 0.8;
const double T14_achievable = 0.8;
const double T3_achievable = 0.8;
const double T4_achievable = 0.8;
const double T6_achievable = 0.8;
const double T7_achievable = 0.8;

module ChangeManager
  t10_state: [0..1] init 0;
  t10_achieved_: [0..1] init 0;
  t11_state: [0..1] init 0;
  t11_achieved_: [0..1] init 0;
  t13_state: [0..1] init 0;
  t13_achieved_: [0..1] init 0;
  t14_state: [0..1] init 0;
  t14_achieved_: [0..1] init 0;
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t6_state: [0..1] init 0;
  t6_achieved_: [0..1] init 0;
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  
  // Task T10: task
  [pursue_T10] t10_state=0 & t10_achieved_=0 -> (t10_state'=1);
  [try_T10] t10_state=1 & t10_achieved_=0 -> T10_achievable: (t10_achieved_'=1) + 1-T10_achievable: (t10_state'=0);
  [achieved_T10] t10_state=1 & t10_achieved_=1 -> (t10_state'=0);
  

  // Task T11: task
  [pursue_T11] t11_state=0 & t11_achieved_=0 -> (t11_state'=1);
  [try_T11] t11_state=1 & t11_achieved_=0 -> T11_achievable: (t11_achieved_'=1) + 1-T11_achievable: (t11_state'=0);
  [achieved_T11] t11_state=1 & t11_achieved_=1 -> (t11_state'=0);
  

  // Task T13: task
  [pursue_T13] t13_state=0 & t13_achieved_=0 -> (t13_state'=1);
  [try_T13] t13_state=1 & t13_achieved_=0 -> T13_achievable: (t13_achieved_'=1) + 1-T13_achievable: (t13_state'=0);
  [achieved_T13] t13_state=1 & t13_achieved_=1 -> (t13_state'=0);
  

  // Task T14: task
  [pursue_T14] t14_state=0 & t14_achieved_=0 -> (t14_state'=1);
  [try_T14] t14_state=1 & t14_achieved_=0 -> T14_achievable: (t14_achieved_'=1) + 1-T14_achievable: (t14_state'=0);
  [achieved_T14] t14_state=1 & t14_achieved_=1 -> (t14_state'=0);
  

  // Task T3: task
  [pursue_T3] t3_state=0 & t3_achieved_=0 -> (t3_state'=1);
  [try_T3] t3_state=1 & t3_achieved_=0 -> T3_achievable: (t3_achieved_'=1) + 1-T3_achievable: (t3_state'=0);
  [achieved_T3] t3_state=1 & t3_achieved_=1 -> (t3_state'=0);
  

  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
  

  // Task T6: task
  [pursue_T6] t6_state=0 & t6_achieved_=0 -> (t6_state'=1);
  [try_T6] t6_state=1 & t6_achieved_=0 -> T6_achievable: (t6_achieved_'=1) + 1-T6_achievable: (t6_state'=0);
  [achieved_T6] t6_state=1 & t6_achieved_=1 -> (t6_state'=0);
  

  // Task T7: task
  [pursue_T7] t7_state=0 & t7_achieved_=0 -> (t7_state'=1);
  [try_T7] t7_state=1 & t7_achieved_=0 -> T7_achievable: (t7_achieved_'=1) + 1-T7_achievable: (t7_state'=0);
  [achieved_T7] t7_state=1 & t7_achieved_=1 -> (t7_state'=0);
  
endmodule

formula t10_achieved = (t10_achieved_=1);
formula t11_achieved = (t11_achieved_=1);
formula t13_achieved = (t13_achieved_=1);
formula t14_achieved = (t14_achieved_=1);
formula t3_achieved = (t3_achieved_=1);
formula t4_achieved = (t4_achieved_=1);
formula t6_achieved = (t6_achieved_=1);
formula t7_achieved = (t7_achieved_=1);

module System
  
endmodule
