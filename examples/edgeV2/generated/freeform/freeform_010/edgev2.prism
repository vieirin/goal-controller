dtmc

const int N = 10;
const int decision_G0;
const int _decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G10;
const int _decision_G10;
const int decision_G11;
const int _decision_G11;
const int decision_G17;
const int _decision_G17;
const int decision_G18;
const int decision_G2;
const int _decision_G2;
const int decision_G5;
const int _decision_G5;
const int decision_T12;
const int decision_T13;
const int decision_T14;
const int decision_T15;
const int decision_T16;
const int decision_T19;
const int decision_T20;
const int decision_T21;
const int decision_T3;
const int decision_T4;
const int decision_T6;
const int decision_T7;
const int decision_T8;
const int decision_T9;


// ID: G0
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G1, G10, G17
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g10_state=0 & g17_state=0 & (G1_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0 -> true;
  [pursue_G10] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g17_state=0 & (G10_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0) -> true;
  [pursue_G17] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g10_state=0 & (G17_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0) & !((G10_achievable/(G1_achievable+G10_achievable+G17_achievable))*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g10_state=0 & g17_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g10_state=0 & g17_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | g10_achieved | g17_achieved);
formula G0_achievable = G1_achievable + G10_achievable + G17_achievable - (G1_achievable * G10_achievable * G17_achievable);

// ID: G1
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G2, G5, T9
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g5_state=0 & t9_state=0 & G2_relative*N > _decision_G1 -> true;
  [pursue_G5] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & t9_state=0 & G5_relative*N > _decision_G1 & !(G2_relative*N > _decision_G1) -> true;
  [pursue_T9] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & g5_state=0 & T9_relative*N > _decision_G1 & !(G2_relative*N > _decision_G1) & !(G5_relative*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g5_state=0 & t9_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g5_state=0 & t9_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved & g5_achieved & t9_achieved);
formula G1_achievable = g1_achieved ? 0 : (!g2_achieved ? G2_achievable : 1) * (!g5_achieved ? G5_achievable : 1) * (!t9_achieved ? T9_achievable : 1);
formula G2_relative = g2_achieved ? 0 : G2_achievable/(G2_achievable + (g5_achieved ? 0 : G5_achievable) + (t9_achieved ? 0 : T9_achievable));
formula G5_relative = g5_achieved ? 0 : G5_achievable/(G5_achievable + (g2_achieved ? 0 : G2_achievable) + (t9_achieved ? 0 : T9_achievable));
formula T9_relative = t9_achieved ? 0 : T9_achievable/(T9_achievable + (g2_achieved ? 0 : G2_achievable) + (g5_achieved ? 0 : G5_achievable));

// ID: G2
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T3, T4
module G2
  g2_state : [0..1] init 0;
  t3_failed : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed<1 & T3_achievable*N > decision_T3 -> (t3_failed'=t3_failed+1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed=1 & G2_achievable*N > decision_G2 & t4_state=0 & (T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & t3_failed=1 & G2_achievable*N > decision_G2 & t3_state=0 & (T4_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 & !((T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t3_failed<1 & T3_achievable*N <= decision_T3 -> (g2_state'=0);
  [skip_G2] t3_failed=1 & !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved | (t3_failed=1 & t4_achieved));
formula G2_achievable = T3_achievable + T4_achievable - (T3_achievable * T4_achievable);

// ID: G5
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T6, T7, T8
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t7_state=0 & t8_state=0 & T6_relative*N > _decision_G5 -> true;
  [pursue_T7] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t6_state=0 & t8_state=0 & T7_relative*N > _decision_G5 & !(T6_relative*N > _decision_G5) -> true;
  [pursue_T8] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t6_state=0 & t7_state=0 & T8_relative*N > _decision_G5 & !(T6_relative*N > _decision_G5) & !(T7_relative*N > _decision_G5) -> true;

  [achieved_G5] g5_state=1 & g5_achieved & t6_state=0 & t7_state=0 & t8_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & t6_state=0 & t7_state=0 & t8_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (t6_achieved & t7_achieved & t8_achieved);
formula G5_achievable = g5_achieved ? 0 : (!t6_achieved ? T6_achievable : 1) * (!t7_achieved ? T7_achievable : 1) * (!t8_achieved ? T8_achievable : 1);
formula T6_relative = t6_achieved ? 0 : T6_achievable/(T6_achievable + (t7_achieved ? 0 : T7_achievable) + (t8_achieved ? 0 : T8_achievable));
formula T7_relative = t7_achieved ? 0 : T7_achievable/(T7_achievable + (t6_achieved ? 0 : T6_achievable) + (t8_achieved ? 0 : T8_achievable));
formula T8_relative = t8_achieved ? 0 : T8_achievable/(T8_achievable + (t6_achieved ? 0 : T6_achievable) + (t7_achieved ? 0 : T7_achievable));

// ID: G10
// Name: goal
// Type: choice
// Relation to children: or
// Children: G11, T15, T16
module G10
  g10_state : [0..1] init 0;
  g10_chosen : [0..3] init 0;

  [pursue_G10] !g10_achieved & g10_state=0 -> (g10_state'=1);
  [pursue_G11] !g10_achieved & g10_state=1 & g10_chosen=0 & G10_achievable*N > decision_G10 & t15_state=0 & t16_state=0 & (G11_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10 -> (g10_chosen'=1);
  [pursue_G11] !g10_achieved & g10_state=1 & g10_chosen=1 & G11_achievable*N > decision_G11 -> true;
  [pursue_T15] !g10_achieved & g10_state=1 & g10_chosen=0 & G10_achievable*N > decision_G10 & g11_state=0 & t16_state=0 & (T15_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10 & !((G11_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10) -> (g10_chosen'=2);
  [pursue_T15] !g10_achieved & g10_state=1 & g10_chosen=2 & T15_achievable*N > decision_T15 -> true;
  [pursue_T16] !g10_achieved & g10_state=1 & g10_chosen=0 & G10_achievable*N > decision_G10 & g11_state=0 & t15_state=0 & (T16_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10 & !((G11_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10) & !((T15_achievable/(G11_achievable+T15_achievable+T16_achievable))*N > _decision_G10) -> (g10_chosen'=3);
  [pursue_T16] !g10_achieved & g10_state=1 & g10_chosen=3 & T16_achievable*N > decision_T16 -> true;

  [achieved_G10] g10_state=1 & g10_achieved & g11_state=0 & t15_state=0 & t16_state=0 -> (g10_state'=0);
  
  [skip_G10] g10_chosen=0 & !g10_achieved & g10_state=1 & g11_state=0 & t15_state=0 & t16_state=0 & G10_achievable*N <= decision_G10 -> (g10_state'=0);
  [skip_G10] !g10_achieved & g10_state=1 & g11_state=0 & g10_chosen=1 & G11_achievable*N <= decision_G11 -> (g10_state'=0);
  [skip_G10] !g10_achieved & g10_state=1 & t15_state=0 & g10_chosen=2 & T15_achievable*N <= decision_T15 -> (g10_state'=0);
  [skip_G10] !g10_achieved & g10_state=1 & t16_state=0 & g10_chosen=3 & T16_achievable*N <= decision_T16 -> (g10_state'=0);
endmodule

formula g10_achieved = (g11_achieved | t15_achieved | t16_achieved);
formula G10_achievable = g10_chosen=1 ? G11_achievable : g10_chosen=2 ? T15_achievable : g10_chosen=3 ? T16_achievable : (G11_achievable + T15_achievable + T16_achievable - (G11_achievable * T15_achievable * T16_achievable));

// ID: G11
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T12, T13, T14
module G11
  g11_state : [0..1] init 0;
  t12_failed : [0..3] init 0;

  [pursue_G11] !g11_achieved & g11_state=0 -> (g11_state'=1);
  [pursue_T12] !g11_achieved & g11_state=1 & t12_failed<3 & T12_achievable*N > decision_T12 -> (t12_failed'=t12_failed+1);
  [pursue_T12] !g11_achieved & g11_state=1 & t12_failed=3 & G11_achievable*N > decision_G11 & t13_state=0 & t14_state=0 & (T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 -> true;
  [pursue_T13] !g11_achieved & g11_state=1 & t12_failed=3 & G11_achievable*N > decision_G11 & t12_state=0 & t14_state=0 & (T13_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 & !((T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) -> true;
  [pursue_T14] !g11_achieved & g11_state=1 & t12_failed=3 & G11_achievable*N > decision_G11 & t12_state=0 & t13_state=0 & (T14_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 & !((T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) & !((T13_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) -> true;

  [achieved_G11] g11_state=1 & g11_achieved & t12_state=0 & t13_state=0 & t14_state=0 -> (g11_state'=0);
  
  [skip_G11] !g11_achieved & g11_state=1 & t12_state=0 & t12_failed<3 & T12_achievable*N <= decision_T12 -> (g11_state'=0);
  [skip_G11] t12_failed=3 & !g11_achieved & g11_state=1 & t12_state=0 & t13_state=0 & t14_state=0 & G11_achievable*N <= decision_G11 -> (g11_state'=0);
endmodule

formula g11_achieved = (t12_achieved | (t12_failed=3 & t13_achieved) | (t12_failed=3 & t14_achieved));
formula G11_achievable = T12_achievable + T13_achievable + T14_achievable - (T12_achievable * T13_achievable * T14_achievable);

// ID: G17
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G18, T21
module G17
  g17_state : [0..1] init 0;

  [pursue_G17] !g17_achieved & g17_state=0 -> (g17_state'=1);
  [pursue_G18] !g17_achieved & g17_state=1 & G17_achievable*N > decision_G17 & t21_state=0 & (G18_achievable/(G18_achievable+T21_achievable))*N > _decision_G17 -> true;
  [pursue_T21] !g17_achieved & g17_state=1 & G17_achievable*N > decision_G17 & g18_state=0 & (T21_achievable/(G18_achievable+T21_achievable))*N > _decision_G17 & !((G18_achievable/(G18_achievable+T21_achievable))*N > _decision_G17) -> true;

  [achieved_G17] g17_state=1 & g17_achieved & g18_state=0 & t21_state=0 -> (g17_state'=0);
  
  [skip_G17] !g17_achieved & g17_state=1 & g18_state=0 & t21_state=0 & G17_achievable*N <= decision_G17 -> (g17_state'=0);
endmodule

formula g17_achieved = (g18_achieved | t21_achieved);
formula G17_achievable = G18_achievable + T21_achievable - (G18_achievable * T21_achievable);

// ID: G18
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T19, T20
module G18
  g18_state : [0..1] init 0;

  [pursue_G18] !g18_achieved & g18_state=0 -> (g18_state'=1);
  [pursue_T19] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & t20_state=0 -> true;
  [pursue_T20] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & t19_achieved & t19_state=0 -> true;

  [achieved_G18] g18_state=1 & g18_achieved & t19_state=0 & t20_state=0 -> (g18_state'=0);
  
  [skip_G18] !g18_achieved & g18_state=1 & t19_state=0 & t20_state=0 & G18_achievable*N <= decision_G18 -> (g18_state'=0);
endmodule

formula g18_achieved = (t19_achieved & t20_achieved);
formula G18_achievable = g18_achieved ? 0 : (!t19_achieved ? T19_achievable : 1) * (!t20_achieved ? T20_achievable : 1);


const double T12_achievable = 0.8;
const double T13_achievable = 0.8;
const double T14_achievable = 0.8;
const double T15_achievable = 0.8;
const double T16_achievable = 0.8;
const double T19_achievable = 0.8;
const double T20_achievable = 0.8;
const double T21_achievable = 0.8;
const double T3_achievable = 0.8;
const double T4_achievable = 0.8;
const double T6_achievable = 0.8;
const double T7_achievable = 0.8;
const double T8_achievable = 0.8;
const double T9_achievable = 0.8;

module ChangeManager
  t12_state: [0..1] init 0;
  t12_achieved_: [0..1] init 0;
  t13_state: [0..1] init 0;
  t13_achieved_: [0..1] init 0;
  t14_state: [0..1] init 0;
  t14_achieved_: [0..1] init 0;
  t15_state: [0..1] init 0;
  t15_achieved_: [0..1] init 0;
  t16_state: [0..1] init 0;
  t16_achieved_: [0..1] init 0;
  t19_state: [0..1] init 0;
  t19_achieved_: [0..1] init 0;
  t20_state: [0..1] init 0;
  t20_achieved_: [0..1] init 0;
  t21_state: [0..1] init 0;
  t21_achieved_: [0..1] init 0;
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t6_state: [0..1] init 0;
  t6_achieved_: [0..1] init 0;
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  t8_state: [0..1] init 0;
  t8_achieved_: [0..1] init 0;
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  
  // Task T12: task
  [pursue_T12] t12_state=0 & t12_achieved_=0 -> (t12_state'=1);
  [try_T12] t12_state=1 & t12_achieved_=0 -> T12_achievable: (t12_achieved_'=1) + 1-T12_achievable: (t12_state'=0);
  [achieved_T12] t12_state=1 & t12_achieved_=1 -> (t12_state'=0);
  

  // Task T13: task
  [pursue_T13] t13_state=0 & t13_achieved_=0 -> (t13_state'=1);
  [try_T13] t13_state=1 & t13_achieved_=0 -> T13_achievable: (t13_achieved_'=1) + 1-T13_achievable: (t13_state'=0);
  [achieved_T13] t13_state=1 & t13_achieved_=1 -> (t13_state'=0);
  

  // Task T14: task
  [pursue_T14] t14_state=0 & t14_achieved_=0 -> (t14_state'=1);
  [try_T14] t14_state=1 & t14_achieved_=0 -> T14_achievable: (t14_achieved_'=1) + 1-T14_achievable: (t14_state'=0);
  [achieved_T14] t14_state=1 & t14_achieved_=1 -> (t14_state'=0);
  

  // Task T15: task
  [pursue_T15] t15_state=0 & t15_achieved_=0 -> (t15_state'=1);
  [try_T15] t15_state=1 & t15_achieved_=0 -> T15_achievable: (t15_achieved_'=1) + 1-T15_achievable: (t15_state'=0);
  [achieved_T15] t15_state=1 & t15_achieved_=1 -> (t15_state'=0);
  

  // Task T16: task
  [pursue_T16] t16_state=0 & t16_achieved_=0 -> (t16_state'=1);
  [try_T16] t16_state=1 & t16_achieved_=0 -> T16_achievable: (t16_achieved_'=1) + 1-T16_achievable: (t16_state'=0);
  [achieved_T16] t16_state=1 & t16_achieved_=1 -> (t16_state'=0);
  

  // Task T19: task
  [pursue_T19] t19_state=0 & t19_achieved_=0 -> (t19_state'=1);
  [try_T19] t19_state=1 & t19_achieved_=0 -> T19_achievable: (t19_achieved_'=1) + 1-T19_achievable: (t19_state'=0);
  [achieved_T19] t19_state=1 & t19_achieved_=1 -> (t19_state'=0);
  

  // Task T20: task
  [pursue_T20] t20_state=0 & t20_achieved_=0 -> (t20_state'=1);
  [try_T20] t20_state=1 & t20_achieved_=0 -> T20_achievable: (t20_achieved_'=1) + 1-T20_achievable: (t20_state'=0);
  [achieved_T20] t20_state=1 & t20_achieved_=1 -> (t20_state'=0);
  

  // Task T21: task
  [pursue_T21] t21_state=0 & t21_achieved_=0 -> (t21_state'=1);
  [try_T21] t21_state=1 & t21_achieved_=0 -> T21_achievable: (t21_achieved_'=1) + 1-T21_achievable: (t21_state'=0);
  [achieved_T21] t21_state=1 & t21_achieved_=1 -> (t21_state'=0);
  

  // Task T3: task
  [pursue_T3] t3_state=0 & t3_achieved_=0 -> (t3_state'=1);
  [try_T3] t3_state=1 & t3_achieved_=0 -> T3_achievable: (t3_achieved_'=1) + 1-T3_achievable: (t3_state'=0);
  [achieved_T3] t3_state=1 & t3_achieved_=1 -> (t3_state'=0);
  

  // Task T4: task
