dtmc

const int N = 10;
const int decision_G0;
const int _decision_G0;
const int decision_G1;
const int decision_G12;
const int decision_G13;
const int _decision_G13;
const int decision_G2;
const int decision_G5;
const int _decision_G5;
const int decision_G6;
const int decision_G8;
const int decision_T10;
const int decision_T11;
const int decision_T14;
const int decision_T3;
const int decision_T4;
const int decision_T7;
const int decision_T9;


// ID: G0
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G1, G5, G12
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g5_state=0 & g12_state=0 & G1_relative*N > _decision_G0 -> true;
  [pursue_G5] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g12_state=0 & G5_relative*N > _decision_G0 & !(G1_relative*N > _decision_G0) -> true;
  [pursue_G12] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g5_state=0 & G12_relative*N > _decision_G0 & !(G1_relative*N > _decision_G0) & !(G5_relative*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g5_state=0 & g12_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g5_state=0 & g12_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g5_achieved & g12_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g5_achieved ? G5_achievable : 1) * (!g12_achieved ? G12_achievable : 1);
formula G1_relative = g1_achieved ? 0 : G1_achievable/(G1_achievable + (g5_achieved ? 0 : G5_achievable) + (g12_achieved ? 0 : G12_achievable));
formula G5_relative = g5_achieved ? 0 : G5_achievable/(G5_achievable + (g1_achieved ? 0 : G1_achievable) + (g12_achieved ? 0 : G12_achievable));
formula G12_relative = g12_achieved ? 0 : G12_achievable/(G12_achievable + (g1_achieved ? 0 : G1_achievable) + (g5_achieved ? 0 : G5_achievable));

// ID: G1
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G2, T4
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & t4_state=0 -> true;
  [pursue_T4] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_achieved & g2_state=0 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & t4_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & t4_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved & t4_achieved);
formula G1_achievable = g1_achieved ? 0 : (!g2_achieved ? G2_achievable : 1) * (!t4_achieved ? T4_achievable : 1);

// ID: G2
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T3
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & T3_achievable*N > decision_T3 -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & !(T3_achievable*N > decision_T3) -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1);

// ID: G5
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G6, G8
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_G6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & g8_state=0 & G6_relative*N > _decision_G5 -> true;
  [pursue_G8] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & g6_state=0 & G8_relative*N > _decision_G5 & !(G6_relative*N > _decision_G5) -> true;

  [achieved_G5] g5_state=1 & g5_achieved & g6_state=0 & g8_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & g6_state=0 & g8_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (g6_achieved & g8_achieved);
formula G5_achievable = g5_achieved ? 0 : (!g6_achieved ? G6_achievable : 1) * (!g8_achieved ? G8_achievable : 1);
formula G6_relative = g6_achieved ? 0 : G6_achievable/(G6_achievable + (g8_achieved ? 0 : G8_achievable));
formula G8_relative = g8_achieved ? 0 : G8_achievable/(G8_achievable + (g6_achieved ? 0 : G6_achievable));

// ID: G6
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T7
module G6
  g6_state : [0..1] init 0;

  [pursue_G6] !g6_achieved & g6_state=0 -> (g6_state'=1);
  [pursue_T7] !g6_achieved & g6_state=1 & T7_achievable*N > decision_T7 -> true;

  [achieved_G6] g6_state=1 & g6_achieved & t7_state=0 -> (g6_state'=0);
  
  [skip_G6] !g6_achieved & g6_state=1 & t7_state=0 & !(T7_achievable*N > decision_T7) -> (g6_state'=0);
endmodule

formula g6_achieved = (t7_achieved);
formula G6_achievable = g6_achieved ? 0 : (!t7_achieved ? T7_achievable : 1);

// ID: G8
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T9, T10, T11
module G8
  g8_state : [0..1] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t10_state=0 & t11_state=0 -> true;
  [pursue_T10] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_achieved & t9_state=0 & t11_state=0 -> true;
  [pursue_T11] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_achieved & t10_achieved & t9_state=0 & t10_state=0 -> true;

  [achieved_G8] g8_state=1 & g8_achieved & t9_state=0 & t10_state=0 & t11_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & t9_state=0 & t10_state=0 & t11_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (t9_achieved & t10_achieved & t11_achieved);
formula G8_achievable = g8_achieved ? 0 : (!t9_achieved ? T9_achievable : 1) * (!t10_achieved ? T10_achievable : 1) * (!t11_achieved ? T11_achievable : 1);

// ID: G12
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: G13
module G12
  g12_state : [0..1] init 0;

  [pursue_G12] !g12_achieved & g12_state=0 -> (g12_state'=1);
  [pursue_G13] !g12_achieved & g12_state=1 & G13_achievable*N > decision_G13 -> true;

  [achieved_G12] g12_state=1 & g12_achieved & g13_state=0 -> (g12_state'=0);
  
  [skip_G12] !g12_achieved & g12_state=1 & g13_state=0 & !(G13_achievable*N > decision_G13) -> (g12_state'=0);
endmodule

formula g12_achieved = (g13_achieved);
formula G12_achievable = g12_achieved ? 0 : (!g13_achieved ? G13_achievable : 1);

// ID: G13
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T14
module G13
  g13_state : [0..1] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & (T14_achievable/(T14_achievable))*N > _decision_G13 -> true;

  [achieved_G13] g13_state=1 & g13_achieved & t14_state=0 -> (g13_state'=0);
  
  [skip_G13] !g13_achieved & g13_state=1 & t14_state=0 & G13_achievable*N <= decision_G13 -> (g13_state'=0);
endmodule

formula g13_achieved = (t14_achieved);
formula G13_achievable = T14_achievable;


const double T10_achievable = 0.8;
const double T11_achievable = 0.8;
const double T14_achievable = 0.8;
const double T3_achievable = 0.8;
const double T4_achievable = 0.8;
const double T7_achievable = 0.8;
const double T9_achievable = 0.8;

module ChangeManager
  t10_state: [0..1] init 0;
  t10_achieved_: [0..1] init 0;
  t11_state: [0..1] init 0;
  t11_achieved_: [0..1] init 0;
  t14_state: [0..1] init 0;
  t14_achieved_: [0..1] init 0;
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  
  // Task T10: task
  [pursue_T10] t10_state=0 & t10_achieved_=0 -> (t10_state'=1);
  [try_T10] t10_state=1 & t10_achieved_=0 -> T10_achievable: (t10_achieved_'=1) + 1-T10_achievable: (t10_state'=0);
  [achieved_T10] t10_state=1 & t10_achieved_=1 -> (t10_state'=0);
  

  // Task T11: task
  [pursue_T11] t11_state=0 & t11_achieved_=0 -> (t11_state'=1);
  [try_T11] t11_state=1 & t11_achieved_=0 -> T11_achievable: (t11_achieved_'=1) + 1-T11_achievable: (t11_state'=0);
  [achieved_T11] t11_state=1 & t11_achieved_=1 -> (t11_state'=0);
  

  // Task T14: task
  [pursue_T14] t14_state=0 & t14_achieved_=0 -> (t14_state'=1);
  [try_T14] t14_state=1 & t14_achieved_=0 -> T14_achievable: (t14_achieved_'=1) + 1-T14_achievable: (t14_state'=0);
  [achieved_T14] t14_state=1 & t14_achieved_=1 -> (t14_state'=0);
  

  // Task T3: task
  [pursue_T3] t3_state=0 & t3_achieved_=0 -> (t3_state'=1);
  [try_T3] t3_state=1 & t3_achieved_=0 -> T3_achievable: (t3_achieved_'=1) + 1-T3_achievable: (t3_state'=0);
  [achieved_T3] t3_state=1 & t3_achieved_=1 -> (t3_state'=0);
  

  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
  

  // Task T7: task
  [pursue_T7] t7_state=0 & t7_achieved_=0 -> (t7_state'=1);
  [try_T7] t7_state=1 & t7_achieved_=0 -> T7_achievable: (t7_achieved_'=1) + 1-T7_achievable: (t7_state'=0);
  [achieved_T7] t7_state=1 & t7_achieved_=1 -> (t7_state'=0);
  

  // Task T9: task
  [pursue_T9] t9_state=0 & t9_achieved_=0 -> (t9_state'=1);
  [try_T9] t9_state=1 & t9_achieved_=0 -> T9_achievable: (t9_achieved_'=1) + 1-T9_achievable: (t9_state'=0);
  [achieved_T9] t9_state=1 & t9_achieved_=1 -> (t9_state'=0);
  
endmodule

formula t10_achieved = (t10_achieved_=1);
formula t11_achieved = (t11_achieved_=1);
formula t14_achieved = (t14_achieved_=1);
formula t3_achieved = (t3_achieved_=1);
formula t4_achieved = (t4_achieved_=1);
formula t7_achieved = (t7_achieved_=1);
formula t9_achieved = (t9_achieved_=1);

module System
  
