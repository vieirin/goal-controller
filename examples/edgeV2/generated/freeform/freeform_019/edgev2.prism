// ID: G7
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T8, T9, T10
module G7
  g7_state : [0..1] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_T8] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t9_state=0 & t10_state=0 -> true;
  [pursue_T9] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_achieved & t8_state=0 & t10_state=0 -> true;
  [pursue_T10] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_achieved & t9_achieved & t8_state=0 & t9_state=0 -> true;

  [achieved_G7] g7_state=1 & g7_achieved & t8_state=0 & t9_state=0 & t10_state=0 -> (g7_state'=0);
  
  [skip_G7] !g7_achieved & g7_state=1 & t8_state=0 & t9_state=0 & t10_state=0 & G7_achievable*N <= decision_G7 -> (g7_state'=0);
endmodule

formula g7_achieved = (t8_achieved & t9_achieved & t10_achieved);
formula G7_achievable = g7_achieved ? 0 : (!t8_achieved ? T8_achievable : 1) * (!t9_achieved ? T9_achievable : 1) * (!t10_achieved ? T10_achievable : 1);

// ID: G1
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G2, T6, G7
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & t6_state=0 & g7_state=0 & (G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 -> true;
  [pursue_T6] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & g7_state=0 & (T6_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) -> true;
  [pursue_G7] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & t6_state=0 & (G7_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) & !((T6_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & t6_state=0 & g7_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & t6_state=0 & g7_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | t6_achieved | g7_achieved);
formula G1_achievable = G2_achievable + T6_achievable + G7_achievable - (G2_achievable * T6_achievable * G7_achievable);

