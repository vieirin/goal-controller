// ID: G2
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T3, T4, T5
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t4_state=0 & t5_state=0 & T3_relative*N > _decision_G2 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_state=0 & t5_state=0 & T4_relative*N > _decision_G2 & !(T3_relative*N > _decision_G2) -> true;
  [pursue_T5] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_state=0 & t4_state=0 & T5_relative*N > _decision_G2 & !(T3_relative*N > _decision_G2) & !(T4_relative*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 & t5_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & t5_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved & t4_achieved & t5_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1) * (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1);
formula T3_relative = t3_achieved ? 0 : T3_achievable/(T3_achievable + (t4_achieved ? 0 : T4_achievable) + (t5_achieved ? 0 : T5_achievable));
formula T4_relative = t4_achieved ? 0 : T4_achievable/(T4_achievable + (t3_achieved ? 0 : T3_achievable) + (t5_achieved ? 0 : T5_achievable));
formula T5_relative = t5_achieved ? 0 : T5_achievable/(T5_achievable + (t3_achieved ? 0 : T3_achievable) + (t4_achieved ? 0 : T4_achievable));

