// ID: G16
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T17, T18, T19
module G16
  g16_state : [0..1] init 0;

  [pursue_G16] !g16_achieved & g16_state=0 -> (g16_state'=1);
  [pursue_T17] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & t18_state=0 & t19_state=0 -> true;
  [pursue_T18] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & t17_achieved & t17_state=0 & t19_state=0 -> true;
  [pursue_T19] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & t17_achieved & t18_achieved & t17_state=0 & t18_state=0 -> true;

  [achieved_G16] g16_state=1 & g16_achieved & t17_state=0 & t18_state=0 & t19_state=0 -> (g16_state'=0);
  
  [skip_G16] !g16_achieved & g16_state=1 & t17_state=0 & t18_state=0 & t19_state=0 & G16_achievable*N <= decision_G16 -> (g16_state'=0);
endmodule

formula g16_achieved = (t17_achieved & t18_achieved & t19_achieved);
formula G16_achievable = g16_achieved ? 0 : (!t17_achieved ? T17_achievable : 1) * (!t18_achieved ? T18_achievable : 1) * (!t19_achieved ? T19_achievable : 1);

// ID: G11
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G12, G16
module G11
  g11_state : [0..1] init 0;

  [pursue_G11] !g11_achieved & g11_state=0 -> (g11_state'=1);
  [pursue_G12] !g11_achieved & g11_state=1 & G11_achievable*N > decision_G11 & g16_state=0 -> true;
  [pursue_G16] !g11_achieved & g11_state=1 & G11_achievable*N > decision_G11 & g12_achieved & g12_state=0 -> true;

  [achieved_G11] g11_state=1 & g11_achieved & g12_state=0 & g16_state=0 -> (g11_state'=0);
  
  [skip_G11] !g11_achieved & g11_state=1 & g12_state=0 & g16_state=0 & G11_achievable*N <= decision_G11 -> (g11_state'=0);
endmodule

formula g11_achieved = (g12_achieved & g16_achieved);
formula G11_achievable = g11_achieved ? 0 : (!g12_achieved ? G12_achievable : 1) * (!g16_achieved ? G16_achievable : 1);

// ID: G0
// Name: goal
// Type: choice
// Relation to children: or
// Children: G1, G11
module G0
  g0_state : [0..1] init 0;
  g0_chosen : [0..2] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g0_chosen=0 & G0_achievable*N > decision_G0 & g11_state=0 & (G1_achievable/(G1_achievable+G11_achievable))*N > _decision_G0 -> (g0_chosen'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g0_chosen=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G11] !g0_achieved & g0_state=1 & g0_chosen=0 & G0_achievable*N > decision_G0 & g1_state=0 & (G11_achievable/(G1_achievable+G11_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G11_achievable))*N > _decision_G0) -> (g0_chosen'=2);
  [pursue_G11] !g0_achieved & g0_state=1 & g0_chosen=2 & G11_achievable*N > decision_G11 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g11_state=0 -> (g0_state'=0);
  
  [skip_G0] g0_chosen=0 & !g0_achieved & g0_state=1 & g1_state=0 & g11_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g0_chosen=1 & G1_achievable*N <= decision_G1 -> (g0_state'=0);
  [skip_G0] !g0_achieved & g0_state=1 & g11_state=0 & g0_chosen=2 & G11_achievable*N <= decision_G11 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | g11_achieved);
formula G0_achievable = g0_chosen=1 ? G1_achievable : g0_chosen=2 ? G11_achievable : (G1_achievable + G11_achievable - (G1_achievable * G11_achievable));

module System
  
endmodule
