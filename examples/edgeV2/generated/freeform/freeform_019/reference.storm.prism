[pursue_GG1] !gG0_achieved & gG0=1 & gG0_chosen=0 & GG0_achievable*N>decision_GG0 & gG11=0  & (GG1_achievable/(GG1_achievable+GG11_achievable+0))*N > decision_GG0_ -> (gG0_chosen'=1); 
