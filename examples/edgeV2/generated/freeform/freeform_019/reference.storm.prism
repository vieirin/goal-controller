 endmodule
formula gG0_achieved = (false | gG1_achieved | gG11_achieved);
formula GG0_achievable = gG0_chosen=1 ? GG1_achievable:gG0_chosen=2 ? GG11_achievable:(0 + GG1_achievable + GG11_achievable - 1 * GG1_achievable * GG11_achievable );


