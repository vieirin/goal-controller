[pursue_GG11] !gG0_achieved & gG0=1 & gG0_chosen=0 & GG0_achievable*N>decision_GG0 & gG1=0  & (GG11_achievable/(GG1_achievable+GG11_achievable+0))*N > decision_GG0_ & !((GG1_achievable/(GG1_achievable+GG11_achievable+0))*N > decision_GG0_) -> (gG0_chosen'=2); 
