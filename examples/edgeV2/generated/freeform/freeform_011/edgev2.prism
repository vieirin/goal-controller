// ID: G0
// Name: goal
// Type: choice
// Relation to children: or
// Children: G1, G13, G34
module G0
  g0_state : [0..1] init 0;
  g0_chosen : [0..3] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g0_chosen=0 & G0_achievable*N > decision_G0 & g13_state=0 & g34_state=0 & (G1_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0 -> (g0_chosen'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g0_chosen=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G13] !g0_achieved & g0_state=1 & g0_chosen=0 & G0_achievable*N > decision_G0 & g1_state=0 & g34_state=0 & (G13_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0) -> (g0_chosen'=2);
  [pursue_G13] !g0_achieved & g0_state=1 & g0_chosen=2 & G13_achievable*N > decision_G13 -> true;
  [pursue_G34] !g0_achieved & g0_state=1 & g0_chosen=0 & G0_achievable*N > decision_G0 & g1_state=0 & g13_state=0 & (G34_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0) & !((G13_achievable/(G1_achievable+G13_achievable+G34_achievable))*N > _decision_G0) -> (g0_chosen'=3);
  [pursue_G34] !g0_achieved & g0_state=1 & g0_chosen=3 & G34_achievable*N > decision_G34 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g13_state=0 & g34_state=0 -> (g0_state'=0);
  
  [skip_G0] g0_chosen=0 & !g0_achieved & g0_state=1 & g1_state=0 & g13_state=0 & g34_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g0_chosen=1 & G1_achievable*N <= decision_G1 -> (g0_state'=0);
  [skip_G0] !g0_achieved & g0_state=1 & g13_state=0 & g0_chosen=2 & G13_achievable*N <= decision_G13 -> (g0_state'=0);
  [skip_G0] !g0_achieved & g0_state=1 & g34_state=0 & g0_chosen=3 & G34_achievable*N <= decision_G34 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | g13_achieved | g34_achieved);
formula G0_achievable = g0_chosen=1 ? G1_achievable : g0_chosen=2 ? G13_achievable : g0_chosen=3 ? G34_achievable : (G1_achievable + G13_achievable + G34_achievable - (G1_achievable * G13_achievable * G34_achievable));

// ID: G1
// Name: goal
// Type: choice
// Relation to children: or
// Children: T2, G3
module G1
  g1_state : [0..1] init 0;
  g1_chosen : [0..2] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_T2] !g1_achieved & g1_state=1 & g1_chosen=0 & G1_achievable*N > decision_G1 & g3_state=0 & (T2_achievable/(T2_achievable+G3_achievable))*N > _decision_G1 -> (g1_chosen'=1);
  [pursue_T2] !g1_achieved & g1_state=1 & g1_chosen=1 & T2_achievable*N > decision_T2 -> true;
  [pursue_G3] !g1_achieved & g1_state=1 & g1_chosen=0 & G1_achievable*N > decision_G1 & t2_state=0 & (G3_achievable/(T2_achievable+G3_achievable))*N > _decision_G1 & !((T2_achievable/(T2_achievable+G3_achievable))*N > _decision_G1) -> (g1_chosen'=2);
  [pursue_G3] !g1_achieved & g1_state=1 & g1_chosen=2 & G3_achievable*N > decision_G3 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & t2_state=0 & g3_state=0 -> (g1_state'=0);
  
  [skip_G1] g1_chosen=0 & !g1_achieved & g1_state=1 & t2_state=0 & g3_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
  [skip_G1] !g1_achieved & g1_state=1 & t2_state=0 & g1_chosen=1 & T2_achievable*N <= decision_T2 -> (g1_state'=0);
  [skip_G1] !g1_achieved & g1_state=1 & g3_state=0 & g1_chosen=2 & G3_achievable*N <= decision_G3 -> (g1_state'=0);
endmodule

formula g1_achieved = (t2_achieved | g3_achieved);
formula G1_achievable = g1_chosen=1 ? T2_achievable : g1_chosen=2 ? G3_achievable : (T2_achievable + G3_achievable - (T2_achievable * G3_achievable));

// ID: G3
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G4, G8
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_G4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g8_state=0 & G4_relative*N > _decision_G3 -> true;
  [pursue_G8] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g4_state=0 & G8_relative*N > _decision_G3 & !(G4_relative*N > _decision_G3) -> true;

  [achieved_G3] g3_state=1 & g3_achieved & g4_state=0 & g8_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & g4_state=0 & g8_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

formula g3_achieved = (g4_achieved & g8_achieved);
formula G3_achievable = g3_achieved ? 0 : (!g4_achieved ? G4_achievable : 1) * (!g8_achieved ? G8_achievable : 1);
formula G4_relative = g4_achieved ? 0 : G4_achievable/(G4_achievable + (g8_achieved ? 0 : G8_achievable));
formula G8_relative = g8_achieved ? 0 : G8_achievable/(G8_achievable + (g4_achieved ? 0 : G4_achievable));

// ID: G4
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T5, T6, T7
module G4
  g4_state : [0..1] init 0;

  [pursue_G4] !g4_achieved & g4_state=0 -> (g4_state'=1);
  [pursue_T5] !g4_achieved & g4_state=1 & T5_achievable*N > decision_T5 -> true;
  [pursue_T6] !g4_achieved & g4_state=1 & T6_achievable*N > decision_T6 -> true;
  [pursue_T7] !g4_achieved & g4_state=1 & T7_achievable*N > decision_T7 -> true;

  [achieved_G4] g4_state=1 & g4_achieved & t5_state=0 & t6_state=0 & t7_state=0 -> (g4_state'=0);
  
  [skip_G4] !g4_achieved & g4_state=1 & t5_state=0 & t6_state=0 & t7_state=0 & !(T5_achievable*N > decision_T5 | T6_achievable*N > decision_T6 | T7_achievable*N > decision_T7) -> (g4_state'=0);
endmodule

formula g4_achieved = (t5_achieved & t6_achieved & t7_achieved);
formula G4_achievable = g4_achieved ? 0 : (!t5_achieved ? T5_achievable : 1) * (!t6_achieved ? T6_achievable : 1) * (!t7_achieved ? T7_achievable : 1);

// ID: G8
// Name: goal
// Type: choice
// Relation to children: or
// Children: T9, T10, T11, T12
module G8
  g8_state : [0..1] init 0;
  g8_chosen : [0..4] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & t10_state=0 & t11_state=0 & t12_state=0 & (T9_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8 -> (g8_chosen'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & g8_chosen=1 & T9_achievable*N > decision_T9 -> true;
  [pursue_T10] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & t9_state=0 & t11_state=0 & t12_state=0 & (T10_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) -> (g8_chosen'=2);
  [pursue_T10] !g8_achieved & g8_state=1 & g8_chosen=2 & T10_achievable*N > decision_T10 -> true;
  [pursue_T11] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & t9_state=0 & t10_state=0 & t12_state=0 & (T11_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) & !((T10_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) -> (g8_chosen'=3);
  [pursue_T11] !g8_achieved & g8_state=1 & g8_chosen=3 & T11_achievable*N > decision_T11 -> true;
  [pursue_T12] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & t9_state=0 & t10_state=0 & t11_state=0 & (T12_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) & !((T10_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) & !((T11_achievable/(T9_achievable+T10_achievable+T11_achievable+T12_achievable))*N > _decision_G8) -> (g8_chosen'=4);
  [pursue_T12] !g8_achieved & g8_state=1 & g8_chosen=4 & T12_achievable*N > decision_T12 -> true;

  [achieved_G8] g8_state=1 & g8_achieved & t9_state=0 & t10_state=0 & t11_state=0 & t12_state=0 -> (g8_state'=0);
  
  [skip_G8] g8_chosen=0 & !g8_achieved & g8_state=1 & t9_state=0 & t10_state=0 & t11_state=0 & t12_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & t9_state=0 & g8_chosen=1 & T9_achievable*N <= decision_T9 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & t10_state=0 & g8_chosen=2 & T10_achievable*N <= decision_T10 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & t11_state=0 & g8_chosen=3 & T11_achievable*N <= decision_T11 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & t12_state=0 & g8_chosen=4 & T12_achievable*N <= decision_T12 -> (g8_state'=0);
endmodule

formula g8_achieved = (t9_achieved | t10_achieved | t11_achieved | t12_achieved);
formula G8_achievable = g8_chosen=1 ? T9_achievable : g8_chosen=2 ? T10_achievable : g8_chosen=3 ? T11_achievable : g8_chosen=4 ? T12_achievable : (T9_achievable + T10_achievable + T11_achievable + T12_achievable - (T9_achievable * T10_achievable * T11_achievable * T12_achievable));

// ID: G13
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T14, T15, G16, G26
module G13
  g13_state : [0..1] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t15_state=0 & g16_state=0 & g26_state=0 -> true;
  [pursue_T15] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_achieved & t14_state=0 & g16_state=0 & g26_state=0 -> true;
  [pursue_G16] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_achieved & t15_achieved & t14_state=0 & t15_state=0 & g26_state=0 -> true;
  [pursue_G26] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_achieved & t15_achieved & g16_achieved & t14_state=0 & t15_state=0 & g16_state=0 -> true;

  [achieved_G13] g13_state=1 & g13_achieved & t14_state=0 & t15_state=0 & g16_state=0 & g26_state=0 -> (g13_state'=0);
  
  [skip_G13] !g13_achieved & g13_state=1 & t14_state=0 & t15_state=0 & g16_state=0 & g26_state=0 & G13_achievable*N <= decision_G13 -> (g13_state'=0);
endmodule

formula g13_achieved = (t14_achieved & t15_achieved & g16_achieved & g26_achieved);
formula G13_achievable = g13_achieved ? 0 : (!t14_achieved ? T14_achievable : 1) * (!t15_achieved ? T15_achievable : 1) * (!g16_achieved ? G16_achievable : 1) * (!g26_achieved ? G26_achievable : 1);

// ID: G16
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G17, G20, G23
module G16
  g16_state : [0..1] init 0;

  [pursue_G16] !g16_achieved & g16_state=0 -> (g16_state'=1);
  [pursue_G17] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & g20_state=0 & g23_state=0 & (G17_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16 -> true;
  [pursue_G20] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & g17_state=0 & g23_state=0 & (G20_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16 & !((G17_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16) -> true;
  [pursue_G23] !g16_achieved & g16_state=1 & G16_achievable*N > decision_G16 & g17_state=0 & g20_state=0 & (G23_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16 & !((G17_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16) & !((G20_achievable/(G17_achievable+G20_achievable+G23_achievable))*N > _decision_G16) -> true;

  [achieved_G16] g16_state=1 & g16_achieved & g17_state=0 & g20_state=0 & g23_state=0 -> (g16_state'=0);
  
  [skip_G16] !g16_achieved & g16_state=1 & g17_state=0 & g20_state=0 & g23_state=0 & G16_achievable*N <= decision_G16 -> (g16_state'=0);
endmodule

formula g16_achieved = (g17_achieved | g20_achieved | g23_achieved);
formula G16_achievable = G17_achievable + G20_achievable + G23_achievable - (G17_achievable * G20_achievable * G23_achievable);

// ID: G17
// Name: goal
// Type: choice
// Relation to children: or
// Children: T18, T19
module G17
  g17_state : [0..1] init 0;
  g17_chosen : [0..2] init 0;

  [pursue_G17] !g17_achieved & g17_state=0 -> (g17_state'=1);
  [pursue_T18] !g17_achieved & g17_state=1 & g17_chosen=0 & G17_achievable*N > decision_G17 & t19_state=0 & (T18_achievable/(T18_achievable+T19_achievable))*N > _decision_G17 -> (g17_chosen'=1);
  [pursue_T18] !g17_achieved & g17_state=1 & g17_chosen=1 & T18_achievable*N > decision_T18 -> true;
  [pursue_T19] !g17_achieved & g17_state=1 & g17_chosen=0 & G17_achievable*N > decision_G17 & t18_state=0 & (T19_achievable/(T18_achievable+T19_achievable))*N > _decision_G17 & !((T18_achievable/(T18_achievable+T19_achievable))*N > _decision_G17) -> (g17_chosen'=2);
  [pursue_T19] !g17_achieved & g17_state=1 & g17_chosen=2 & T19_achievable*N > decision_T19 -> true;

  [achieved_G17] g17_state=1 & g17_achieved & t18_state=0 & t19_state=0 -> (g17_state'=0);
  
  [skip_G17] g17_chosen=0 & !g17_achieved & g17_state=1 & t18_state=0 & t19_state=0 & G17_achievable*N <= decision_G17 -> (g17_state'=0);
  [skip_G17] !g17_achieved & g17_state=1 & t18_state=0 & g17_chosen=1 & T18_achievable*N <= decision_T18 -> (g17_state'=0);
  [skip_G17] !g17_achieved & g17_state=1 & t19_state=0 & g17_chosen=2 & T19_achievable*N <= decision_T19 -> (g17_state'=0);
endmodule

formula g17_achieved = (t18_achieved | t19_achieved);
formula G17_achievable = g17_chosen=1 ? T18_achievable : g17_chosen=2 ? T19_achievable : (T18_achievable + T19_achievable - (T18_achievable * T19_achievable));

// ID: G20
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T21, T22
module G20
  g20_state : [0..1] init 0;
  t21_failed : [0..3] init 0;

  [pursue_G20] !g20_achieved & g20_state=0 -> (g20_state'=1);
  [pursue_T21] !g20_achieved & g20_state=1 & t21_failed<3 & T21_achievable*N > decision_T21 -> (t21_failed'=t21_failed+1);
  [pursue_T21] !g20_achieved & g20_state=1 & t21_failed=3 & G20_achievable*N > decision_G20 & t22_state=0 & (T21_achievable/(T21_achievable+T22_achievable))*N > _decision_G20 -> true;
  [pursue_T22] !g20_achieved & g20_state=1 & t21_failed=3 & G20_achievable*N > decision_G20 & t21_state=0 & (T22_achievable/(T21_achievable+T22_achievable))*N > _decision_G20 & !((T21_achievable/(T21_achievable+T22_achievable))*N > _decision_G20) -> true;

  [achieved_G20] g20_state=1 & g20_achieved & t21_state=0 & t22_state=0 -> (g20_state'=0);
  
  [skip_G20] !g20_achieved & g20_state=1 & t21_state=0 & t21_failed<3 & T21_achievable*N <= decision_T21 -> (g20_state'=0);
  [skip_G20] t21_failed=3 & !g20_achieved & g20_state=1 & t21_state=0 & t22_state=0 & G20_achievable*N <= decision_G20 -> (g20_state'=0);
endmodule

formula g20_achieved = (t21_achieved | (t21_failed=3 & t22_achieved));
formula G20_achievable = T21_achievable + T22_achievable - (T21_achievable * T22_achievable);

// ID: G23
// Name: goal
// Type: choice
// Relation to children: or
// Children: T24, T25
module G23
  g23_state : [0..1] init 0;
  g23_chosen : [0..2] init 0;

  [pursue_G23] !g23_achieved & g23_state=0 -> (g23_state'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=0 & G23_achievable*N > decision_G23 & t25_state=0 & (T24_achievable/(T24_achievable+T25_achievable))*N > _decision_G23 -> (g23_chosen'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=1 & T24_achievable*N > decision_T24 -> true;
