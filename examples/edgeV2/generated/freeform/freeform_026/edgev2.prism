// ID: G4
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T5, T6, T7
module G4
  g4_state : [0..1] init 0;
  t5_failed : [0..2] init 0;

  [pursue_G4] !g4_achieved & g4_state=0 -> (g4_state'=1);
  [pursue_T5] !g4_achieved & g4_state=1 & t5_failed<2 & T5_achievable*N > decision_T5 -> (t5_failed'=t5_failed+1);
  [pursue_T5] !g4_achieved & g4_state=1 & t5_failed=2 & G4_achievable*N > decision_G4 & t6_state=0 & t7_state=0 & (T5_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4 -> true;
  [pursue_T6] !g4_achieved & g4_state=1 & t5_failed=2 & G4_achievable*N > decision_G4 & t5_state=0 & t7_state=0 & (T6_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4 & !((T5_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4) -> true;
  [pursue_T7] !g4_achieved & g4_state=1 & t5_failed=2 & G4_achievable*N > decision_G4 & t5_state=0 & t6_state=0 & (T7_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4 & !((T5_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4) & !((T6_achievable/(T5_achievable+T6_achievable+T7_achievable))*N > _decision_G4) -> true;

  [achieved_G4] g4_state=1 & g4_achieved & t5_state=0 & t6_state=0 & t7_state=0 -> (g4_state'=0);
  
  [skip_G4] !g4_achieved & g4_state=1 & t5_state=0 & t5_failed<2 & T5_achievable*N <= decision_T5 -> (g4_state'=0);
  [skip_G4] t5_failed=2 & !g4_achieved & g4_state=1 & t5_state=0 & t6_state=0 & t7_state=0 & G4_achievable*N <= decision_G4 -> (g4_state'=0);
endmodule

formula g4_achieved = (t5_achieved | (t5_failed=2 & t6_achieved) | (t5_failed=2 & t7_achieved));
formula G4_achievable = T5_achievable + T6_achievable + T7_achievable - (T5_achievable * T6_achievable * T7_achievable);

