  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_G4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g8_state=0 & g13_state=0 & t15_state=0 -> true;
  [pursue_G8] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g4_achieved & g4_state=0 & g13_state=0 & t15_state=0 -> true;
  [pursue_G13] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g4_achieved & g8_achieved & g4_state=0 & g8_state=0 & t15_state=0 -> true;
  [pursue_T15] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g4_achieved & g8_achieved & g13_achieved & g4_state=0 & g8_state=0 & g13_state=0 -> true;

  [achieved_G3] g3_state=1 & g3_achieved & g4_state=0 & g8_state=0 & g13_state=0 & t15_state=0 -> (g3_state'=0);
  
