// ID: G8
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T9, T10, T11, T12
module G8
  g8_state : [0..1] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t10_state=0 & t11_state=0 & t12_state=0 & T9_relative*N > _decision_G8 -> true;
  [pursue_T10] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_state=0 & t11_state=0 & t12_state=0 & T10_relative*N > _decision_G8 & !(T9_relative*N > _decision_G8) -> true;
  [pursue_T11] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_state=0 & t10_state=0 & t12_state=0 & T11_relative*N > _decision_G8 & !(T9_relative*N > _decision_G8) & !(T10_relative*N > _decision_G8) -> true;
  [pursue_T12] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_state=0 & t10_state=0 & t11_state=0 & T12_relative*N > _decision_G8 & !(T9_relative*N > _decision_G8) & !(T10_relative*N > _decision_G8) & !(T11_relative*N > _decision_G8) -> true;

  [achieved_G8] g8_state=1 & g8_achieved & t9_state=0 & t10_state=0 & t11_state=0 & t12_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & t9_state=0 & t10_state=0 & t11_state=0 & t12_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (t9_achieved & t10_achieved & t11_achieved & t12_achieved);
formula G8_achievable = g8_achieved ? 0 : (!t9_achieved ? T9_achievable : 1) * (!t10_achieved ? T10_achievable : 1) * (!t11_achieved ? T11_achievable : 1) * (!t12_achieved ? T12_achievable : 1);
formula T9_relative = t9_achieved ? 0 : T9_achievable/(T9_achievable + (t10_achieved ? 0 : T10_achievable) + (t11_achieved ? 0 : T11_achievable) + (t12_achieved ? 0 : T12_achievable));
formula T10_relative = t10_achieved ? 0 : T10_achievable/(T10_achievable + (t9_achieved ? 0 : T9_achievable) + (t11_achieved ? 0 : T11_achievable) + (t12_achieved ? 0 : T12_achievable));
formula T11_relative = t11_achieved ? 0 : T11_achievable/(T11_achievable + (t9_achieved ? 0 : T9_achievable) + (t10_achieved ? 0 : T10_achievable) + (t12_achieved ? 0 : T12_achievable));
formula T12_relative = t12_achieved ? 0 : T12_achievable/(T12_achievable + (t9_achieved ? 0 : T9_achievable) + (t10_achieved ? 0 : T10_achievable) + (t11_achieved ? 0 : T11_achievable));

