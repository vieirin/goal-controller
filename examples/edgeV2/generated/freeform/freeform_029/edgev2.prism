// ID: G0
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G1, G16, G32, G48
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G16] !g0_achieved & g0_state=1 & G16_achievable*N > decision_G16 -> true;
  [pursue_G32] !g0_achieved & g0_state=1 & G32_achievable*N > decision_G32 -> true;
  [pursue_G48] !g0_achieved & g0_state=1 & G48_achievable*N > decision_G48 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g16_state=0 & g32_state=0 & g48_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g16_state=0 & g32_state=0 & g48_state=0 & !(G1_achievable*N > decision_G1 | G16_achievable*N > decision_G16 | G32_achievable*N > decision_G32 | G48_achievable*N > decision_G48) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g16_achieved & g32_achieved & g48_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g16_achieved ? G16_achievable : 1) * (!g32_achieved ? G32_achievable : 1) * (!g48_achieved ? G48_achievable : 1);

// ID: G1
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G2, G8
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G2_achievable*N > decision_G2 -> true;
  [pursue_G8] !g1_achieved & g1_state=1 & G8_achievable*N > decision_G8 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g8_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g8_state=0 & !(G2_achievable*N > decision_G2 | G8_achievable*N > decision_G8) -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved & g8_achieved);
formula G1_achievable = g1_achieved ? 0 : (!g2_achieved ? G2_achievable : 1) * (!g8_achieved ? G8_achievable : 1);

// ID: G2
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G3, G5
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_G3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & g5_state=0 & (G3_achievable/(G3_achievable+G5_achievable))*N > _decision_G2 -> true;
  [pursue_G5] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & g3_state=0 & (G5_achievable/(G3_achievable+G5_achievable))*N > _decision_G2 & !((G3_achievable/(G3_achievable+G5_achievable))*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & g3_state=0 & g5_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & g3_state=0 & g5_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (g3_achieved | g5_achieved);
formula G2_achievable = G3_achievable + G5_achievable - (G3_achievable * G5_achievable);

// ID: G3
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T4
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & (T4_achievable/(T4_achievable))*N > _decision_G3 -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

formula g3_achieved = (t4_achieved);
formula G3_achievable = T4_achievable;

// ID: G5
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T6, T7
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t7_state=0 & (T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 -> true;
  [pursue_T7] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t6_state=0 & (T7_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 & !((T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5) -> true;

  [achieved_G5] g5_state=1 & g5_achieved & t6_state=0 & t7_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & t6_state=0 & t7_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (t6_achieved | t7_achieved);
formula G5_achievable = T6_achievable + T7_achievable - (T6_achievable * T7_achievable);

// ID: G8
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G9, G13
module G8
  g8_state : [0..1] init 0;
  g9_failed : [0..5] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_G9] !g8_achieved & g8_state=1 & g9_failed<5 & G9_achievable*N > decision_G9 -> (g9_failed'=g9_failed+1);
  [pursue_G9] !g8_achieved & g8_state=1 & g9_failed=5 & G8_achievable*N > decision_G8 & g13_state=0 & (G9_achievable/(G9_achievable+G13_achievable))*N > _decision_G8 -> true;
  [pursue_G13] !g8_achieved & g8_state=1 & g9_failed=5 & G8_achievable*N > decision_G8 & g9_state=0 & (G13_achievable/(G9_achievable+G13_achievable))*N > _decision_G8 & !((G9_achievable/(G9_achievable+G13_achievable))*N > _decision_G8) -> true;

  [achieved_G8] g8_state=1 & g8_achieved & g9_state=0 & g13_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & g9_state=0 & g9_failed<5 & G9_achievable*N <= decision_G9 -> (g8_state'=0);
  [skip_G8] g9_failed=5 & !g8_achieved & g8_state=1 & g9_state=0 & g13_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (g9_achieved | (g9_failed=5 & g13_achieved));
formula G8_achievable = G9_achievable + G13_achievable - (G9_achievable * G13_achievable);

// ID: G9
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T10, T11, T12
module G9
  g9_state : [0..1] init 0;

  [pursue_G9] !g9_achieved & g9_state=0 -> (g9_state'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & G9_achievable*N > decision_G9 & t11_state=0 & t12_state=0 & (T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 -> true;
  [pursue_T11] !g9_achieved & g9_state=1 & G9_achievable*N > decision_G9 & t10_state=0 & t12_state=0 & (T11_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) -> true;
  [pursue_T12] !g9_achieved & g9_state=1 & G9_achievable*N > decision_G9 & t10_state=0 & t11_state=0 & (T12_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) & !((T11_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) -> true;

  [achieved_G9] g9_state=1 & g9_achieved & t10_state=0 & t11_state=0 & t12_state=0 -> (g9_state'=0);
  
  [skip_G9] !g9_achieved & g9_state=1 & t10_state=0 & t11_state=0 & t12_state=0 & G9_achievable*N <= decision_G9 -> (g9_state'=0);
endmodule

formula g9_achieved = (t10_achieved | t11_achieved | t12_achieved);
formula G9_achievable = T10_achievable + T11_achievable + T12_achievable - (T10_achievable * T11_achievable * T12_achievable);

// ID: G13
// Name: goal
// Type: choice
// Relation to children: or
// Children: T14, T15
module G13
  g13_state : [0..1] init 0;
  g13_chosen : [0..2] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & g13_chosen=0 & G13_achievable*N > decision_G13 & t15_state=0 & (T14_achievable/(T14_achievable+T15_achievable))*N > _decision_G13 -> (g13_chosen'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & g13_chosen=1 & T14_achievable*N > decision_T14 -> true;
  [pursue_T15] !g13_achieved & g13_state=1 & g13_chosen=0 & G13_achievable*N > decision_G13 & t14_state=0 & (T15_achievable/(T14_achievable+T15_achievable))*N > _decision_G13 & !((T14_achievable/(T14_achievable+T15_achievable))*N > _decision_G13) -> (g13_chosen'=2);
  [pursue_T15] !g13_achieved & g13_state=1 & g13_chosen=2 & T15_achievable*N > decision_T15 -> true;

  [achieved_G13] g13_state=1 & g13_achieved & t14_state=0 & t15_state=0 -> (g13_state'=0);
  
  [skip_G13] g13_chosen=0 & !g13_achieved & g13_state=1 & t14_state=0 & t15_state=0 & G13_achievable*N <= decision_G13 -> (g13_state'=0);
  [skip_G13] !g13_achieved & g13_state=1 & t14_state=0 & g13_chosen=1 & T14_achievable*N <= decision_T14 -> (g13_state'=0);
  [skip_G13] !g13_achieved & g13_state=1 & t15_state=0 & g13_chosen=2 & T15_achievable*N <= decision_T15 -> (g13_state'=0);
endmodule

formula g13_achieved = (t14_achieved | t15_achieved);
formula G13_achievable = g13_chosen=1 ? T14_achievable : g13_chosen=2 ? T15_achievable : (T14_achievable + T15_achievable - (T14_achievable * T15_achievable));

// ID: G16
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G17, T30, T31
module G16
  g16_state : [0..1] init 0;

  [pursue_G16] !g16_achieved & g16_state=0 -> (g16_state'=1);
  [pursue_G17] !g16_achieved & g16_state=1 & G17_achievable*N > decision_G17 -> true;
  [pursue_T30] !g16_achieved & g16_state=1 & T30_achievable*N > decision_T30 -> true;
  [pursue_T31] !g16_achieved & g16_state=1 & T31_achievable*N > decision_T31 -> true;

  [achieved_G16] g16_state=1 & g16_achieved & g17_state=0 & t30_state=0 & t31_state=0 -> (g16_state'=0);
  
  [skip_G16] !g16_achieved & g16_state=1 & g17_state=0 & t30_state=0 & t31_state=0 & !(G17_achievable*N > decision_G17 | T30_achievable*N > decision_T30 | T31_achievable*N > decision_T31) -> (g16_state'=0);
endmodule

formula g16_achieved = (g17_achieved & t30_achieved & t31_achieved);
formula G16_achievable = g16_achieved ? 0 : (!g17_achieved ? G17_achievable : 1) * (!t30_achieved ? T30_achievable : 1) * (!t31_achieved ? T31_achievable : 1);

// ID: G17
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G18, G23, G26
module G17
  g17_state : [0..1] init 0;

  [pursue_G17] !g17_achieved & g17_state=0 -> (g17_state'=1);
  [pursue_G18] !g17_achieved & g17_state=1 & G17_achievable*N > decision_G17 & g23_state=0 & g26_state=0 & (G18_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17 -> true;
  [pursue_G23] !g17_achieved & g17_state=1 & G17_achievable*N > decision_G17 & g18_state=0 & g26_state=0 & (G23_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17 & !((G18_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17) -> true;
  [pursue_G26] !g17_achieved & g17_state=1 & G17_achievable*N > decision_G17 & g18_state=0 & g23_state=0 & (G26_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17 & !((G18_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17) & !((G23_achievable/(G18_achievable+G23_achievable+G26_achievable))*N > _decision_G17) -> true;

  [achieved_G17] g17_state=1 & g17_achieved & g18_state=0 & g23_state=0 & g26_state=0 -> (g17_state'=0);
  
  [skip_G17] !g17_achieved & g17_state=1 & g18_state=0 & g23_state=0 & g26_state=0 & G17_achievable*N <= decision_G17 -> (g17_state'=0);
endmodule

formula g17_achieved = (g18_achieved | g23_achieved | g26_achieved);
formula G17_achievable = G18_achievable + G23_achievable + G26_achievable - (G18_achievable * G23_achievable * G26_achievable);

// ID: G18
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T19, T20, T21, T22
module G18
  g18_state : [0..1] init 0;

  [pursue_G18] !g18_achieved & g18_state=0 -> (g18_state'=1);
  [pursue_T19] !g18_achieved & g18_state=1 & T19_achievable*N > decision_T19 -> true;
