module G23
  g23_state : [0..1] init 0;
  g23_chosen : [0..2] init 0;

  [pursue_G23] !g23_achieved & g23_state=0 -> (g23_state'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=0 & G23_achievable*N > decision_G23 & t25_state=0 & (T24_achievable/(T24_achievable+T25_achievable))*N > _decision_G23 -> (g23_chosen'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=1 & T24_achievable*N > decision_T24 -> true;
  [pursue_T25] !g23_achieved & g23_state=1 & g23_chosen=0 & G23_achievable*N > decision_G23 & t24_state=0 & (T25_achievable/(T24_achievable+T25_achievable))*N > _decision_G23 & !((T24_achievable/(T24_achievable+T25_achievable))*N > _decision_G23) -> (g23_chosen'=2);
  [pursue_T25] !g23_achieved & g23_state=1 & g23_chosen=2 & T25_achievable*N > decision_T25 -> true;

  [achieved_G23] g23_state=1 & g23_achieved & t24_state=0 & t25_state=0 -> (g23_state'=0);
  
  [skip_G23] g23_chosen=0 & !g23_achieved & g23_state=1 & t24_state=0 & t25_state=0 & G23_achievable*N <= decision_G23 -> (g23_state'=0);
  [skip_G23] !g23_achieved & g23_state=1 & t24_state=0 & g23_chosen=1 & T24_achievable*N <= decision_T24 -> (g23_state'=0);
  [skip_G23] !g23_achieved & g23_state=1 & t25_state=0 & g23_chosen=2 & T25_achievable*N <= decision_T25 -> (g23_state'=0);
endmodule

formula g23_achieved = (t24_achieved | t25_achieved);
formula G23_achievable = g23_chosen=1 ? T24_achievable : g23_chosen=2 ? T25_achievable : (T24_achievable + T25_achievable - (T24_achievable * T25_achievable));

// ID: G26
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T27, T28, T29
module G26
  g26_state : [0..1] init 0;

  [pursue_G26] !g26_achieved & g26_state=0 -> (g26_state'=1);
  [pursue_T27] !g26_achieved & g26_state=1 & G26_achievable*N > decision_G26 & t28_state=0 & t29_state=0 & T27_relative*N > _decision_G26 -> true;
  [pursue_T28] !g26_achieved & g26_state=1 & G26_achievable*N > decision_G26 & t27_state=0 & t29_state=0 & T28_relative*N > _decision_G26 & !(T27_relative*N > _decision_G26) -> true;
  [pursue_T29] !g26_achieved & g26_state=1 & G26_achievable*N > decision_G26 & t27_state=0 & t28_state=0 & T29_relative*N > _decision_G26 & !(T27_relative*N > _decision_G26) & !(T28_relative*N > _decision_G26) -> true;

  [achieved_G26] g26_state=1 & g26_achieved & t27_state=0 & t28_state=0 & t29_state=0 -> (g26_state'=0);
  
  [skip_G26] !g26_achieved & g26_state=1 & t27_state=0 & t28_state=0 & t29_state=0 & G26_achievable*N <= decision_G26 -> (g26_state'=0);
endmodule

formula g26_achieved = (t27_achieved & t28_achieved & t29_achieved);
