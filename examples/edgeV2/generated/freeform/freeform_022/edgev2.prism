dtmc

const int N = 10;
const int decision_G0;
const int _decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G10;
const int decision_G2;
const int decision_G5;
const int decision_G6;
const int _decision_G6;
const int decision_T11;
const int decision_T12;
const int decision_T13;
const int decision_T3;
const int decision_T4;
const int decision_T7;
const int decision_T8;
const int decision_T9;

const double T3_achievable = 0.8;
formula t3_achieved = (t3_achieved_=1);
module T3
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  // Task T3: task
  [pursue_T3] t3_state=0 & t3_achieved_=0 -> (t3_state'=1);
  [try_T3] t3_state=1 & t3_achieved_=0 -> T3_achievable: (t3_achieved_'=1) + 1-T3_achievable: (t3_state'=0);
  [achieved_T3] t3_state=1 & t3_achieved_=1 -> (t3_state'=0);
endmodule

const double T4_achievable = 0.8;
formula t4_achieved = (t4_achieved_=1);
module T4
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
endmodule

// ID: G2
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T3, T4
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & T3_achievable*N > decision_T3 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & T4_achievable*N > decision_T4 -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & !(T3_achievable*N > decision_T3 | T4_achievable*N > decision_T4) -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved & t4_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1) * (!t4_achieved ? T4_achievable : 1);

// ID: G1
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: G2
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & (G2_achievable/(G2_achievable))*N > _decision_G1 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved);
formula G1_achievable = G2_achievable;

const double T7_achievable = 0.8;
formula t7_achieved = (t7_achieved_=1);
module T7
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  // Task T7: task
  [pursue_T7] t7_state=0 & t7_achieved_=0 -> (t7_state'=1);
  [try_T7] t7_state=1 & t7_achieved_=0 -> T7_achievable: (t7_achieved_'=1) + 1-T7_achievable: (t7_state'=0);
  [achieved_T7] t7_state=1 & t7_achieved_=1 -> (t7_state'=0);
endmodule

const double T8_achievable = 0.8;
formula t8_achieved = (t8_achieved_=1);
module T8
  t8_state: [0..1] init 0;
  t8_achieved_: [0..1] init 0;
  // Task T8: task
  [pursue_T8] t8_state=0 & t8_achieved_=0 -> (t8_state'=1);
  [try_T8] t8_state=1 & t8_achieved_=0 -> T8_achievable: (t8_achieved_'=1) + 1-T8_achievable: (t8_state'=0);
  [achieved_T8] t8_state=1 & t8_achieved_=1 -> (t8_state'=0);
endmodule

const double T9_achievable = 0.8;
formula t9_achieved = (t9_achieved_=1);
module T9
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  // Task T9: task
  [pursue_T9] t9_state=0 & t9_achieved_=0 -> (t9_state'=1);
  [try_T9] t9_state=1 & t9_achieved_=0 -> T9_achievable: (t9_achieved_'=1) + 1-T9_achievable: (t9_state'=0);
  [achieved_T9] t9_state=1 & t9_achieved_=1 -> (t9_state'=0);
endmodule

// ID: G6
// Name: goal
// Type: choice
// Relation to children: or
// Children: T7, T8, T9
module G6
  g6_state : [0..1] init 0;
  g6_chosen : [0..3] init 0;

  [pursue_G6] !g6_achieved & g6_state=0 -> (g6_state'=1);
  [pursue_T7] !g6_achieved & g6_state=1 & g6_chosen=0 & G6_achievable*N > decision_G6 & t8_state=0 & t9_state=0 & (T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 -> (g6_chosen'=1);
  [pursue_T7] !g6_achieved & g6_state=1 & g6_chosen=1 & T7_achievable*N > decision_T7 -> true;
  [pursue_T8] !g6_achieved & g6_state=1 & g6_chosen=0 & G6_achievable*N > decision_G6 & t7_state=0 & t9_state=0 & (T8_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 & !((T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) -> (g6_chosen'=2);
  [pursue_T8] !g6_achieved & g6_state=1 & g6_chosen=2 & T8_achievable*N > decision_T8 -> true;
  [pursue_T9] !g6_achieved & g6_state=1 & g6_chosen=0 & G6_achievable*N > decision_G6 & t7_state=0 & t8_state=0 & (T9_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 & !((T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) & !((T8_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) -> (g6_chosen'=3);
  [pursue_T9] !g6_achieved & g6_state=1 & g6_chosen=3 & T9_achievable*N > decision_T9 -> true;

  [achieved_G6] g6_state=1 & g6_achieved & t7_state=0 & t8_state=0 & t9_state=0 -> (g6_state'=0);
  
  [skip_G6] g6_chosen=0 & !g6_achieved & g6_state=1 & t7_state=0 & t8_state=0 & t9_state=0 & G6_achievable*N <= decision_G6 -> (g6_state'=0);
  [skip_G6] !g6_achieved & g6_state=1 & t7_state=0 & g6_chosen=1 & T7_achievable*N <= decision_T7 -> (g6_state'=0);
  [skip_G6] !g6_achieved & g6_state=1 & t8_state=0 & g6_chosen=2 & T8_achievable*N <= decision_T8 -> (g6_state'=0);
  [skip_G6] !g6_achieved & g6_state=1 & t9_state=0 & g6_chosen=3 & T9_achievable*N <= decision_T9 -> (g6_state'=0);
endmodule

formula g6_achieved = (t7_achieved | t8_achieved | t9_achieved);
formula G6_achievable = g6_chosen=1 ? T7_achievable : g6_chosen=2 ? T8_achievable : g6_chosen=3 ? T9_achievable : (T7_achievable + T8_achievable + T9_achievable - (T7_achievable * T8_achievable * T9_achievable));

const double T11_achievable = 0.8;
formula t11_achieved = (t11_achieved_=1);
module T11
  t11_state: [0..1] init 0;
  t11_achieved_: [0..1] init 0;
  // Task T11: task
  [pursue_T11] t11_state=0 & t11_achieved_=0 -> (t11_state'=1);
  [try_T11] t11_state=1 & t11_achieved_=0 -> T11_achievable: (t11_achieved_'=1) + 1-T11_achievable: (t11_state'=0);
  [achieved_T11] t11_state=1 & t11_achieved_=1 -> (t11_state'=0);
endmodule

const double T12_achievable = 0.8;
formula t12_achieved = (t12_achieved_=1);
module T12
  t12_state: [0..1] init 0;
  t12_achieved_: [0..1] init 0;
  // Task T12: task
  [pursue_T12] t12_state=0 & t12_achieved_=0 -> (t12_state'=1);
  [try_T12] t12_state=1 & t12_achieved_=0 -> T12_achievable: (t12_achieved_'=1) + 1-T12_achievable: (t12_state'=0);
  [achieved_T12] t12_state=1 & t12_achieved_=1 -> (t12_state'=0);
endmodule

// ID: G10
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T11, T12
module G10
  g10_state : [0..1] init 0;

  [pursue_G10] !g10_achieved & g10_state=0 -> (g10_state'=1);
  [pursue_T11] !g10_achieved & g10_state=1 & T11_achievable*N > decision_T11 -> true;
  [pursue_T12] !g10_achieved & g10_state=1 & T12_achievable*N > decision_T12 -> true;

  [achieved_G10] g10_state=1 & g10_achieved & t11_state=0 & t12_state=0 -> (g10_state'=0);
  
  [skip_G10] !g10_achieved & g10_state=1 & t11_state=0 & t12_state=0 & !(T11_achievable*N > decision_T11 | T12_achievable*N > decision_T12) -> (g10_state'=0);
endmodule

formula g10_achieved = (t11_achieved & t12_achieved);
formula G10_achievable = g10_achieved ? 0 : (!t11_achieved ? T11_achievable : 1) * (!t12_achieved ? T12_achievable : 1);

const double T13_achievable = 0.8;
formula t13_achieved = (t13_achieved_=1);
module T13
  t13_state: [0..1] init 0;
  t13_achieved_: [0..1] init 0;
  // Task T13: task
  [pursue_T13] t13_state=0 & t13_achieved_=0 -> (t13_state'=1);
  [try_T13] t13_state=1 & t13_achieved_=0 -> T13_achievable: (t13_achieved_'=1) + 1-T13_achievable: (t13_state'=0);
  [achieved_T13] t13_state=1 & t13_achieved_=1 -> (t13_state'=0);
endmodule

// ID: G5
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G6, G10, T13
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_G6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & g10_state=0 & t13_state=0 -> true;
  [pursue_G10] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & g6_achieved & g6_state=0 & t13_state=0 -> true;
  [pursue_T13] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & g6_achieved & g10_achieved & g6_state=0 & g10_state=0 -> true;

  [achieved_G5] g5_state=1 & g5_achieved & g6_state=0 & g10_state=0 & t13_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & g6_state=0 & g10_state=0 & t13_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (g6_achieved & g10_achieved & t13_achieved);
formula G5_achievable = g5_achieved ? 0 : (!g6_achieved ? G6_achievable : 1) * (!g10_achieved ? G10_achievable : 1) * (!t13_achieved ? T13_achievable : 1);

// ID: G0
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G1, G5
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g5_state=0 & G1_relative*N > _decision_G0 -> true;
  [pursue_G5] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & G5_relative*N > _decision_G0 & !(G1_relative*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g5_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g5_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g5_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g5_achieved ? G5_achievable : 1);
formula G1_relative = g1_achieved ? 0 : G1_achievable/(G1_achievable + (g5_achieved ? 0 : G5_achievable));
formula G5_relative = g5_achieved ? 0 : G5_achievable/(G5_achievable + (g1_achieved ? 0 : G1_achievable));

module System
  
endmodule
