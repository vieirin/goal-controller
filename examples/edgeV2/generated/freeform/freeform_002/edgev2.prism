// ID: G4
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: G5, T18, T19
module G4
  g4_state : [0..1] init 0;

  [pursue_G4] !g4_achieved & g4_state=0 -> (g4_state'=1);
  [pursue_G5] !g4_achieved & g4_state=1 & G5_achievable*N > decision_G5 -> true;
  [pursue_T18] !g4_achieved & g4_state=1 & T18_achievable*N > decision_T18 -> true;
  [pursue_T19] !g4_achieved & g4_state=1 & T19_achievable*N > decision_T19 -> true;

  [achieved_G4] g4_state=1 & g4_achieved & g5_state=0 & t18_state=0 & t19_state=0 -> (g4_state'=0);
  
  [skip_G4] !g4_achieved & g4_state=1 & g5_state=0 & t18_state=0 & t19_state=0 & !(G5_achievable*N > decision_G5 | T18_achievable*N > decision_T18 | T19_achievable*N > decision_T19) -> (g4_state'=0);
endmodule

formula g4_achieved = (g5_achieved & t18_achieved & t19_achieved);
formula G4_achievable = g4_achieved ? 0 : (!g5_achieved ? G5_achievable : 1) * (!t18_achieved ? T18_achievable : 1) * (!t19_achieved ? T19_achievable : 1);

// ID: G0
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G1, G4
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g4_state=0 -> true;
  [pursue_G4] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_achieved & g1_state=0 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g4_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g4_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g4_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g4_achieved ? G4_achievable : 1);

module System
  
endmodule
