// ID: G13
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T14, T15, T16, T17
module G13
  g13_state : [0..1] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t15_state=0 & t16_state=0 & t17_state=0 & T14_relative*N > _decision_G13 -> true;
  [pursue_T15] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_state=0 & t16_state=0 & t17_state=0 & T15_relative*N > _decision_G13 & !(T14_relative*N > _decision_G13) -> true;
  [pursue_T16] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_state=0 & t15_state=0 & t17_state=0 & T16_relative*N > _decision_G13 & !(T14_relative*N > _decision_G13) & !(T15_relative*N > _decision_G13) -> true;
  [pursue_T17] !g13_achieved & g13_state=1 & G13_achievable*N > decision_G13 & t14_state=0 & t15_state=0 & t16_state=0 & T17_relative*N > _decision_G13 & !(T14_relative*N > _decision_G13) & !(T15_relative*N > _decision_G13) & !(T16_relative*N > _decision_G13) -> true;

  [achieved_G13] g13_state=1 & g13_achieved & t14_state=0 & t15_state=0 & t16_state=0 & t17_state=0 -> (g13_state'=0);
  
  [skip_G13] !g13_achieved & g13_state=1 & t14_state=0 & t15_state=0 & t16_state=0 & t17_state=0 & G13_achievable*N <= decision_G13 -> (g13_state'=0);
endmodule

formula g13_achieved = (t14_achieved & t15_achieved & t16_achieved & t17_achieved);
formula G13_achievable = g13_achieved ? 0 : (!t14_achieved ? T14_achievable : 1) * (!t15_achieved ? T15_achievable : 1) * (!t16_achieved ? T16_achievable : 1) * (!t17_achieved ? T17_achievable : 1);
formula T14_relative = t14_achieved ? 0 : T14_achievable/(T14_achievable + (t15_achieved ? 0 : T15_achievable) + (t16_achieved ? 0 : T16_achievable) + (t17_achieved ? 0 : T17_achievable));
formula T15_relative = t15_achieved ? 0 : T15_achievable/(T15_achievable + (t14_achieved ? 0 : T14_achievable) + (t16_achieved ? 0 : T16_achievable) + (t17_achieved ? 0 : T17_achievable));
formula T16_relative = t16_achieved ? 0 : T16_achievable/(T16_achievable + (t14_achieved ? 0 : T14_achievable) + (t15_achieved ? 0 : T15_achievable) + (t17_achieved ? 0 : T17_achievable));
formula T17_relative = t17_achieved ? 0 : T17_achievable/(T17_achievable + (t14_achieved ? 0 : T14_achievable) + (t15_achieved ? 0 : T15_achievable) + (t16_achieved ? 0 : T16_achievable));

// ID: G5
// Name: goal
// Type: choice
// Relation to children: or
// Children: G6, G9, G13
module G5
  g5_state : [0..1] init 0;
  g5_chosen : [0..3] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_G6] !g5_achieved & g5_state=1 & g5_chosen=0 & G5_achievable*N > decision_G5 & g9_state=0 & g13_state=0 & (G6_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5 -> (g5_chosen'=1);
  [pursue_G6] !g5_achieved & g5_state=1 & g5_chosen=1 & G6_achievable*N > decision_G6 -> true;
  [pursue_G9] !g5_achieved & g5_state=1 & g5_chosen=0 & G5_achievable*N > decision_G5 & g6_state=0 & g13_state=0 & (G9_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5 & !((G6_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5) -> (g5_chosen'=2);
  [pursue_G9] !g5_achieved & g5_state=1 & g5_chosen=2 & G9_achievable*N > decision_G9 -> true;
  [pursue_G13] !g5_achieved & g5_state=1 & g5_chosen=0 & G5_achievable*N > decision_G5 & g6_state=0 & g9_state=0 & (G13_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5 & !((G6_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5) & !((G9_achievable/(G6_achievable+G9_achievable+G13_achievable))*N > _decision_G5) -> (g5_chosen'=3);
  [pursue_G13] !g5_achieved & g5_state=1 & g5_chosen=3 & G13_achievable*N > decision_G13 -> true;

  [achieved_G5] g5_state=1 & g5_achieved & g6_state=0 & g9_state=0 & g13_state=0 -> (g5_state'=0);
  
  [skip_G5] g5_chosen=0 & !g5_achieved & g5_state=1 & g6_state=0 & g9_state=0 & g13_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
  [skip_G5] !g5_achieved & g5_state=1 & g6_state=0 & g5_chosen=1 & G6_achievable*N <= decision_G6 -> (g5_state'=0);
  [skip_G5] !g5_achieved & g5_state=1 & g9_state=0 & g5_chosen=2 & G9_achievable*N <= decision_G9 -> (g5_state'=0);
  [skip_G5] !g5_achieved & g5_state=1 & g13_state=0 & g5_chosen=3 & G13_achievable*N <= decision_G13 -> (g5_state'=0);
endmodule

formula g5_achieved = (g6_achieved | g9_achieved | g13_achieved);
formula G5_achievable = g5_chosen=1 ? G6_achievable : g5_chosen=2 ? G9_achievable : g5_chosen=3 ? G13_achievable : (G6_achievable + G9_achievable + G13_achievable - (G6_achievable * G9_achievable * G13_achievable));

