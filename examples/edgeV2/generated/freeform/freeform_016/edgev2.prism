dtmc

const int N = 10;
const int decision_G0;
const int _decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G11;
const int decision_G13;
const int _decision_G13;
const int decision_G14;
const int decision_G18;
const int _decision_G18;
const int decision_G2;
const int decision_G22;
const int _decision_G22;
const int decision_G5;
const int _decision_G5;
const int decision_G8;
const int _decision_G8;
const int decision_T10;
const int decision_T12;
const int decision_T15;
const int decision_T16;
const int decision_T17;
const int decision_T19;
const int decision_T20;
const int decision_T21;
const int decision_T23;
const int decision_T24;
const int decision_T25;
const int decision_T3;
const int decision_T4;
const int decision_T6;
const int decision_T7;
const int decision_T9;


// ID: G0
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G1, G8, G13
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g8_state=0 & g13_state=0 & (G1_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0 -> true;
  [pursue_G8] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g13_state=0 & (G8_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0) -> true;
  [pursue_G13] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & g8_state=0 & (G13_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0) & !((G8_achievable/(G1_achievable+G8_achievable+G13_achievable))*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g8_state=0 & g13_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g8_state=0 & g13_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | g8_achieved | g13_achieved);
formula G0_achievable = G1_achievable + G8_achievable + G13_achievable - (G1_achievable * G8_achievable * G13_achievable);

// ID: G1
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G2, G5
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g5_state=0 & (G2_achievable/(G2_achievable+G5_achievable))*N > _decision_G1 -> true;
  [pursue_G5] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & (G5_achievable/(G2_achievable+G5_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G5_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g5_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g5_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | g5_achieved);
formula G1_achievable = G2_achievable + G5_achievable - (G2_achievable * G5_achievable);

// ID: G2
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T3, T4
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & T3_achievable*N > decision_T3 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & T4_achievable*N > decision_T4 -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & !(T3_achievable*N > decision_T3 | T4_achievable*N > decision_T4) -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved & t4_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1) * (!t4_achieved ? T4_achievable : 1);

// ID: G5
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T6, T7
module G5
  g5_state : [0..1] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t7_state=0 & (T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 -> true;
  [pursue_T7] !g5_achieved & g5_state=1 & G5_achievable*N > decision_G5 & t6_state=0 & (T7_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 & !((T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5) -> true;

  [achieved_G5] g5_state=1 & g5_achieved & t6_state=0 & t7_state=0 -> (g5_state'=0);
  
  [skip_G5] !g5_achieved & g5_state=1 & t6_state=0 & t7_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
endmodule

formula g5_achieved = (t6_achieved | t7_achieved);
formula G5_achievable = T6_achievable + T7_achievable - (T6_achievable * T7_achievable);

// ID: G8
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T9, T10, G11
module G8
  g8_state : [0..1] init 0;
  t9_failed : [0..3] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & t9_failed<3 & T9_achievable*N > decision_T9 -> (t9_failed'=t9_failed+1);
  [pursue_T9] !g8_achieved & g8_state=1 & t9_failed=3 & G8_achievable*N > decision_G8 & t10_state=0 & g11_state=0 & (T9_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8 -> true;
  [pursue_T10] !g8_achieved & g8_state=1 & t9_failed=3 & G8_achievable*N > decision_G8 & t9_state=0 & g11_state=0 & (T10_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8) -> true;
  [pursue_G11] !g8_achieved & g8_state=1 & t9_failed=3 & G8_achievable*N > decision_G8 & t9_state=0 & t10_state=0 & (G11_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8) & !((T10_achievable/(T9_achievable+T10_achievable+G11_achievable))*N > _decision_G8) -> true;

  [achieved_G8] g8_state=1 & g8_achieved & t9_state=0 & t10_state=0 & g11_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & t9_state=0 & t9_failed<3 & T9_achievable*N <= decision_T9 -> (g8_state'=0);
  [skip_G8] t9_failed=3 & !g8_achieved & g8_state=1 & t9_state=0 & t10_state=0 & g11_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (t9_achieved | (t9_failed=3 & t10_achieved) | (t9_failed=3 & g11_achieved));
formula G8_achievable = T9_achievable + T10_achievable + G11_achievable - (T9_achievable * T10_achievable * G11_achievable);

// ID: G11
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T12
module G11
  g11_state : [0..1] init 0;

  [pursue_G11] !g11_achieved & g11_state=0 -> (g11_state'=1);
  [pursue_T12] !g11_achieved & g11_state=1 & T12_achievable*N > decision_T12 -> true;

  [achieved_G11] g11_state=1 & g11_achieved & t12_state=0 -> (g11_state'=0);
  
  [skip_G11] !g11_achieved & g11_state=1 & t12_state=0 & !(T12_achievable*N > decision_T12) -> (g11_state'=0);
endmodule

formula g11_achieved = (t12_achieved);
formula G11_achievable = g11_achieved ? 0 : (!t12_achieved ? T12_achievable : 1);

// ID: G13
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G14, G18, G22
module G13
  g13_state : [0..1] init 0;
  g14_failed : [0..5] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_G14] !g13_achieved & g13_state=1 & g14_failed<5 & G14_achievable*N > decision_G14 -> (g14_failed'=g14_failed+1);
  [pursue_G14] !g13_achieved & g13_state=1 & g14_failed=5 & G13_achievable*N > decision_G13 & g18_state=0 & g22_state=0 & (G14_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13 -> true;
  [pursue_G18] !g13_achieved & g13_state=1 & g14_failed=5 & G13_achievable*N > decision_G13 & g14_state=0 & g22_state=0 & (G18_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13 & !((G14_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13) -> true;
  [pursue_G22] !g13_achieved & g13_state=1 & g14_failed=5 & G13_achievable*N > decision_G13 & g14_state=0 & g18_state=0 & (G22_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13 & !((G14_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13) & !((G18_achievable/(G14_achievable+G18_achievable+G22_achievable))*N > _decision_G13) -> true;

  [achieved_G13] g13_state=1 & g13_achieved & g14_state=0 & g18_state=0 & g22_state=0 -> (g13_state'=0);
  
  [skip_G13] !g13_achieved & g13_state=1 & g14_state=0 & g14_failed<5 & G14_achievable*N <= decision_G14 -> (g13_state'=0);
  [skip_G13] g14_failed=5 & !g13_achieved & g13_state=1 & g14_state=0 & g18_state=0 & g22_state=0 & G13_achievable*N <= decision_G13 -> (g13_state'=0);
endmodule

formula g13_achieved = (g14_achieved | (g14_failed=5 & g18_achieved) | (g14_failed=5 & g22_achieved));
formula G13_achievable = G14_achievable + G18_achievable + G22_achievable - (G14_achievable * G18_achievable * G22_achievable);

// ID: G14
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T15, T16, T17
module G14
  g14_state : [0..1] init 0;

  [pursue_G14] !g14_achieved & g14_state=0 -> (g14_state'=1);
  [pursue_T15] !g14_achieved & g14_state=1 & T15_achievable*N > decision_T15 -> true;
  [pursue_T16] !g14_achieved & g14_state=1 & T16_achievable*N > decision_T16 -> true;
  [pursue_T17] !g14_achieved & g14_state=1 & T17_achievable*N > decision_T17 -> true;

  [achieved_G14] g14_state=1 & g14_achieved & t15_state=0 & t16_state=0 & t17_state=0 -> (g14_state'=0);
  
  [skip_G14] !g14_achieved & g14_state=1 & t15_state=0 & t16_state=0 & t17_state=0 & !(T15_achievable*N > decision_T15 | T16_achievable*N > decision_T16 | T17_achievable*N > decision_T17) -> (g14_state'=0);
endmodule

formula g14_achieved = (t15_achieved & t16_achieved & t17_achieved);
formula G14_achievable = g14_achieved ? 0 : (!t15_achieved ? T15_achievable : 1) * (!t16_achieved ? T16_achievable : 1) * (!t17_achieved ? T17_achievable : 1);

// ID: G18
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T19, T20, T21
module G18
  g18_state : [0..1] init 0;

  [pursue_G18] !g18_achieved & g18_state=0 -> (g18_state'=1);
  [pursue_T19] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & t20_state=0 & t21_state=0 & (T19_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18 -> true;
  [pursue_T20] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & t19_state=0 & t21_state=0 & (T20_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18 & !((T19_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18) -> true;
  [pursue_T21] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & t19_state=0 & t20_state=0 & (T21_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18 & !((T19_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18) & !((T20_achievable/(T19_achievable+T20_achievable+T21_achievable))*N > _decision_G18) -> true;

  [achieved_G18] g18_state=1 & g18_achieved & t19_state=0 & t20_state=0 & t21_state=0 -> (g18_state'=0);
  
  [skip_G18] !g18_achieved & g18_state=1 & t19_state=0 & t20_state=0 & t21_state=0 & G18_achievable*N <= decision_G18 -> (g18_state'=0);
endmodule

formula g18_achieved = (t19_achieved | t20_achieved | t21_achieved);
formula G18_achievable = T19_achievable + T20_achievable + T21_achievable - (T19_achievable * T20_achievable * T21_achievable);

// ID: G22
// Name: goal
// Type: choice
// Relation to children: or
// Children: T23, T24, T25
module G22
  g22_state : [0..1] init 0;
  g22_chosen : [0..3] init 0;

  [pursue_G22] !g22_achieved & g22_state=0 -> (g22_state'=1);
  [pursue_T23] !g22_achieved & g22_state=1 & g22_chosen=0 & G22_achievable*N > decision_G22 & t24_state=0 & t25_state=0 & (T23_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22 -> (g22_chosen'=1);
  [pursue_T23] !g22_achieved & g22_state=1 & g22_chosen=1 & T23_achievable*N > decision_T23 -> true;
  [pursue_T24] !g22_achieved & g22_state=1 & g22_chosen=0 & G22_achievable*N > decision_G22 & t23_state=0 & t25_state=0 & (T24_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22 & !((T23_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22) -> (g22_chosen'=2);
  [pursue_T24] !g22_achieved & g22_state=1 & g22_chosen=2 & T24_achievable*N > decision_T24 -> true;
  [pursue_T25] !g22_achieved & g22_state=1 & g22_chosen=0 & G22_achievable*N > decision_G22 & t23_state=0 & t24_state=0 & (T25_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22 & !((T23_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22) & !((T24_achievable/(T23_achievable+T24_achievable+T25_achievable))*N > _decision_G22) -> (g22_chosen'=3);
  [pursue_T25] !g22_achieved & g22_state=1 & g22_chosen=3 & T25_achievable*N > decision_T25 -> true;

  [achieved_G22] g22_state=1 & g22_achieved & t23_state=0 & t24_state=0 & t25_state=0 -> (g22_state'=0);
  
  [skip_G22] g22_chosen=0 & !g22_achieved & g22_state=1 & t23_state=0 & t24_state=0 & t25_state=0 & G22_achievable*N <= decision_G22 -> (g22_state'=0);
  [skip_G22] !g22_achieved & g22_state=1 & t23_state=0 & g22_chosen=1 & T23_achievable*N <= decision_T23 -> (g22_state'=0);
  [skip_G22] !g22_achieved & g22_state=1 & t24_state=0 & g22_chosen=2 & T24_achievable*N <= decision_T24 -> (g22_state'=0);
  [skip_G22] !g22_achieved & g22_state=1 & t25_state=0 & g22_chosen=3 & T25_achievable*N <= decision_T25 -> (g22_state'=0);
endmodule

formula g22_achieved = (t23_achieved | t24_achieved | t25_achieved);
formula G22_achievable = g22_chosen=1 ? T23_achievable : g22_chosen=2 ? T24_achievable : g22_chosen=3 ? T25_achievable : (T23_achievable + T24_achievable + T25_achievable - (T23_achievable * T24_achievable * T25_achievable));


const double T10_achievable = 0.8;
const double T12_achievable = 0.8;
const double T15_achievable = 0.8;
const double T16_achievable = 0.8;
const double T17_achievable = 0.8;
const double T19_achievable = 0.8;
const double T20_achievable = 0.8;
const double T21_achievable = 0.8;
const double T23_achievable = 0.8;
const double T24_achievable = 0.8;
const double T25_achievable = 0.8;
const double T3_achievable = 0.8;
const double T4_achievable = 0.8;
const double T6_achievable = 0.8;
const double T7_achievable = 0.8;
const double T9_achievable = 0.8;

module ChangeManager
  t10_state: [0..1] init 0;
  t10_achieved_: [0..1] init 0;
  t12_state: [0..1] init 0;
  t12_achieved_: [0..1] init 0;
  t15_state: [0..1] init 0;
  t15_achieved_: [0..1] init 0;
  t16_state: [0..1] init 0;
  t16_achieved_: [0..1] init 0;
  t17_state: [0..1] init 0;
  t17_achieved_: [0..1] init 0;
  t19_state: [0..1] init 0;
  t19_achieved_: [0..1] init 0;
  t20_state: [0..1] init 0;
  t20_achieved_: [0..1] init 0;
  t21_state: [0..1] init 0;
  t21_achieved_: [0..1] init 0;
  t23_state: [0..1] init 0;
  t23_achieved_: [0..1] init 0;
  t24_state: [0..1] init 0;
  t24_achieved_: [0..1] init 0;
  t25_state: [0..1] init 0;
  t25_achieved_: [0..1] init 0;
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t6_state: [0..1] init 0;
  t6_achieved_: [0..1] init 0;
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  
  // Task T10: task
  [pursue_T10] t10_state=0 & t10_achieved_=0 -> (t10_state'=1);
  [try_T10] t10_state=1 & t10_achieved_=0 -> T10_achievable: (t10_achieved_'=1) + 1-T10_achievable: (t10_state'=0);
  [achieved_T10] t10_state=1 & t10_achieved_=1 -> (t10_state'=0);
  

  // Task T12: task
  [pursue_T12] t12_state=0 & t12_achieved_=0 -> (t12_state'=1);
  [try_T12] t12_state=1 & t12_achieved_=0 -> T12_achievable: (t12_achieved_'=1) + 1-T12_achievable: (t12_state'=0);
  [achieved_T12] t12_state=1 & t12_achieved_=1 -> (t12_state'=0);
  

  // Task T15: task
  [pursue_T15] t15_state=0 & t15_achieved_=0 -> (t15_state'=1);
  [try_T15] t15_state=1 & t15_achieved_=0 -> T15_achievable: (t15_achieved_'=1) + 1-T15_achievable: (t15_state'=0);
  [achieved_T15] t15_state=1 & t15_achieved_=1 -> (t15_state'=0);
  

  // Task T16: task
  [pursue_T16] t16_state=0 & t16_achieved_=0 -> (t16_state'=1);
  [try_T16] t16_state=1 & t16_achieved_=0 -> T16_achievable: (t16_achieved_'=1) + 1-T16_achievable: (t16_state'=0);
  [achieved_T16] t16_state=1 & t16_achieved_=1 -> (t16_state'=0);
  

