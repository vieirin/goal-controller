P>=1 [ G t3_state + t4_state + t5_state <= 1 ];
P>=1 [ G t4_state=1 => (t3_achieved) ];
P>=1 [ G t5_state=1 => (t3_achieved & t4_achieved) ];
P>=1 [ G t8_state + t9_state + t10_state <= 1 ];
P>=1 [ G t9_state=1 => (t8_achieved) ];
P>=1 [ G t10_state=1 => (t8_achieved & t9_achieved) ];
P>=1 [ G g12_state + g14_state <= 1 ];
P>=1 [ G t15_state + t16_state + t17_state <= 1 ];
P=? [ F g0_achieved ]
