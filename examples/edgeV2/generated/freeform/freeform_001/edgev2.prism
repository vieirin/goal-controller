dtmc

const int N = 10;
const int decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G11;
const int _decision_G11;
const int decision_G12;
const int decision_G14;
const int _decision_G14;
const int decision_G2;
const int decision_G7;
const int decision_T10;
const int decision_T13;
const int decision_T15;
const int decision_T16;
const int decision_T17;
const int decision_T3;
const int decision_T4;
const int decision_T5;
const int decision_T6;
const int decision_T8;
const int decision_T9;


// ID: G0
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: G1, G11
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G11] !g0_achieved & g0_state=1 & G11_achievable*N > decision_G11 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g11_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g11_state=0 & !(G1_achievable*N > decision_G1 | G11_achievable*N > decision_G11) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g11_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g11_achieved ? G11_achievable : 1);

// ID: G1
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: G2, G7, T6
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g7_state=0 & t6_state=0 & (G2_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1 -> true;
  [pursue_G7] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & t6_state=0 & (G7_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1) -> true;
  [pursue_T6] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g2_state=0 & g7_state=0 & (T6_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1) & !((G7_achievable/(G2_achievable+G7_achievable+T6_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g7_state=0 & t6_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g7_state=0 & t6_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | g7_achieved | t6_achieved);
formula G1_achievable = G2_achievable + G7_achievable + T6_achievable - (G2_achievable * G7_achievable * T6_achievable);

// ID: G2
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T3, T4, T5
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t4_state=0 & t5_state=0 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_achieved & t3_state=0 & t5_state=0 -> true;
  [pursue_T5] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_achieved & t4_achieved & t3_state=0 & t4_state=0 -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 & t5_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & t5_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved & t4_achieved & t5_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1) * (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1);

// ID: G7
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T8, T9, T10
module G7
  g7_state : [0..1] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_T8] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t9_state=0 & t10_state=0 -> true;
  [pursue_T9] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_achieved & t8_state=0 & t10_state=0 -> true;
  [pursue_T10] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_achieved & t9_achieved & t8_state=0 & t9_state=0 -> true;

  [achieved_G7] g7_state=1 & g7_achieved & t8_state=0 & t9_state=0 & t10_state=0 -> (g7_state'=0);
  
  [skip_G7] !g7_achieved & g7_state=1 & t8_state=0 & t9_state=0 & t10_state=0 & G7_achievable*N <= decision_G7 -> (g7_state'=0);
endmodule

formula g7_achieved = (t8_achieved & t9_achieved & t10_achieved);
formula G7_achievable = g7_achieved ? 0 : (!t8_achieved ? T8_achievable : 1) * (!t9_achieved ? T9_achievable : 1) * (!t10_achieved ? T10_achievable : 1);

// ID: G11
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G12, G14
module G11
  g11_state : [0..1] init 0;

  [pursue_G11] !g11_achieved & g11_state=0 -> (g11_state'=1);
  [pursue_G12] !g11_achieved & g11_state=1 & G11_achievable*N > decision_G11 & g14_state=0 & G12_relative*N > _decision_G11 -> true;
  [pursue_G14] !g11_achieved & g11_state=1 & G11_achievable*N > decision_G11 & g12_state=0 & G14_relative*N > _decision_G11 & !(G12_relative*N > _decision_G11) -> true;

  [achieved_G11] g11_state=1 & g11_achieved & g12_state=0 & g14_state=0 -> (g11_state'=0);
  
  [skip_G11] !g11_achieved & g11_state=1 & g12_state=0 & g14_state=0 & G11_achievable*N <= decision_G11 -> (g11_state'=0);
endmodule

formula g11_achieved = (g12_achieved & g14_achieved);
formula G11_achievable = g11_achieved ? 0 : (!g12_achieved ? G12_achievable : 1) * (!g14_achieved ? G14_achievable : 1);
formula G12_relative = g12_achieved ? 0 : G12_achievable/(G12_achievable + (g14_achieved ? 0 : G14_achievable));
formula G14_relative = g14_achieved ? 0 : G14_achievable/(G14_achievable + (g12_achieved ? 0 : G12_achievable));

// ID: G12
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: T13
module G12
  g12_state : [0..1] init 0;

  [pursue_G12] !g12_achieved & g12_state=0 -> (g12_state'=1);
  [pursue_T13] !g12_achieved & g12_state=1 & T13_achievable*N > decision_T13 -> true;

  [achieved_G12] g12_state=1 & g12_achieved & t13_state=0 -> (g12_state'=0);
  
  [skip_G12] !g12_achieved & g12_state=1 & t13_state=0 & !(T13_achievable*N > decision_T13) -> (g12_state'=0);
endmodule

formula g12_achieved = (t13_achieved);
formula G12_achievable = g12_achieved ? 0 : (!t13_achieved ? T13_achievable : 1);

// ID: G14
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T15, T16, T17
module G14
  g14_state : [0..1] init 0;

  [pursue_G14] !g14_achieved & g14_state=0 -> (g14_state'=1);
  [pursue_T15] !g14_achieved & g14_state=1 & G14_achievable*N > decision_G14 & t16_state=0 & t17_state=0 & T15_relative*N > _decision_G14 -> true;
  [pursue_T16] !g14_achieved & g14_state=1 & G14_achievable*N > decision_G14 & t15_state=0 & t17_state=0 & T16_relative*N > _decision_G14 & !(T15_relative*N > _decision_G14) -> true;
  [pursue_T17] !g14_achieved & g14_state=1 & G14_achievable*N > decision_G14 & t15_state=0 & t16_state=0 & T17_relative*N > _decision_G14 & !(T15_relative*N > _decision_G14) & !(T16_relative*N > _decision_G14) -> true;

  [achieved_G14] g14_state=1 & g14_achieved & t15_state=0 & t16_state=0 & t17_state=0 -> (g14_state'=0);
  
  [skip_G14] !g14_achieved & g14_state=1 & t15_state=0 & t16_state=0 & t17_state=0 & G14_achievable*N <= decision_G14 -> (g14_state'=0);
endmodule

formula g14_achieved = (t15_achieved & t16_achieved & t17_achieved);
formula G14_achievable = g14_achieved ? 0 : (!t15_achieved ? T15_achievable : 1) * (!t16_achieved ? T16_achievable : 1) * (!t17_achieved ? T17_achievable : 1);
formula T15_relative = t15_achieved ? 0 : T15_achievable/(T15_achievable + (t16_achieved ? 0 : T16_achievable) + (t17_achieved ? 0 : T17_achievable));
formula T16_relative = t16_achieved ? 0 : T16_achievable/(T16_achievable + (t15_achieved ? 0 : T15_achievable) + (t17_achieved ? 0 : T17_achievable));
formula T17_relative = t17_achieved ? 0 : T17_achievable/(T17_achievable + (t15_achieved ? 0 : T15_achievable) + (t16_achieved ? 0 : T16_achievable));


const double T10_achievable = 0.8;
const double T13_achievable = 0.8;
const double T15_achievable = 0.8;
const double T16_achievable = 0.8;
const double T17_achievable = 0.8;
const double T3_achievable = 0.8;
const double T4_achievable = 0.8;
