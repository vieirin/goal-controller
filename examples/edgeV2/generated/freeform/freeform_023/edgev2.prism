formula g35_achieved = (g36_achieved | t42_achieved);
formula G35_achievable = g35_chosen=1 ? G36_achievable : g35_chosen=2 ? T42_achievable : (G36_achievable + T42_achievable - (G36_achievable * T42_achievable));

// ID: G0
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G1, G35
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G35] !g0_achieved & g0_state=1 & G35_achievable*N > decision_G35 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g35_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g35_state=0 & !(G1_achievable*N > decision_G1 | G35_achievable*N > decision_G35) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g35_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g35_achieved ? G35_achievable : 1);

module System
  
endmodule
