  [skip_G5] !g5_achieved & g5_state=1 & g6_state=0 & g10_state=0 & g15_state=0 & !(G6_achievable*N > decision_G6 | G10_achievable*N > decision_G10 | G15_achievable*N > decision_G15) -> (g5_state'=0);
