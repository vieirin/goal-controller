// ID: G2
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T3, T4
module G2
  g2_state : [0..1] init 0;
  t3_failed : [0..5] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed<5 & T3_achievable*N > decision_T3 -> (t3_failed'=t3_failed+1);
  [pursue_T3] !g2_achieved & g2_state=1 & t3_failed=5 & G2_achievable*N > decision_G2 & t4_state=0 & (T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & t3_failed=5 & G2_achievable*N > decision_G2 & t3_state=0 & (T4_achievable/(T3_achievable+T4_achievable))*N > _decision_G2 & !((T3_achievable/(T3_achievable+T4_achievable))*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t3_failed<5 & T3_achievable*N <= decision_T3 -> (g2_state'=0);
  [skip_G2] t3_failed=5 & !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved | (t3_failed=5 & t4_achieved));
formula G2_achievable = T3_achievable + T4_achievable - (T3_achievable * T4_achievable);

