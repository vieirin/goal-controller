  g10_state : [0..1] init 0;

  [pursue_G10] !g10_achieved & g10_state=0 -> (g10_state'=1);
  [pursue_T11] !g10_achieved & g10_state=1 & G10_achievable*N > decision_G10 & t12_state=0 & t13_state=0 & t14_state=0 -> true;
  [pursue_T12] !g10_achieved & g10_state=1 & G10_achievable*N > decision_G10 & t11_achieved & t11_state=0 & t13_state=0 & t14_state=0 -> true;
  [pursue_T13] !g10_achieved & g10_state=1 & G10_achievable*N > decision_G10 & t11_achieved & t12_achieved & t11_state=0 & t12_state=0 & t14_state=0 -> true;
