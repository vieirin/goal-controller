// Name: goal
// Type: degradation
// Relation to children: or
// Children: T7, T8, T9
module G6
  g6_state : [0..1] init 0;
  t7_failed : [0..3] init 0;

  [pursue_G6] !g6_achieved & g6_state=0 -> (g6_state'=1);
  [pursue_T7] !g6_achieved & g6_state=1 & t7_failed<3 & T7_achievable*N > decision_T7 -> (t7_failed'=t7_failed+1);
  [pursue_T7] !g6_achieved & g6_state=1 & t7_failed=3 & G6_achievable*N > decision_G6 & t8_state=0 & t9_state=0 & (T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 -> true;
  [pursue_T8] !g6_achieved & g6_state=1 & t7_failed=3 & G6_achievable*N > decision_G6 & t7_state=0 & t9_state=0 & (T8_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 & !((T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) -> true;
  [pursue_T9] !g6_achieved & g6_state=1 & t7_failed=3 & G6_achievable*N > decision_G6 & t7_state=0 & t8_state=0 & (T9_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6 & !((T7_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) & !((T8_achievable/(T7_achievable+T8_achievable+T9_achievable))*N > _decision_G6) -> true;

  [achieved_G6] g6_state=1 & g6_achieved & t7_state=0 & t8_state=0 & t9_state=0 -> (g6_state'=0);
  
  [skip_G6] !g6_achieved & g6_state=1 & t7_state=0 & t7_failed<3 & T7_achievable*N <= decision_T7 -> (g6_state'=0);
  [skip_G6] t7_failed=3 & !g6_achieved & g6_state=1 & t7_state=0 & t8_state=0 & t9_state=0 & G6_achievable*N <= decision_G6 -> (g6_state'=0);
endmodule

