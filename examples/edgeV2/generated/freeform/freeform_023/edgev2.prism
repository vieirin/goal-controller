// ID: G15
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T16, T17, T18, T19
module G15
  g15_state : [0..1] init 0;

  [pursue_G15] !g15_achieved & g15_state=0 -> (g15_state'=1);
  [pursue_T16] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t17_state=0 & t18_state=0 & t19_state=0 & T16_relative*N > _decision_G15 -> true;
  [pursue_T17] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & t18_state=0 & t19_state=0 & T17_relative*N > _decision_G15 & !(T16_relative*N > _decision_G15) -> true;
  [pursue_T18] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & t17_state=0 & t19_state=0 & T18_relative*N > _decision_G15 & !(T16_relative*N > _decision_G15) & !(T17_relative*N > _decision_G15) -> true;
  [pursue_T19] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & t17_state=0 & t18_state=0 & T19_relative*N > _decision_G15 & !(T16_relative*N > _decision_G15) & !(T17_relative*N > _decision_G15) & !(T18_relative*N > _decision_G15) -> true;

  [achieved_G15] g15_state=1 & g15_achieved & t16_state=0 & t17_state=0 & t18_state=0 & t19_state=0 -> (g15_state'=0);
  
  [skip_G15] !g15_achieved & g15_state=1 & t16_state=0 & t17_state=0 & t18_state=0 & t19_state=0 & G15_achievable*N <= decision_G15 -> (g15_state'=0);
endmodule

formula g15_achieved = (t16_achieved & t17_achieved & t18_achieved & t19_achieved);
formula G15_achievable = g15_achieved ? 0 : (!t16_achieved ? T16_achievable : 1) * (!t17_achieved ? T17_achievable : 1) * (!t18_achieved ? T18_achievable : 1) * (!t19_achieved ? T19_achievable : 1);
formula T16_relative = t16_achieved ? 0 : T16_achievable/(T16_achievable + (t17_achieved ? 0 : T17_achievable) + (t18_achieved ? 0 : T18_achievable) + (t19_achieved ? 0 : T19_achievable));
formula T17_relative = t17_achieved ? 0 : T17_achievable/(T17_achievable + (t16_achieved ? 0 : T16_achievable) + (t18_achieved ? 0 : T18_achievable) + (t19_achieved ? 0 : T19_achievable));
formula T18_relative = t18_achieved ? 0 : T18_achievable/(T18_achievable + (t16_achieved ? 0 : T16_achievable) + (t17_achieved ? 0 : T17_achievable) + (t19_achieved ? 0 : T19_achievable));
formula T19_relative = t19_achieved ? 0 : T19_achievable/(T19_achievable + (t16_achieved ? 0 : T16_achievable) + (t17_achieved ? 0 : T17_achievable) + (t18_achieved ? 0 : T18_achievable));

