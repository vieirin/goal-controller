const int N=10;
const int decision_GG0 = 2;
const int decision_GG0_ = 4;
module GG0 //fixed 
gG0: [0..1] init 0;
[pursue_GG0] !gG0_achieved & gG0 = 0 -> (gG0'=1);
[pursue_GG1] !gG0_achieved & gG0=1 & GG0_achievable*N>decision_GG0 & gG8=0-> true; 
[pursue_GG8] !gG0_achieved & gG0=1 & GG0_achievable*N>decision_GG0 & gG1_achieved & gG1=0-> true; 
