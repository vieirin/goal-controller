dtmc

const int N = 10;
const int decision_G0;
const int decision_G1;
const int decision_G13;
const int decision_G3;
const int decision_G8;
const int _decision_G8;
const int decision_G9;
const int _decision_G9;
const int decision_T10;
const int decision_T11;
const int decision_T12;
const int decision_T14;
const int decision_T15;
const int decision_T16;
const int decision_T2;
const int decision_T4;
const int decision_T5;
const int decision_T6;
const int decision_T7;


// ID: G0
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G1, G8
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g8_state=0 -> true;
  [pursue_G8] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_achieved & g1_state=0 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g8_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g8_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g8_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g8_achieved ? G8_achievable : 1);

// ID: G1
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T2, G3, T7
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_T2] !g1_achieved & g1_state=1 & T2_achievable*N > decision_T2 -> true;
  [pursue_G3] !g1_achieved & g1_state=1 & G3_achievable*N > decision_G3 -> true;
  [pursue_T7] !g1_achieved & g1_state=1 & T7_achievable*N > decision_T7 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & t2_state=0 & g3_state=0 & t7_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & t2_state=0 & g3_state=0 & t7_state=0 & !(T2_achievable*N > decision_T2 | G3_achievable*N > decision_G3 | T7_achievable*N > decision_T7) -> (g1_state'=0);
endmodule

formula g1_achieved = (t2_achieved & g3_achieved & t7_achieved);
formula G1_achievable = g1_achieved ? 0 : (!t2_achieved ? T2_achievable : 1) * (!g3_achieved ? G3_achievable : 1) * (!t7_achieved ? T7_achievable : 1);

// ID: G3
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T4, T5, T6
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & T4_achievable*N > decision_T4 -> true;
  [pursue_T5] !g3_achieved & g3_state=1 & T5_achievable*N > decision_T5 -> true;
  [pursue_T6] !g3_achieved & g3_state=1 & T6_achievable*N > decision_T6 -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 & t5_state=0 & t6_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & t5_state=0 & t6_state=0 & !(T4_achievable*N > decision_T4 | T5_achievable*N > decision_T5 | T6_achievable*N > decision_T6) -> (g3_state'=0);
endmodule

formula g3_achieved = (t4_achieved & t5_achieved & t6_achieved);
formula G3_achievable = g3_achieved ? 0 : (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1) * (!t6_achieved ? T6_achievable : 1);

// ID: G8
// Name: goal
// Type: choice
// Relation to children: or
// Children: G9, G13
module G8
  g8_state : [0..1] init 0;
  g8_chosen : [0..2] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_G9] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & g13_state=0 & (G9_achievable/(G9_achievable+G13_achievable))*N > _decision_G8 -> (g8_chosen'=1);
  [pursue_G9] !g8_achieved & g8_state=1 & g8_chosen=1 & G9_achievable*N > decision_G9 -> true;
  [pursue_G13] !g8_achieved & g8_state=1 & g8_chosen=0 & G8_achievable*N > decision_G8 & g9_state=0 & (G13_achievable/(G9_achievable+G13_achievable))*N > _decision_G8 & !((G9_achievable/(G9_achievable+G13_achievable))*N > _decision_G8) -> (g8_chosen'=2);
  [pursue_G13] !g8_achieved & g8_state=1 & g8_chosen=2 & G13_achievable*N > decision_G13 -> true;

  [achieved_G8] g8_state=1 & g8_achieved & g9_state=0 & g13_state=0 -> (g8_state'=0);
  
  [skip_G8] g8_chosen=0 & !g8_achieved & g8_state=1 & g9_state=0 & g13_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & g9_state=0 & g8_chosen=1 & G9_achievable*N <= decision_G9 -> (g8_state'=0);
  [skip_G8] !g8_achieved & g8_state=1 & g13_state=0 & g8_chosen=2 & G13_achievable*N <= decision_G13 -> (g8_state'=0);
endmodule

formula g8_achieved = (g9_achieved | g13_achieved);
formula G8_achievable = g8_chosen=1 ? G9_achievable : g8_chosen=2 ? G13_achievable : (G9_achievable + G13_achievable - (G9_achievable * G13_achievable));

// ID: G9
// Name: goal
// Type: choice
// Relation to children: or
// Children: T10, T11, T12
module G9
  g9_state : [0..1] init 0;
  g9_chosen : [0..3] init 0;

  [pursue_G9] !g9_achieved & g9_state=0 -> (g9_state'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & g9_chosen=0 & G9_achievable*N > decision_G9 & t11_state=0 & t12_state=0 & (T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 -> (g9_chosen'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & g9_chosen=1 & T10_achievable*N > decision_T10 -> true;
  [pursue_T11] !g9_achieved & g9_state=1 & g9_chosen=0 & G9_achievable*N > decision_G9 & t10_state=0 & t12_state=0 & (T11_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) -> (g9_chosen'=2);
  [pursue_T11] !g9_achieved & g9_state=1 & g9_chosen=2 & T11_achievable*N > decision_T11 -> true;
  [pursue_T12] !g9_achieved & g9_state=1 & g9_chosen=0 & G9_achievable*N > decision_G9 & t10_state=0 & t11_state=0 & (T12_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) & !((T11_achievable/(T10_achievable+T11_achievable+T12_achievable))*N > _decision_G9) -> (g9_chosen'=3);
  [pursue_T12] !g9_achieved & g9_state=1 & g9_chosen=3 & T12_achievable*N > decision_T12 -> true;

  [achieved_G9] g9_state=1 & g9_achieved & t10_state=0 & t11_state=0 & t12_state=0 -> (g9_state'=0);
  
  [skip_G9] g9_chosen=0 & !g9_achieved & g9_state=1 & t10_state=0 & t11_state=0 & t12_state=0 & G9_achievable*N <= decision_G9 -> (g9_state'=0);
  [skip_G9] !g9_achieved & g9_state=1 & t10_state=0 & g9_chosen=1 & T10_achievable*N <= decision_T10 -> (g9_state'=0);
  [skip_G9] !g9_achieved & g9_state=1 & t11_state=0 & g9_chosen=2 & T11_achievable*N <= decision_T11 -> (g9_state'=0);
  [skip_G9] !g9_achieved & g9_state=1 & t12_state=0 & g9_chosen=3 & T12_achievable*N <= decision_T12 -> (g9_state'=0);
endmodule

formula g9_achieved = (t10_achieved | t11_achieved | t12_achieved);
formula G9_achievable = g9_chosen=1 ? T10_achievable : g9_chosen=2 ? T11_achievable : g9_chosen=3 ? T12_achievable : (T10_achievable + T11_achievable + T12_achievable - (T10_achievable * T11_achievable * T12_achievable));

// ID: G13
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T14, T15, T16
module G13
  g13_state : [0..1] init 0;

  [pursue_G13] !g13_achieved & g13_state=0 -> (g13_state'=1);
  [pursue_T14] !g13_achieved & g13_state=1 & T14_achievable*N > decision_T14 -> true;
  [pursue_T15] !g13_achieved & g13_state=1 & T15_achievable*N > decision_T15 -> true;
  [pursue_T16] !g13_achieved & g13_state=1 & T16_achievable*N > decision_T16 -> true;

  [achieved_G13] g13_state=1 & g13_achieved & t14_state=0 & t15_state=0 & t16_state=0 -> (g13_state'=0);
  
  [skip_G13] !g13_achieved & g13_state=1 & t14_state=0 & t15_state=0 & t16_state=0 & !(T14_achievable*N > decision_T14 | T15_achievable*N > decision_T15 | T16_achievable*N > decision_T16) -> (g13_state'=0);
endmodule

formula g13_achieved = (t14_achieved & t15_achieved & t16_achieved);
formula G13_achievable = g13_achieved ? 0 : (!t14_achieved ? T14_achievable : 1) * (!t15_achieved ? T15_achievable : 1) * (!t16_achieved ? T16_achievable : 1);


const double T10_achievable = 0.8;
const double T11_achievable = 0.8;
const double T12_achievable = 0.8;
const double T14_achievable = 0.8;
const double T15_achievable = 0.8;
const double T16_achievable = 0.8;
const double T2_achievable = 0.8;
const double T4_achievable = 0.8;
const double T5_achievable = 0.8;
const double T6_achievable = 0.8;
const double T7_achievable = 0.8;

module ChangeManager
  t10_state: [0..1] init 0;
  t10_achieved_: [0..1] init 0;
  t11_state: [0..1] init 0;
  t11_achieved_: [0..1] init 0;
  t12_state: [0..1] init 0;
  t12_achieved_: [0..1] init 0;
  t14_state: [0..1] init 0;
  t14_achieved_: [0..1] init 0;
  t15_state: [0..1] init 0;
  t15_achieved_: [0..1] init 0;
  t16_state: [0..1] init 0;
  t16_achieved_: [0..1] init 0;
  t2_state: [0..1] init 0;
  t2_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t5_state: [0..1] init 0;
  t5_achieved_: [0..1] init 0;
  t6_state: [0..1] init 0;
  t6_achieved_: [0..1] init 0;
  t7_state: [0..1] init 0;
  t7_achieved_: [0..1] init 0;
  
  // Task T10: task
  [pursue_T10] t10_state=0 & t10_achieved_=0 -> (t10_state'=1);
  [try_T10] t10_state=1 & t10_achieved_=0 -> T10_achievable: (t10_achieved_'=1) + 1-T10_achievable: (t10_state'=0);
  [achieved_T10] t10_state=1 & t10_achieved_=1 -> (t10_state'=0);
  

  // Task T11: task
  [pursue_T11] t11_state=0 & t11_achieved_=0 -> (t11_state'=1);
  [try_T11] t11_state=1 & t11_achieved_=0 -> T11_achievable: (t11_achieved_'=1) + 1-T11_achievable: (t11_state'=0);
  [achieved_T11] t11_state=1 & t11_achieved_=1 -> (t11_state'=0);
  

  // Task T12: task
  [pursue_T12] t12_state=0 & t12_achieved_=0 -> (t12_state'=1);
  [try_T12] t12_state=1 & t12_achieved_=0 -> T12_achievable: (t12_achieved_'=1) + 1-T12_achievable: (t12_state'=0);
  [achieved_T12] t12_state=1 & t12_achieved_=1 -> (t12_state'=0);
  

  // Task T14: task
  [pursue_T14] t14_state=0 & t14_achieved_=0 -> (t14_state'=1);
  [try_T14] t14_state=1 & t14_achieved_=0 -> T14_achievable: (t14_achieved_'=1) + 1-T14_achievable: (t14_state'=0);
  [achieved_T14] t14_state=1 & t14_achieved_=1 -> (t14_state'=0);
  

  // Task T15: task
  [pursue_T15] t15_state=0 & t15_achieved_=0 -> (t15_state'=1);
  [try_T15] t15_state=1 & t15_achieved_=0 -> T15_achievable: (t15_achieved_'=1) + 1-T15_achievable: (t15_state'=0);
  [achieved_T15] t15_state=1 & t15_achieved_=1 -> (t15_state'=0);
  

  // Task T16: task
  [pursue_T16] t16_state=0 & t16_achieved_=0 -> (t16_state'=1);
  [try_T16] t16_state=1 & t16_achieved_=0 -> T16_achievable: (t16_achieved_'=1) + 1-T16_achievable: (t16_state'=0);
  [achieved_T16] t16_state=1 & t16_achieved_=1 -> (t16_state'=0);
  

  // Task T2: task
  [pursue_T2] t2_state=0 & t2_achieved_=0 -> (t2_state'=1);
  [try_T2] t2_state=1 & t2_achieved_=0 -> T2_achievable: (t2_achieved_'=1) + 1-T2_achievable: (t2_state'=0);
  [achieved_T2] t2_state=1 & t2_achieved_=1 -> (t2_state'=0);
  

  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
  

  // Task T5: task
  [pursue_T5] t5_state=0 & t5_achieved_=0 -> (t5_state'=1);
  [try_T5] t5_state=1 & t5_achieved_=0 -> T5_achievable: (t5_achieved_'=1) + 1-T5_achievable: (t5_state'=0);
  [achieved_T5] t5_state=1 & t5_achieved_=1 -> (t5_state'=0);
  

  // Task T6: task
  [pursue_T6] t6_state=0 & t6_achieved_=0 -> (t6_state'=1);
  [try_T6] t6_state=1 & t6_achieved_=0 -> T6_achievable: (t6_achieved_'=1) + 1-T6_achievable: (t6_state'=0);
  [achieved_T6] t6_state=1 & t6_achieved_=1 -> (t6_state'=0);
  

  // Task T7: task
  [pursue_T7] t7_state=0 & t7_achieved_=0 -> (t7_state'=1);
  [try_T7] t7_state=1 & t7_achieved_=0 -> T7_achievable: (t7_achieved_'=1) + 1-T7_achievable: (t7_state'=0);
  [achieved_T7] t7_state=1 & t7_achieved_=1 -> (t7_state'=0);
  
endmodule

formula t10_achieved = (t10_achieved_=1);
formula t11_achieved = (t11_achieved_=1);
formula t12_achieved = (t12_achieved_=1);
formula t14_achieved = (t14_achieved_=1);
formula t15_achieved = (t15_achieved_=1);
