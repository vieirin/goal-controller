P=? [ G 0 + g1_state + g8_state <= 1 ] =1
P=? [G g1_state=1 => (true )] = 1
P=? [G g8_state=1 => (true & g1_achieved )] = 1

P=? [ G 0 + g9_state + g13_state <= 1 ] =1
