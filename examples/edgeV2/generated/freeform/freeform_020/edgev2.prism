  [achieved_T6] t6_state=1 & t6_achieved_=1 -> (t6_state'=0);
endmodule

// ID: G2
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G3, T6
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_G3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t6_state=0 & G3_relative*N > _decision_G2 -> true;
  [pursue_T6] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & g3_state=0 & T6_relative*N > _decision_G2 & !(G3_relative*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & g3_state=0 & t6_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & g3_state=0 & t6_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (g3_achieved & t6_achieved);
formula G2_achievable = g2_achieved ? 0 : (!g3_achieved ? G3_achievable : 1) * (!t6_achieved ? T6_achievable : 1);
formula G3_relative = g3_achieved ? 0 : G3_achievable/(G3_achievable + (t6_achieved ? 0 : T6_achievable));
formula T6_relative = t6_achieved ? 0 : T6_achievable/(T6_achievable + (g3_achieved ? 0 : G3_achievable));

const double T8_achievable = 0.8;
formula t8_achieved = (t8_achieved_=1);
module T8
  t8_state: [0..1] init 0;
