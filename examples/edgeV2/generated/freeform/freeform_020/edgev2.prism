// ID: G9
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T10, T11
module G9
  g9_state : [0..1] init 0;

  [pursue_G9] !g9_achieved & g9_state=0 -> (g9_state'=1);
  [pursue_T10] !g9_achieved & g9_state=1 & G9_achievable*N > decision_G9 & t11_state=0 & (T10_achievable/(T10_achievable+T11_achievable))*N > _decision_G9 -> true;
  [pursue_T11] !g9_achieved & g9_state=1 & G9_achievable*N > decision_G9 & t10_state=0 & (T11_achievable/(T10_achievable+T11_achievable))*N > _decision_G9 & !((T10_achievable/(T10_achievable+T11_achievable))*N > _decision_G9) -> true;

  [achieved_G9] g9_state=1 & g9_achieved & t10_state=0 & t11_state=0 -> (g9_state'=0);
  
  [skip_G9] !g9_achieved & g9_state=1 & t10_state=0 & t11_state=0 & G9_achievable*N <= decision_G9 -> (g9_state'=0);
endmodule

formula g9_achieved = (t10_achieved | t11_achieved);
formula G9_achievable = T10_achievable + T11_achievable - (T10_achievable * T11_achievable);

// ID: G7
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T8, G9
module G7
  g7_state : [0..1] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_T8] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & g9_state=0 & T8_relative*N > _decision_G7 -> true;
  [pursue_G9] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_state=0 & G9_relative*N > _decision_G7 & !(T8_relative*N > _decision_G7) -> true;

  [achieved_G7] g7_state=1 & g7_achieved & t8_state=0 & g9_state=0 -> (g7_state'=0);
  
  [skip_G7] !g7_achieved & g7_state=1 & t8_state=0 & g9_state=0 & G7_achievable*N <= decision_G7 -> (g7_state'=0);
endmodule

formula g7_achieved = (t8_achieved & g9_achieved);
formula G7_achievable = g7_achieved ? 0 : (!t8_achieved ? T8_achievable : 1) * (!g9_achieved ? G9_achievable : 1);
formula T8_relative = t8_achieved ? 0 : T8_achievable/(T8_achievable + (g9_achieved ? 0 : G9_achievable));
formula G9_relative = g9_achieved ? 0 : G9_achievable/(G9_achievable + (t8_achieved ? 0 : T8_achievable));

// ID: G1
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G2, G7
module G1
  g1_state : [0..1] init 0;
  g2_failed : [0..5] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed<5 & G2_achievable*N > decision_G2 -> (g2_failed'=g2_failed+1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & g7_state=0 & (G2_achievable/(G2_achievable+G7_achievable))*N > _decision_G1 -> true;
  [pursue_G7] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & g2_state=0 & (G7_achievable/(G2_achievable+G7_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g7_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g2_failed<5 & G2_achievable*N <= decision_G2 -> (g1_state'=0);
  [skip_G1] g2_failed=5 & !g1_achieved & g1_state=1 & g2_state=0 & g7_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | (g2_failed=5 & g7_achieved));
formula G1_achievable = G2_achievable + G7_achievable - (G2_achievable * G7_achievable);

