// ID: G16
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T17, T18, T19
module G16
  g16_state : [0..1] init 0;
  t17_failed : [0..2] init 0;

  [pursue_G16] !g16_achieved & g16_state=0 -> (g16_state'=1);
  [pursue_T17] !g16_achieved & g16_state=1 & t17_failed<2 & T17_achievable*N > decision_T17 -> (t17_failed'=t17_failed+1);
  [pursue_T17] !g16_achieved & g16_state=1 & t17_failed=2 & G16_achievable*N > decision_G16 & t18_state=0 & t19_state=0 & (T17_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16 -> true;
  [pursue_T18] !g16_achieved & g16_state=1 & t17_failed=2 & G16_achievable*N > decision_G16 & t17_state=0 & t19_state=0 & (T18_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16 & !((T17_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16) -> true;
  [pursue_T19] !g16_achieved & g16_state=1 & t17_failed=2 & G16_achievable*N > decision_G16 & t17_state=0 & t18_state=0 & (T19_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16 & !((T17_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16) & !((T18_achievable/(T17_achievable+T18_achievable+T19_achievable))*N > _decision_G16) -> true;

  [achieved_G16] g16_state=1 & g16_achieved & t17_state=0 & t18_state=0 & t19_state=0 -> (g16_state'=0);
  
  [skip_G16] !g16_achieved & g16_state=1 & t17_state=0 & t17_failed<2 & T17_achievable*N <= decision_T17 -> (g16_state'=0);
  [skip_G16] t17_failed=2 & !g16_achieved & g16_state=1 & t17_state=0 & t18_state=0 & t19_state=0 & G16_achievable*N <= decision_G16 -> (g16_state'=0);
endmodule

formula g16_achieved = (t17_achieved | (t17_failed=2 & t18_achieved) | (t17_failed=2 & t19_achieved));
formula G16_achievable = T17_achievable + T18_achievable + T19_achievable - (T17_achievable * T18_achievable * T19_achievable);

// ID: G12
// Name: goal
// Type: alternative
// Relation to children: or
