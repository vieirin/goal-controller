module G12
  g12_state : [0..1] init 0;

  [pursue_G12] !g12_achieved & g12_state=0 -> (g12_state'=1);
  [pursue_T13] !g12_achieved & g12_state=1 & G12_achievable*N > decision_G12 & g14_state=0 & g16_state=0 & (T13_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12 -> true;
  [pursue_G14] !g12_achieved & g12_state=1 & G12_achievable*N > decision_G12 & t13_state=0 & g16_state=0 & (G14_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12 & !((T13_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12) -> true;
  [pursue_G16] !g12_achieved & g12_state=1 & G12_achievable*N > decision_G12 & t13_state=0 & g14_state=0 & (G16_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12 & !((T13_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12) & !((G14_achievable/(T13_achievable+G14_achievable+G16_achievable))*N > _decision_G12) -> true;

  [achieved_G12] g12_state=1 & g12_achieved & t13_state=0 & g14_state=0 & g16_state=0 -> (g12_state'=0);
  
  [skip_G12] !g12_achieved & g12_state=1 & t13_state=0 & g14_state=0 & g16_state=0 & G12_achievable*N <= decision_G12 -> (g12_state'=0);
endmodule

formula g12_achieved = (t13_achieved | g14_achieved | g16_achieved);
formula G12_achievable = T13_achievable + G14_achievable + G16_achievable - (T13_achievable * G14_achievable * G16_achievable);

// ID: G0
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G1, G12
module G0
  g0_state : [0..1] init 0;
  g1_failed : [0..2] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g1_failed<2 & G1_achievable*N > decision_G1 -> (g1_failed'=g1_failed+1);
  [pursue_G1] !g0_achieved & g0_state=1 & g1_failed=2 & G0_achievable*N > decision_G0 & g12_state=0 & (G1_achievable/(G1_achievable+G12_achievable))*N > _decision_G0 -> true;
  [pursue_G12] !g0_achieved & g0_state=1 & g1_failed=2 & G0_achievable*N > decision_G0 & g1_state=0 & (G12_achievable/(G1_achievable+G12_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G12_achievable))*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g12_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g1_failed<2 & G1_achievable*N <= decision_G1 -> (g0_state'=0);
  [skip_G0] g1_failed=2 & !g0_achieved & g0_state=1 & g1_state=0 & g12_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | (g1_failed=2 & g12_achieved));
formula G0_achievable = G1_achievable + G12_achievable - (G1_achievable * G12_achievable);

