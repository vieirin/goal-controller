P>=1 [ G 0 + g1_state + g4_state <= 1 ];
P>=1 [ G g4_state=1 => g1_failed=3 ];
P>=1 [ G g0_achieved => (g1_achieved | (g1_failed=3 & g4_achieved)) ];
P>=1 [ G 0 + t2_state + t3_state <= 1 ];
P>=1 [ G t3_state=1 => t2_failed=3 ];
P>=1 [ G g1_achieved => (t2_achieved | (t2_failed=3 & t3_achieved)) ];
P>=1 [ G g1_state + g4_state <= 1 ];
P>=1 [ G g4_state=1 => g1_failed=3 ];
P>=1 [ G t2_state + t3_state <= 1 ];
P>=1 [ G t3_state=1 => t2_failed=3 ];
P=? [ F g0_achieved ]
