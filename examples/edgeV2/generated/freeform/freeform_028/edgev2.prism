dtmc

const int N = 10;
const int decision_G0;
const int decision_G1;
const int _decision_G1;
const int decision_G2;
const int _decision_G2;
const int decision_G7;
const int _decision_G7;
const int decision_T3;
const int decision_T4;
const int decision_T5;
const int decision_T6;
const int decision_T8;
const int decision_T9;

const double T3_achievable = 0.8;
formula t3_achieved = (t3_achieved_=1);
module T3
  t3_state: [0..1] init 0;
  t3_achieved_: [0..1] init 0;
  // Task T3: task
  [pursue_T3] t3_state=0 & t3_achieved_=0 -> (t3_state'=1);
  [try_T3] t3_state=1 & t3_achieved_=0 -> T3_achievable: (t3_achieved_'=1) + 1-T3_achievable: (t3_state'=0);
  [achieved_T3] t3_state=1 & t3_achieved_=1 -> (t3_state'=0);
endmodule

const double T4_achievable = 0.8;
formula t4_achieved = (t4_achieved_=1);
module T4
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
endmodule

const double T5_achievable = 0.8;
formula t5_achieved = (t5_achieved_=1);
module T5
  t5_state: [0..1] init 0;
  t5_achieved_: [0..1] init 0;
  // Task T5: task
  [pursue_T5] t5_state=0 & t5_achieved_=0 -> (t5_state'=1);
  [try_T5] t5_state=1 & t5_achieved_=0 -> T5_achievable: (t5_achieved_'=1) + 1-T5_achievable: (t5_state'=0);
  [achieved_T5] t5_state=1 & t5_achieved_=1 -> (t5_state'=0);
endmodule

// ID: G2
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T3, T4, T5
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_T3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t4_state=0 & t5_state=0 & T3_relative*N > _decision_G2 -> true;
  [pursue_T4] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_state=0 & t5_state=0 & T4_relative*N > _decision_G2 & !(T3_relative*N > _decision_G2) -> true;
  [pursue_T5] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & t3_state=0 & t4_state=0 & T5_relative*N > _decision_G2 & !(T3_relative*N > _decision_G2) & !(T4_relative*N > _decision_G2) -> true;

  [achieved_G2] g2_state=1 & g2_achieved & t3_state=0 & t4_state=0 & t5_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & t3_state=0 & t4_state=0 & t5_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (t3_achieved & t4_achieved & t5_achieved);
formula G2_achievable = g2_achieved ? 0 : (!t3_achieved ? T3_achievable : 1) * (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1);
formula T3_relative = t3_achieved ? 0 : T3_achievable/(T3_achievable + (t4_achieved ? 0 : T4_achievable) + (t5_achieved ? 0 : T5_achievable));
formula T4_relative = t4_achieved ? 0 : T4_achievable/(T4_achievable + (t3_achieved ? 0 : T3_achievable) + (t5_achieved ? 0 : T5_achievable));
formula T5_relative = t5_achieved ? 0 : T5_achievable/(T5_achievable + (t3_achieved ? 0 : T3_achievable) + (t4_achieved ? 0 : T4_achievable));

const double T6_achievable = 0.8;
formula t6_achieved = (t6_achieved_=1);
module T6
  t6_state: [0..1] init 0;
  t6_achieved_: [0..1] init 0;
  // Task T6: task
  [pursue_T6] t6_state=0 & t6_achieved_=0 -> (t6_state'=1);
  [try_T6] t6_state=1 & t6_achieved_=0 -> T6_achievable: (t6_achieved_'=1) + 1-T6_achievable: (t6_state'=0);
  [achieved_T6] t6_state=1 & t6_achieved_=1 -> (t6_state'=0);
endmodule

const double T8_achievable = 0.8;
formula t8_achieved = (t8_achieved_=1);
module T8
  t8_state: [0..1] init 0;
  t8_achieved_: [0..1] init 0;
  // Task T8: task
  [pursue_T8] t8_state=0 & t8_achieved_=0 -> (t8_state'=1);
  [try_T8] t8_state=1 & t8_achieved_=0 -> T8_achievable: (t8_achieved_'=1) + 1-T8_achievable: (t8_state'=0);
  [achieved_T8] t8_state=1 & t8_achieved_=1 -> (t8_state'=0);
endmodule

const double T9_achievable = 0.8;
formula t9_achieved = (t9_achieved_=1);
module T9
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  // Task T9: task
  [pursue_T9] t9_state=0 & t9_achieved_=0 -> (t9_state'=1);
  [try_T9] t9_state=1 & t9_achieved_=0 -> T9_achievable: (t9_achieved_'=1) + 1-T9_achievable: (t9_state'=0);
  [achieved_T9] t9_state=1 & t9_achieved_=1 -> (t9_state'=0);
endmodule

// ID: G7
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: T8, T9
module G7
  g7_state : [0..1] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_T8] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t9_state=0 & T8_relative*N > _decision_G7 -> true;
  [pursue_T9] !g7_achieved & g7_state=1 & G7_achievable*N > decision_G7 & t8_state=0 & T9_relative*N > _decision_G7 & !(T8_relative*N > _decision_G7) -> true;

  [achieved_G7] g7_state=1 & g7_achieved & t8_state=0 & t9_state=0 -> (g7_state'=0);
  
  [skip_G7] !g7_achieved & g7_state=1 & t8_state=0 & t9_state=0 & G7_achievable*N <= decision_G7 -> (g7_state'=0);
endmodule

formula g7_achieved = (t8_achieved & t9_achieved);
formula G7_achievable = g7_achieved ? 0 : (!t8_achieved ? T8_achievable : 1) * (!t9_achieved ? T9_achievable : 1);
formula T8_relative = t8_achieved ? 0 : T8_achievable/(T8_achievable + (t9_achieved ? 0 : T9_achievable));
formula T9_relative = t9_achieved ? 0 : T9_achievable/(T9_achievable + (t8_achieved ? 0 : T8_achievable));

// ID: G1
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G2, T6, G7
module G1
  g1_state : [0..1] init 0;
  g2_failed : [0..3] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed<3 & G2_achievable*N > decision_G2 -> (g2_failed'=g2_failed+1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed=3 & G1_achievable*N > decision_G1 & t6_state=0 & g7_state=0 & (G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 -> true;
  [pursue_T6] !g1_achieved & g1_state=1 & g2_failed=3 & G1_achievable*N > decision_G1 & g2_state=0 & g7_state=0 & (T6_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) -> true;
  [pursue_G7] !g1_achieved & g1_state=1 & g2_failed=3 & G1_achievable*N > decision_G1 & g2_state=0 & t6_state=0 & (G7_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) & !((T6_achievable/(G2_achievable+T6_achievable+G7_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & t6_state=0 & g7_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g2_failed<3 & G2_achievable*N <= decision_G2 -> (g1_state'=0);
  [skip_G1] g2_failed=3 & !g1_achieved & g1_state=1 & g2_state=0 & t6_state=0 & g7_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | (g2_failed=3 & t6_achieved) | (g2_failed=3 & g7_achieved));
formula G1_achievable = G2_achievable + T6_achievable + G7_achievable - (G2_achievable * T6_achievable * G7_achievable);

// ID: G0
// Name: goal
// Type: interleaved (no notation)
// Relation to children: and
// Children: G1
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & !(G1_achievable*N > decision_G1) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1);

module System
  
endmodule
