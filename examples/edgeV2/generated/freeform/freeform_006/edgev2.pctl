P=? [G t6_state=1 => (true & t5_achieved )] = 1
P>=1 [ G g1_state + g4_state <= 1 ]
P>=1 [ G g1_state=1 => g0_chosen=1 ]
P>=1 [ G g4_state=1 => g0_chosen=2 ]
