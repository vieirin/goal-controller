P=? [ G 0 + g1_state + g4_state <= 1 ] =1
P=? [G g1_state=1 => g0_chosen=1 ] =1
P=? [G g4_state=1 => g0_chosen=2 ] =1
P=? [ G 0 + t2_state + t3_state <= 1 ] =1
P=? [ G 0 + t5_state + t6_state <= 1 ] =1
