P=? [ G 0 + g1_state + g4_state <= 1 ] =1

P=? [ G 0 + t2_state + t3_state <= 1 ] =1
P=? [ G t3_state=1 => t2_failed=3 ]=1
 P=? [ G g1_achieved => (t2_achieved | (t2_failed=3 & t3_achieved)) ]=1
P>=1 [ G g1_state + g4_state <= 1 ]
P>=1 [ G t2_state + t3_state <= 1 ]
P>=1 [ G t3_state=1 => t2_failed=3 ]
P=? [ F g0_achieved ]
