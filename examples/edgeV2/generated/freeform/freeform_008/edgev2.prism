// ID: G0
// Name: goal
// Type: alternative
// Relation to children: or
// Children: G1, G15
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g15_state=0 & (G1_achievable/(G1_achievable+G15_achievable))*N > _decision_G0 -> true;
  [pursue_G15] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_state=0 & (G15_achievable/(G1_achievable+G15_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G15_achievable))*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g15_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g15_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | g15_achieved);
formula G0_achievable = G1_achievable + G15_achievable - (G1_achievable * G15_achievable);

// ID: G1
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T2, G3
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_T2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g3_state=0 -> true;
  [pursue_G3] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & t2_achieved & t2_state=0 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & t2_state=0 & g3_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & t2_state=0 & g3_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (t2_achieved & g3_achieved);
formula G1_achievable = g1_achieved ? 0 : (!t2_achieved ? T2_achievable : 1) * (!g3_achieved ? G3_achievable : 1);

// ID: G3
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T4, G5, G8, G11
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & g5_state=0 & g8_state=0 & g11_state=0 & (T4_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3 -> true;
  [pursue_G5] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_state=0 & g8_state=0 & g11_state=0 & (G5_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3 & !((T4_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) -> true;
  [pursue_G8] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_state=0 & g5_state=0 & g11_state=0 & (G8_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3 & !((T4_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) & !((G5_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) -> true;
  [pursue_G11] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_state=0 & g5_state=0 & g8_state=0 & (G11_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3 & !((T4_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) & !((G5_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) & !((G8_achievable/(T4_achievable+G5_achievable+G8_achievable+G11_achievable))*N > _decision_G3) -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 & g5_state=0 & g8_state=0 & g11_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & g5_state=0 & g8_state=0 & g11_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

formula g3_achieved = (t4_achieved | g5_achieved | g8_achieved | g11_achieved);
formula G3_achievable = T4_achievable + G5_achievable + G8_achievable + G11_achievable - (T4_achievable * G5_achievable * G8_achievable * G11_achievable);

// ID: G5
// Name: goal
// Type: choice
// Relation to children: or
// Children: T6, T7
module G5
  g5_state : [0..1] init 0;
  g5_chosen : [0..2] init 0;

  [pursue_G5] !g5_achieved & g5_state=0 -> (g5_state'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & g5_chosen=0 & G5_achievable*N > decision_G5 & t7_state=0 & (T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 -> (g5_chosen'=1);
  [pursue_T6] !g5_achieved & g5_state=1 & g5_chosen=1 & T6_achievable*N > decision_T6 -> true;
  [pursue_T7] !g5_achieved & g5_state=1 & g5_chosen=0 & G5_achievable*N > decision_G5 & t6_state=0 & (T7_achievable/(T6_achievable+T7_achievable))*N > _decision_G5 & !((T6_achievable/(T6_achievable+T7_achievable))*N > _decision_G5) -> (g5_chosen'=2);
  [pursue_T7] !g5_achieved & g5_state=1 & g5_chosen=2 & T7_achievable*N > decision_T7 -> true;

  [achieved_G5] g5_state=1 & g5_achieved & t6_state=0 & t7_state=0 -> (g5_state'=0);
  
  [skip_G5] g5_chosen=0 & !g5_achieved & g5_state=1 & t6_state=0 & t7_state=0 & G5_achievable*N <= decision_G5 -> (g5_state'=0);
  [skip_G5] !g5_achieved & g5_state=1 & t6_state=0 & g5_chosen=1 & T6_achievable*N <= decision_T6 -> (g5_state'=0);
  [skip_G5] !g5_achieved & g5_state=1 & t7_state=0 & g5_chosen=2 & T7_achievable*N <= decision_T7 -> (g5_state'=0);
endmodule

formula g5_achieved = (t6_achieved | t7_achieved);
formula G5_achievable = g5_chosen=1 ? T6_achievable : g5_chosen=2 ? T7_achievable : (T6_achievable + T7_achievable - (T6_achievable * T7_achievable));

// ID: G8
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T9, T10
module G8
  g8_state : [0..1] init 0;

  [pursue_G8] !g8_achieved & g8_state=0 -> (g8_state'=1);
  [pursue_T9] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t10_state=0 & (T9_achievable/(T9_achievable+T10_achievable))*N > _decision_G8 -> true;
  [pursue_T10] !g8_achieved & g8_state=1 & G8_achievable*N > decision_G8 & t9_state=0 & (T10_achievable/(T9_achievable+T10_achievable))*N > _decision_G8 & !((T9_achievable/(T9_achievable+T10_achievable))*N > _decision_G8) -> true;

  [achieved_G8] g8_state=1 & g8_achieved & t9_state=0 & t10_state=0 -> (g8_state'=0);
  
  [skip_G8] !g8_achieved & g8_state=1 & t9_state=0 & t10_state=0 & G8_achievable*N <= decision_G8 -> (g8_state'=0);
endmodule

formula g8_achieved = (t9_achieved | t10_achieved);
formula G8_achievable = T9_achievable + T10_achievable - (T9_achievable * T10_achievable);

// ID: G11
// Name: goal
// Type: choice
// Relation to children: or
// Children: T12, T13, T14
module G11
  g11_state : [0..1] init 0;
  g11_chosen : [0..3] init 0;

  [pursue_G11] !g11_achieved & g11_state=0 -> (g11_state'=1);
  [pursue_T12] !g11_achieved & g11_state=1 & g11_chosen=0 & G11_achievable*N > decision_G11 & t13_state=0 & t14_state=0 & (T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 -> (g11_chosen'=1);
  [pursue_T12] !g11_achieved & g11_state=1 & g11_chosen=1 & T12_achievable*N > decision_T12 -> true;
  [pursue_T13] !g11_achieved & g11_state=1 & g11_chosen=0 & G11_achievable*N > decision_G11 & t12_state=0 & t14_state=0 & (T13_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 & !((T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) -> (g11_chosen'=2);
  [pursue_T13] !g11_achieved & g11_state=1 & g11_chosen=2 & T13_achievable*N > decision_T13 -> true;
  [pursue_T14] !g11_achieved & g11_state=1 & g11_chosen=0 & G11_achievable*N > decision_G11 & t12_state=0 & t13_state=0 & (T14_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11 & !((T12_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) & !((T13_achievable/(T12_achievable+T13_achievable+T14_achievable))*N > _decision_G11) -> (g11_chosen'=3);
  [pursue_T14] !g11_achieved & g11_state=1 & g11_chosen=3 & T14_achievable*N > decision_T14 -> true;

  [achieved_G11] g11_state=1 & g11_achieved & t12_state=0 & t13_state=0 & t14_state=0 -> (g11_state'=0);
  
  [skip_G11] g11_chosen=0 & !g11_achieved & g11_state=1 & t12_state=0 & t13_state=0 & t14_state=0 & G11_achievable*N <= decision_G11 -> (g11_state'=0);
  [skip_G11] !g11_achieved & g11_state=1 & t12_state=0 & g11_chosen=1 & T12_achievable*N <= decision_T12 -> (g11_state'=0);
  [skip_G11] !g11_achieved & g11_state=1 & t13_state=0 & g11_chosen=2 & T13_achievable*N <= decision_T13 -> (g11_state'=0);
  [skip_G11] !g11_achieved & g11_state=1 & t14_state=0 & g11_chosen=3 & T14_achievable*N <= decision_T14 -> (g11_state'=0);
endmodule

formula g11_achieved = (t12_achieved | t13_achieved | t14_achieved);
formula G11_achievable = g11_chosen=1 ? T12_achievable : g11_chosen=2 ? T13_achievable : g11_chosen=3 ? T14_achievable : (T12_achievable + T13_achievable + T14_achievable - (T12_achievable * T13_achievable * T14_achievable));

// ID: G15
// Name: goal
// Type: alternative
// Relation to children: or
// Children: T16, T17, G18, G22
module G15
  g15_state : [0..1] init 0;

  [pursue_G15] !g15_achieved & g15_state=0 -> (g15_state'=1);
  [pursue_T16] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t17_state=0 & g18_state=0 & g22_state=0 & (T16_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15 -> true;
  [pursue_T17] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & g18_state=0 & g22_state=0 & (T17_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15 & !((T16_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) -> true;
  [pursue_G18] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & t17_state=0 & g22_state=0 & (G18_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15 & !((T16_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) & !((T17_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) -> true;
  [pursue_G22] !g15_achieved & g15_state=1 & G15_achievable*N > decision_G15 & t16_state=0 & t17_state=0 & g18_state=0 & (G22_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15 & !((T16_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) & !((T17_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) & !((G18_achievable/(T16_achievable+T17_achievable+G18_achievable+G22_achievable))*N > _decision_G15) -> true;

  [achieved_G15] g15_state=1 & g15_achieved & t16_state=0 & t17_state=0 & g18_state=0 & g22_state=0 -> (g15_state'=0);
  
  [skip_G15] !g15_achieved & g15_state=1 & t16_state=0 & t17_state=0 & g18_state=0 & g22_state=0 & G15_achievable*N <= decision_G15 -> (g15_state'=0);
endmodule

formula g15_achieved = (t16_achieved | t17_achieved | g18_achieved | g22_achieved);
formula G15_achievable = T16_achievable + T17_achievable + G18_achievable + G22_achievable - (T16_achievable * T17_achievable * G18_achievable * G22_achievable);

// ID: G18
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: G19
module G18
  g18_state : [0..1] init 0;

  [pursue_G18] !g18_achieved & g18_state=0 -> (g18_state'=1);
  [pursue_G19] !g18_achieved & g18_state=1 & G18_achievable*N > decision_G18 & (G19_achievable/(G19_achievable))*N > _decision_G18 -> true;

  [achieved_G18] g18_state=1 & g18_achieved & g19_state=0 -> (g18_state'=0);
  
  [skip_G18] !g18_achieved & g18_state=1 & g19_state=0 & G18_achievable*N <= decision_G18 -> (g18_state'=0);
endmodule

formula g18_achieved = (g19_achieved);
formula G18_achievable = G19_achievable;

// ID: G19
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T20, T21
module G19
  g19_state : [0..1] init 0;
  t20_failed : [0..3] init 0;

  [pursue_G19] !g19_achieved & g19_state=0 -> (g19_state'=1);
  [pursue_T20] !g19_achieved & g19_state=1 & t20_failed<3 & T20_achievable*N > decision_T20 -> (t20_failed'=t20_failed+1);
  [pursue_T20] !g19_achieved & g19_state=1 & t20_failed=3 & G19_achievable*N > decision_G19 & t21_state=0 & (T20_achievable/(T20_achievable+T21_achievable))*N > _decision_G19 -> true;
  [pursue_T21] !g19_achieved & g19_state=1 & t20_failed=3 & G19_achievable*N > decision_G19 & t20_state=0 & (T21_achievable/(T20_achievable+T21_achievable))*N > _decision_G19 & !((T20_achievable/(T20_achievable+T21_achievable))*N > _decision_G19) -> true;

  [achieved_G19] g19_state=1 & g19_achieved & t20_state=0 & t21_state=0 -> (g19_state'=0);
  
  [skip_G19] !g19_achieved & g19_state=1 & t20_state=0 & t20_failed<3 & T20_achievable*N <= decision_T20 -> (g19_state'=0);
  [skip_G19] t20_failed=3 & !g19_achieved & g19_state=1 & t20_state=0 & t21_state=0 & G19_achievable*N <= decision_G19 -> (g19_state'=0);
endmodule

formula g19_achieved = (t20_achieved | (t20_failed=3 & t21_achieved));
formula G19_achievable = T20_achievable + T21_achievable - (T20_achievable * T21_achievable);

// ID: G22
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G23, G26, G30, G35
module G22
  g22_state : [0..1] init 0;

  [pursue_G22] !g22_achieved & g22_state=0 -> (g22_state'=1);
  [pursue_G23] !g22_achieved & g22_state=1 & G22_achievable*N > decision_G22 & g26_state=0 & g30_state=0 & g35_state=0 & G23_relative*N > _decision_G22 -> true;
  [pursue_G26] !g22_achieved & g22_state=1 & G22_achievable*N > decision_G22 & g23_state=0 & g30_state=0 & g35_state=0 & G26_relative*N > _decision_G22 & !(G23_relative*N > _decision_G22) -> true;
  [pursue_G30] !g22_achieved & g22_state=1 & G22_achievable*N > decision_G22 & g23_state=0 & g26_state=0 & g35_state=0 & G30_relative*N > _decision_G22 & !(G23_relative*N > _decision_G22) & !(G26_relative*N > _decision_G22) -> true;
  [pursue_G35] !g22_achieved & g22_state=1 & G22_achievable*N > decision_G22 & g23_state=0 & g26_state=0 & g30_state=0 & G35_relative*N > _decision_G22 & !(G23_relative*N > _decision_G22) & !(G26_relative*N > _decision_G22) & !(G30_relative*N > _decision_G22) -> true;

  [achieved_G22] g22_state=1 & g22_achieved & g23_state=0 & g26_state=0 & g30_state=0 & g35_state=0 -> (g22_state'=0);
  
  [skip_G22] !g22_achieved & g22_state=1 & g23_state=0 & g26_state=0 & g30_state=0 & g35_state=0 & G22_achievable*N <= decision_G22 -> (g22_state'=0);
endmodule

formula g22_achieved = (g23_achieved & g26_achieved & g30_achieved & g35_achieved);
formula G22_achievable = g22_achieved ? 0 : (!g23_achieved ? G23_achievable : 1) * (!g26_achieved ? G26_achievable : 1) * (!g30_achieved ? G30_achievable : 1) * (!g35_achieved ? G35_achievable : 1);
formula G23_relative = g23_achieved ? 0 : G23_achievable/(G23_achievable + (g26_achieved ? 0 : G26_achievable) + (g30_achieved ? 0 : G30_achievable) + (g35_achieved ? 0 : G35_achievable));
formula G26_relative = g26_achieved ? 0 : G26_achievable/(G26_achievable + (g23_achieved ? 0 : G23_achievable) + (g30_achieved ? 0 : G30_achievable) + (g35_achieved ? 0 : G35_achievable));
formula G30_relative = g30_achieved ? 0 : G30_achievable/(G30_achievable + (g23_achieved ? 0 : G23_achievable) + (g26_achieved ? 0 : G26_achievable) + (g35_achieved ? 0 : G35_achievable));
formula G35_relative = g35_achieved ? 0 : G35_achievable/(G35_achievable + (g23_achieved ? 0 : G23_achievable) + (g26_achieved ? 0 : G26_achievable) + (g30_achieved ? 0 : G30_achievable));

// ID: G23
// Name: goal
// Type: choice
// Relation to children: or
// Children: T24, T25
module G23
  g23_state : [0..1] init 0;
  g23_chosen : [0..2] init 0;

  [pursue_G23] !g23_achieved & g23_state=0 -> (g23_state'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=0 & G23_achievable*N > decision_G23 & t25_state=0 & (T24_achievable/(T24_achievable+T25_achievable))*N > _decision_G23 -> (g23_chosen'=1);
  [pursue_T24] !g23_achieved & g23_state=1 & g23_chosen=1 & T24_achievable*N > decision_T24 -> true;
