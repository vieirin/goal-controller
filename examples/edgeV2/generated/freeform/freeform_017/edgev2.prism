  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & t13_state=0 & g14_state=0 & g18_state=0 & (G2_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1 -> true;
  [pursue_T13] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & g2_state=0 & g14_state=0 & g18_state=0 & (T13_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) -> true;
  [pursue_G14] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & g2_state=0 & t13_state=0 & g18_state=0 & (G14_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) & !((T13_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) -> true;
  [pursue_G18] !g1_achieved & g1_state=1 & g2_failed=5 & G1_achievable*N > decision_G1 & g2_state=0 & t13_state=0 & g14_state=0 & (G18_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) & !((T13_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) & !((G14_achievable/(G2_achievable+T13_achievable+G14_achievable+G18_achievable))*N > _decision_G1) -> true;

