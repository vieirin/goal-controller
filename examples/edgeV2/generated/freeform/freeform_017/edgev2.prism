// ID: G0
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G1, G21, G28
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G1_achievable*N > decision_G1 -> true;
  [pursue_G21] !g0_achieved & g0_state=1 & G21_achievable*N > decision_G21 -> true;
  [pursue_G28] !g0_achieved & g0_state=1 & G28_achievable*N > decision_G28 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g21_state=0 & g28_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g21_state=0 & g28_state=0 & !(G1_achievable*N > decision_G1 | G21_achievable*N > decision_G21 | G28_achievable*N > decision_G28) -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g21_achieved & g28_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g21_achieved ? G21_achievable : 1) * (!g28_achieved ? G28_achievable : 1);

// ID: G1
// Name: goal
// Type: degradation
// Relation to children: or
