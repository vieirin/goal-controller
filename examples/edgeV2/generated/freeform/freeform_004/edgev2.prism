dtmc

const int N = 10;
const int decision_G0;
const int decision_G1;
const int decision_G10;
const int _decision_G10;
const int decision_G14;
const int _decision_G14;
const int decision_G16;
const int _decision_G16;
const int decision_G3;
const int decision_G6;
const int decision_G7;
const int decision_T11;
const int decision_T12;
const int decision_T13;
const int decision_T15;
const int decision_T17;
const int decision_T18;
const int decision_T19;
const int decision_T2;
const int decision_T4;
const int decision_T5;
const int decision_T8;
const int decision_T9;


// ID: G0
// Name: goal
// Type: sequence
// Relation to children: and
// Children: G1, G6, G14
module G0
  g0_state : [0..1] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g6_state=0 & g14_state=0 -> true;
  [pursue_G6] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_achieved & g1_state=0 & g14_state=0 -> true;
  [pursue_G14] !g0_achieved & g0_state=1 & G0_achievable*N > decision_G0 & g1_achieved & g6_achieved & g1_state=0 & g6_state=0 -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g6_state=0 & g14_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g6_state=0 & g14_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved & g6_achieved & g14_achieved);
formula G0_achievable = g0_achieved ? 0 : (!g1_achieved ? G1_achievable : 1) * (!g6_achieved ? G6_achievable : 1) * (!g14_achieved ? G14_achievable : 1);

// ID: G1
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T2, G3
module G1
  g1_state : [0..1] init 0;

  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_T2] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & g3_state=0 -> true;
  [pursue_G3] !g1_achieved & g1_state=1 & G1_achievable*N > decision_G1 & t2_achieved & t2_state=0 -> true;

  [achieved_G1] g1_state=1 & g1_achieved & t2_state=0 & g3_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & t2_state=0 & g3_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (t2_achieved & g3_achieved);
formula G1_achievable = g1_achieved ? 0 : (!t2_achieved ? T2_achievable : 1) * (!g3_achieved ? G3_achievable : 1);

// ID: G3
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T4, T5
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t5_state=0 -> true;
  [pursue_T5] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_achieved & t4_state=0 -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 & t5_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & t5_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

formula g3_achieved = (t4_achieved & t5_achieved);
formula G3_achievable = g3_achieved ? 0 : (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1);

// ID: G6
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G7, G10, T13
module G6
  g6_state : [0..1] init 0;

  [pursue_G6] !g6_achieved & g6_state=0 -> (g6_state'=1);
  [pursue_G7] !g6_achieved & g6_state=1 & G7_achievable*N > decision_G7 -> true;
  [pursue_G10] !g6_achieved & g6_state=1 & G10_achievable*N > decision_G10 -> true;
  [pursue_T13] !g6_achieved & g6_state=1 & T13_achievable*N > decision_T13 -> true;

  [achieved_G6] g6_state=1 & g6_achieved & g7_state=0 & g10_state=0 & t13_state=0 -> (g6_state'=0);
  
  [skip_G6] !g6_achieved & g6_state=1 & g7_state=0 & g10_state=0 & t13_state=0 & !(G7_achievable*N > decision_G7 | G10_achievable*N > decision_G10 | T13_achievable*N > decision_T13) -> (g6_state'=0);
endmodule

formula g6_achieved = (g7_achieved & g10_achieved & t13_achieved);
formula G6_achievable = g6_achieved ? 0 : (!g7_achieved ? G7_achievable : 1) * (!g10_achieved ? G10_achievable : 1) * (!t13_achieved ? T13_achievable : 1);

// ID: G7
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: T8, T9
module G7
  g7_state : [0..1] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_T8] !g7_achieved & g7_state=1 & T8_achievable*N > decision_T8 -> true;
  [pursue_T9] !g7_achieved & g7_state=1 & T9_achievable*N > decision_T9 -> true;

  [achieved_G7] g7_state=1 & g7_achieved & t8_state=0 & t9_state=0 -> (g7_state'=0);
  
  [skip_G7] !g7_achieved & g7_state=1 & t8_state=0 & t9_state=0 & !(T8_achievable*N > decision_T8 | T9_achievable*N > decision_T9) -> (g7_state'=0);
endmodule

formula g7_achieved = (t8_achieved & t9_achieved);
formula G7_achievable = g7_achieved ? 0 : (!t8_achieved ? T8_achievable : 1) * (!t9_achieved ? T9_achievable : 1);

// ID: G10
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: T11, T12
module G10
  g10_state : [0..1] init 0;

  [pursue_G10] !g10_achieved & g10_state=0 -> (g10_state'=1);
  [pursue_T11] !g10_achieved & g10_state=1 & G10_achievable*N > decision_G10 & t12_state=0 & (T11_achievable/(T11_achievable+T12_achievable))*N > _decision_G10 -> true;
  [pursue_T12] !g10_achieved & g10_state=1 & G10_achievable*N > decision_G10 & t11_state=0 & (T12_achievable/(T11_achievable+T12_achievable))*N > _decision_G10 & !((T11_achievable/(T11_achievable+T12_achievable))*N > _decision_G10) -> true;

  [achieved_G10] g10_state=1 & g10_achieved & t11_state=0 & t12_state=0 -> (g10_state'=0);
  
  [skip_G10] !g10_achieved & g10_state=1 & t11_state=0 & t12_state=0 & G10_achievable*N <= decision_G10 -> (g10_state'=0);
endmodule

formula g10_achieved = (t11_achieved | t12_achieved);
formula G10_achievable = T11_achievable + T12_achievable - (T11_achievable * T12_achievable);

// ID: G14
// Name: goal
// Type: degradation
// Relation to children: or
// Children: T15, G16, T19
module G14
  g14_state : [0..1] init 0;
  t15_failed : [0..3] init 0;

  [pursue_G14] !g14_achieved & g14_state=0 -> (g14_state'=1);
  [pursue_T15] !g14_achieved & g14_state=1 & t15_failed<3 & T15_achievable*N > decision_T15 -> (t15_failed'=t15_failed+1);
  [pursue_T15] !g14_achieved & g14_state=1 & t15_failed=3 & G14_achievable*N > decision_G14 & g16_state=0 & t19_state=0 & (T15_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14 -> true;
  [pursue_G16] !g14_achieved & g14_state=1 & t15_failed=3 & G14_achievable*N > decision_G14 & t15_state=0 & t19_state=0 & (G16_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14 & !((T15_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14) -> true;
  [pursue_T19] !g14_achieved & g14_state=1 & t15_failed=3 & G14_achievable*N > decision_G14 & t15_state=0 & g16_state=0 & (T19_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14 & !((T15_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14) & !((G16_achievable/(T15_achievable+G16_achievable+T19_achievable))*N > _decision_G14) -> true;

  [achieved_G14] g14_state=1 & g14_achieved & t15_state=0 & g16_state=0 & t19_state=0 -> (g14_state'=0);
  
  [skip_G14] !g14_achieved & g14_state=1 & t15_state=0 & t15_failed<3 & T15_achievable*N <= decision_T15 -> (g14_state'=0);
  [skip_G14] t15_failed=3 & !g14_achieved & g14_state=1 & t15_state=0 & g16_state=0 & t19_state=0 & G14_achievable*N <= decision_G14 -> (g14_state'=0);
endmodule

formula g14_achieved = (t15_achieved | (t15_failed=3 & g16_achieved) | (t15_failed=3 & t19_achieved));
formula G14_achievable = T15_achievable + G16_achievable + T19_achievable - (T15_achievable * G16_achievable * T19_achievable);

// ID: G16
// Name: goal
// Type: choice
// Relation to children: or
// Children: T17, T18
module G16
  g16_state : [0..1] init 0;
  g16_chosen : [0..2] init 0;

  [pursue_G16] !g16_achieved & g16_state=0 -> (g16_state'=1);
  [pursue_T17] !g16_achieved & g16_state=1 & g16_chosen=0 & G16_achievable*N > decision_G16 & t18_state=0 & (T17_achievable/(T17_achievable+T18_achievable))*N > _decision_G16 -> (g16_chosen'=1);
  [pursue_T17] !g16_achieved & g16_state=1 & g16_chosen=1 & T17_achievable*N > decision_T17 -> true;
  [pursue_T18] !g16_achieved & g16_state=1 & g16_chosen=0 & G16_achievable*N > decision_G16 & t17_state=0 & (T18_achievable/(T17_achievable+T18_achievable))*N > _decision_G16 & !((T17_achievable/(T17_achievable+T18_achievable))*N > _decision_G16) -> (g16_chosen'=2);
  [pursue_T18] !g16_achieved & g16_state=1 & g16_chosen=2 & T18_achievable*N > decision_T18 -> true;

  [achieved_G16] g16_state=1 & g16_achieved & t17_state=0 & t18_state=0 -> (g16_state'=0);
  
  [skip_G16] g16_chosen=0 & !g16_achieved & g16_state=1 & t17_state=0 & t18_state=0 & G16_achievable*N <= decision_G16 -> (g16_state'=0);
  [skip_G16] !g16_achieved & g16_state=1 & t17_state=0 & g16_chosen=1 & T17_achievable*N <= decision_T17 -> (g16_state'=0);
  [skip_G16] !g16_achieved & g16_state=1 & t18_state=0 & g16_chosen=2 & T18_achievable*N <= decision_T18 -> (g16_state'=0);
endmodule

formula g16_achieved = (t17_achieved | t18_achieved);
formula G16_achievable = g16_chosen=1 ? T17_achievable : g16_chosen=2 ? T18_achievable : (T17_achievable + T18_achievable - (T17_achievable * T18_achievable));


const double T11_achievable = 0.8;
const double T12_achievable = 0.8;
const double T13_achievable = 0.8;
const double T15_achievable = 0.8;
const double T17_achievable = 0.8;
const double T18_achievable = 0.8;
const double T19_achievable = 0.8;
const double T2_achievable = 0.8;
const double T4_achievable = 0.8;
const double T5_achievable = 0.8;
const double T8_achievable = 0.8;
const double T9_achievable = 0.8;

module ChangeManager
  t11_state: [0..1] init 0;
  t11_achieved_: [0..1] init 0;
  t12_state: [0..1] init 0;
  t12_achieved_: [0..1] init 0;
  t13_state: [0..1] init 0;
  t13_achieved_: [0..1] init 0;
  t15_state: [0..1] init 0;
  t15_achieved_: [0..1] init 0;
  t17_state: [0..1] init 0;
  t17_achieved_: [0..1] init 0;
  t18_state: [0..1] init 0;
  t18_achieved_: [0..1] init 0;
  t19_state: [0..1] init 0;
  t19_achieved_: [0..1] init 0;
  t2_state: [0..1] init 0;
  t2_achieved_: [0..1] init 0;
  t4_state: [0..1] init 0;
  t4_achieved_: [0..1] init 0;
  t5_state: [0..1] init 0;
  t5_achieved_: [0..1] init 0;
  t8_state: [0..1] init 0;
  t8_achieved_: [0..1] init 0;
  t9_state: [0..1] init 0;
  t9_achieved_: [0..1] init 0;
  
  // Task T11: task
  [pursue_T11] t11_state=0 & t11_achieved_=0 -> (t11_state'=1);
  [try_T11] t11_state=1 & t11_achieved_=0 -> T11_achievable: (t11_achieved_'=1) + 1-T11_achievable: (t11_state'=0);
  [achieved_T11] t11_state=1 & t11_achieved_=1 -> (t11_state'=0);
  

  // Task T12: task
  [pursue_T12] t12_state=0 & t12_achieved_=0 -> (t12_state'=1);
  [try_T12] t12_state=1 & t12_achieved_=0 -> T12_achievable: (t12_achieved_'=1) + 1-T12_achievable: (t12_state'=0);
  [achieved_T12] t12_state=1 & t12_achieved_=1 -> (t12_state'=0);
  

  // Task T13: task
  [pursue_T13] t13_state=0 & t13_achieved_=0 -> (t13_state'=1);
  [try_T13] t13_state=1 & t13_achieved_=0 -> T13_achievable: (t13_achieved_'=1) + 1-T13_achievable: (t13_state'=0);
  [achieved_T13] t13_state=1 & t13_achieved_=1 -> (t13_state'=0);
  

  // Task T15: task
  [pursue_T15] t15_state=0 & t15_achieved_=0 -> (t15_state'=1);
  [try_T15] t15_state=1 & t15_achieved_=0 -> T15_achievable: (t15_achieved_'=1) + 1-T15_achievable: (t15_state'=0);
  [achieved_T15] t15_state=1 & t15_achieved_=1 -> (t15_state'=0);
  

  // Task T17: task
  [pursue_T17] t17_state=0 & t17_achieved_=0 -> (t17_state'=1);
  [try_T17] t17_state=1 & t17_achieved_=0 -> T17_achievable: (t17_achieved_'=1) + 1-T17_achievable: (t17_state'=0);
  [achieved_T17] t17_state=1 & t17_achieved_=1 -> (t17_state'=0);
  

  // Task T18: task
  [pursue_T18] t18_state=0 & t18_achieved_=0 -> (t18_state'=1);
  [try_T18] t18_state=1 & t18_achieved_=0 -> T18_achievable: (t18_achieved_'=1) + 1-T18_achievable: (t18_state'=0);
  [achieved_T18] t18_state=1 & t18_achieved_=1 -> (t18_state'=0);
  

  // Task T19: task
  [pursue_T19] t19_state=0 & t19_achieved_=0 -> (t19_state'=1);
  [try_T19] t19_state=1 & t19_achieved_=0 -> T19_achievable: (t19_achieved_'=1) + 1-T19_achievable: (t19_state'=0);
  [achieved_T19] t19_state=1 & t19_achieved_=1 -> (t19_state'=0);
  

  // Task T2: task
  [pursue_T2] t2_state=0 & t2_achieved_=0 -> (t2_state'=1);
  [try_T2] t2_state=1 & t2_achieved_=0 -> T2_achievable: (t2_achieved_'=1) + 1-T2_achievable: (t2_state'=0);
  [achieved_T2] t2_state=1 & t2_achieved_=1 -> (t2_state'=0);
  

  // Task T4: task
  [pursue_T4] t4_state=0 & t4_achieved_=0 -> (t4_state'=1);
  [try_T4] t4_state=1 & t4_achieved_=0 -> T4_achievable: (t4_achieved_'=1) + 1-T4_achievable: (t4_state'=0);
  [achieved_T4] t4_state=1 & t4_achieved_=1 -> (t4_state'=0);
  

  // Task T5: task
  [pursue_T5] t5_state=0 & t5_achieved_=0 -> (t5_state'=1);
  [try_T5] t5_state=1 & t5_achieved_=0 -> T5_achievable: (t5_achieved_'=1) + 1-T5_achievable: (t5_state'=0);
  [achieved_T5] t5_state=1 & t5_achieved_=1 -> (t5_state'=0);
  

  // Task T8: task
  [pursue_T8] t8_state=0 & t8_achieved_=0 -> (t8_state'=1);
  [try_T8] t8_state=1 & t8_achieved_=0 -> T8_achievable: (t8_achieved_'=1) + 1-T8_achievable: (t8_state'=0);
  [achieved_T8] t8_state=1 & t8_achieved_=1 -> (t8_state'=0);
  

  // Task T9: task
  [pursue_T9] t9_state=0 & t9_achieved_=0 -> (t9_state'=1);
  [try_T9] t9_state=1 & t9_achieved_=0 -> T9_achievable: (t9_achieved_'=1) + 1-T9_achievable: (t9_state'=0);
  [achieved_T9] t9_state=1 & t9_achieved_=1 -> (t9_state'=0);
  
endmodule

formula t11_achieved = (t11_achieved_=1);
formula t12_achieved = (t12_achieved_=1);
formula t13_achieved = (t13_achieved_=1);
