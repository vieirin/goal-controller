formula g7_achieved = (g8_achieved | t12_achieved);
formula G7_achievable = g7_chosen=1 ? G8_achievable : g7_chosen=2 ? T12_achievable : (G8_achievable + T12_achievable - (G8_achievable * T12_achievable));

