  [pursue_G1] !g1_achieved & g1_state=0 -> (g1_state'=1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed<2 & G2_achievable*N > decision_G2 -> (g2_failed'=g2_failed+1);
  [pursue_G2] !g1_achieved & g1_state=1 & g2_failed=2 & G1_achievable*N > decision_G1 & g7_state=0 & g13_state=0 & t17_state=0 & (G2_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1 -> true;
  [pursue_G7] !g1_achieved & g1_state=1 & g2_failed=2 & G1_achievable*N > decision_G1 & g2_state=0 & g13_state=0 & t17_state=0 & (G7_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) -> true;
  [pursue_G13] !g1_achieved & g1_state=1 & g2_failed=2 & G1_achievable*N > decision_G1 & g2_state=0 & g7_state=0 & t17_state=0 & (G13_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) & !((G7_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) -> true;
  [pursue_T17] !g1_achieved & g1_state=1 & g2_failed=2 & G1_achievable*N > decision_G1 & g2_state=0 & g7_state=0 & g13_state=0 & (T17_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1 & !((G2_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) & !((G7_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) & !((G13_achievable/(G2_achievable+G7_achievable+G13_achievable+T17_achievable))*N > _decision_G1) -> true;

  [achieved_G1] g1_state=1 & g1_achieved & g2_state=0 & g7_state=0 & g13_state=0 & t17_state=0 -> (g1_state'=0);
  
  [skip_G1] !g1_achieved & g1_state=1 & g2_state=0 & g2_failed<2 & G2_achievable*N <= decision_G2 -> (g1_state'=0);
  [skip_G1] g2_failed=2 & !g1_achieved & g1_state=1 & g2_state=0 & g7_state=0 & g13_state=0 & t17_state=0 & G1_achievable*N <= decision_G1 -> (g1_state'=0);
endmodule

formula g1_achieved = (g2_achieved | (g2_failed=2 & g7_achieved) | (g2_failed=2 & g13_achieved) | (g2_failed=2 & t17_achieved));
formula G1_achievable = G2_achievable + G7_achievable + G13_achievable + T17_achievable - (G2_achievable * G7_achievable * G13_achievable * T17_achievable);

// ID: G2
// Name: goal
// Type: alternative (no notation)
// Relation to children: or
// Children: G3
module G2
  g2_state : [0..1] init 0;

  [pursue_G2] !g2_achieved & g2_state=0 -> (g2_state'=1);
  [pursue_G3] !g2_achieved & g2_state=1 & G2_achievable*N > decision_G2 & (G3_achievable/(G3_achievable))*N > _decision_G2 -> true;

  [achieved_G2] g2_state=1 & g2_achieved & g3_state=0 -> (g2_state'=0);
  
  [skip_G2] !g2_achieved & g2_state=1 & g3_state=0 & G2_achievable*N <= decision_G2 -> (g2_state'=0);
endmodule

formula g2_achieved = (g3_achieved);
formula G2_achievable = G3_achievable;

// ID: G3
// Name: goal
// Type: sequence
// Relation to children: and
// Children: T4, T5, T6
module G3
  g3_state : [0..1] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t5_state=0 & t6_state=0 -> true;
  [pursue_T5] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_achieved & t4_state=0 & t6_state=0 -> true;
  [pursue_T6] !g3_achieved & g3_state=1 & G3_achievable*N > decision_G3 & t4_achieved & t5_achieved & t4_state=0 & t5_state=0 -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 & t5_state=0 & t6_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & t5_state=0 & t6_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

formula g3_achieved = (t4_achieved & t5_achieved & t6_achieved);
formula G3_achievable = g3_achieved ? 0 : (!t4_achieved ? T4_achievable : 1) * (!t5_achieved ? T5_achievable : 1) * (!t6_achieved ? T6_achievable : 1);

// ID: G7
// Name: goal
// Type: choice
