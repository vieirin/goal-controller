module G7
  g7_state : [0..1] init 0;
  g7_chosen : [0..2] init 0;

  [pursue_G7] !g7_achieved & g7_state=0 -> (g7_state'=1);
  [pursue_G8] !g7_achieved & g7_state=1 & g7_chosen=0 & G7_achievable*N > decision_G7 & t12_state=0 & (G8_achievable/(G8_achievable+T12_achievable))*N > _decision_G7 -> (g7_chosen'=1);
  [pursue_G8] !g7_achieved & g7_state=1 & g7_chosen=1 & G8_achievable*N > decision_G8 -> true;
  [pursue_T12] !g7_achieved & g7_state=1 & g7_chosen=0 & G7_achievable*N > decision_G7 & g8_state=0 & (T12_achievable/(G8_achievable+T12_achievable))*N > _decision_G7 & !((G8_achievable/(G8_achievable+T12_achievable))*N > _decision_G7) -> (g7_chosen'=2);
  [pursue_T12] !g7_achieved & g7_state=1 & g7_chosen=2 & T12_achievable*N > decision_T12 -> true;

