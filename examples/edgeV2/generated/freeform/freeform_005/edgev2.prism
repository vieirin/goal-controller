// ID: G0
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G1, G18, G30
module G0
  g0_state : [0..1] init 0;
  g1_failed : [0..2] init 0;

  [pursue_G0] !g0_achieved & g0_state=0 -> (g0_state'=1);
  [pursue_G1] !g0_achieved & g0_state=1 & g1_failed<2 & G1_achievable*N > decision_G1 -> (g1_failed'=g1_failed+1);
  [pursue_G1] !g0_achieved & g0_state=1 & g1_failed=2 & G0_achievable*N > decision_G0 & g18_state=0 & g30_state=0 & (G1_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0 -> true;
  [pursue_G18] !g0_achieved & g0_state=1 & g1_failed=2 & G0_achievable*N > decision_G0 & g1_state=0 & g30_state=0 & (G18_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0) -> true;
  [pursue_G30] !g0_achieved & g0_state=1 & g1_failed=2 & G0_achievable*N > decision_G0 & g1_state=0 & g18_state=0 & (G30_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0 & !((G1_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0) & !((G18_achievable/(G1_achievable+G18_achievable+G30_achievable))*N > _decision_G0) -> true;

  [achieved_G0] g0_state=1 & g0_achieved & g1_state=0 & g18_state=0 & g30_state=0 -> (g0_state'=0);
  
  [skip_G0] !g0_achieved & g0_state=1 & g1_state=0 & g1_failed<2 & G1_achievable*N <= decision_G1 -> (g0_state'=0);
  [skip_G0] g1_failed=2 & !g0_achieved & g0_state=1 & g1_state=0 & g18_state=0 & g30_state=0 & G0_achievable*N <= decision_G0 -> (g0_state'=0);
endmodule

formula g0_achieved = (g1_achieved | (g1_failed=2 & g18_achieved) | (g1_failed=2 & g30_achieved));
formula G0_achievable = G1_achievable + G18_achievable + G30_achievable - (G1_achievable * G18_achievable * G30_achievable);

// ID: G1
// Name: goal
// Type: degradation
// Relation to children: or
