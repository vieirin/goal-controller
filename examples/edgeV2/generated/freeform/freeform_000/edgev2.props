P>=1 [ G 0 + g1_state + g4_state <= 1 ];
P>=1 [ G 0 + t2_state + t3_state <= 1 ];
P>=1 [G t2_state=1 => (true )];
P>=1 [G t3_state=1 => (true & t2_achieved )];
P>=1 [ G 0 + t5_state + t6_state <= 1 ];
P>=1 [G t5_state=1 => g4_chosen=1 ];
P>=1 [G t6_state=1 => g4_chosen=2 ];
P>=1 [ G g1_state + g4_state <= 1 ];
P>=1 [ G t2_state + t3_state <= 1 ];
P>=1 [ G t3_state=1 => (t2_achieved) ];
P>=1 [ G t5_state + t6_state <= 1 ];
P>=1 [ G t5_state=1 => g4_chosen=1 ];
P>=1 [ G t6_state=1 => g4_chosen=2 ];
P=? [ F g0_achieved ]
