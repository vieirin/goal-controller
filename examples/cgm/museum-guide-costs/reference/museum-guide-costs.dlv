needed(r_t5) :- todo(t5).
cost(r_t6,35) :- needed(r_t6).
needed(r_t6) :- todo(t6).
cost(r_t7,50) :- needed(r_t7).
needed(r_t7) :- todo(t7).
cost(r_t8,30) :- needed(r_t8).
needed(r_t8) :- todo(t8).
cost(r_t9,20) :- needed(r_t9).
needed(r_t9) :- todo(t9).
cost(r_t10,50) :- needed(r_t10).
needed(r_t10) :- todo(t10).
cost(r_t11,30) :- needed(r_t11).
needed(r_t11) :- todo(t11).
cost(r_t2_t1,30) :- needed(r_t2_t1).
needed(r_t2_t1) :- todo(t2).
needed(r_t2_t1) :- todo(t1).
cost(r_t3_t4,40) :- needed(r_t3_t4).
