% RE-Context (REJ 2010 Code 2): the goal model and its contexts
ach(g1).
ach(g2) | ach(g3) :- ach(g1).
c5 :- ach(g2).
c6 :- ach(g3).
ach(g4) :- ach(g2).
ach(g5) :- ach(g2).
todo(t1) | todo(t2) :- ach(g4).
todo(t3) | todo(t4) :- ach(g5).
ach(g3_1) :- ach(g3).
c10 :- ach(g3_1).
ach(g3_2) :- ach(g3_1).
ach(g6) :- ach(g3_2).
ach(g7) :- ach(g3_2).
ach(g8) | ach(g9) :- ach(g6).
c11 :- ach(g9).
todo(t5) | todo(t6) :- ach(g8).
c12 :- todo(t5).
c13 :- todo(t6).
todo(t7) :- ach(g9).
ach(g10) | ach(g11) :- ach(g7).
c15 :- ach(g11).
todo(t12) :- ach(g10).
todo(t8) :- todo(t12).
todo(t9) :- todo(t12).
todo(t10) | todo(t11) :- ach(g11).
% Code 4: development costs
cost(r_t1,0) :- needed(r_t1).
needed(r_t1) :- todo(t1).
cost(r_t2,10) :- needed(r_t2).
needed(r_t2) :- todo(t2).
cost(r_t3,0) :- needed(r_t3).
needed(r_t3) :- todo(t3).
