      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.actordiagram:AD_HardGoalUI" xmi:id="RoomCleanDependum-figure" x="128" y="24" width="135" height="48" core="RoomCleanDependum"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.actordiagram:AD_SoftGoalUI" xmi:id="efficiencyDependum-figure" x="148" y="110" width="117" height="45" core="efficiencyDependum"/>
    </Diagram>
  </it.itc.sra.taom4e.model.project:Project>
  <it.itc.sra.taom4e.model.core.informalcore.formalcore:FormalBusinessModel name="Cleaner Agent" xmi:id="business-model">
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FActor" name="Stakehoder" xmi:id="Stakeholder"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FActor" name="Cleaner Agent" xmi:id="CleanerAgent" wanted="RC MBL WC DC efficiency" plans="mop sweep loadBattery"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FHardGoal" name="RoomClean" xmi:id="RC" fulfillmentProperty="roomClean" mode="ACHIEVE" wanter="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FHardGoal" name="MaintainBattLoaded" xmi:id="MBL" invariantProperty="batteryLoaded" mode="MAINTAIN" wanter="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FHardGoal" name="WetCleaning" xmi:id="WC" wanter="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FHardGoal" name="DryCleaning" xmi:id="DC" wanter="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FPlan" name="mop" xmi:id="mop" capableOf="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FPlan" name="sweep" xmi:id="sweep" capableOf="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FPlan" name="load battery" xmi:id="loadBattery" capableOf="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FSoftGoal" name="efficiency" xmi:id="efficiency" wanter="CleanerAgent"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FHardGoal" name="RoomClean" xmi:id="RoomCleanDependum"/>
    <TroposClasses xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FSoftGoal" name="efficiency" xmi:id="efficiencyDependum"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:BooleanDecomposition" xmi:id="RC-or" type="OR" rootGoal="RC" actorDecPointOfView="CleanerAgent" BooleanDecLink="WC-OrRefinementLink-RC DC-OrRefinementLink-RC"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:OrDecLink" xmi:id="WC-OrRefinementLink-RC" BooleanDecomposition="RC-or" targetGoal="WC"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:OrDecLink" xmi:id="DC-OrRefinementLink-RC" BooleanDecomposition="RC-or" targetGoal="DC"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:MeansEnd" xmi:id="mop-OrRefinementLink-WC" meansPlan="mop" end="WC" actorMeansEndPointOfView="CleanerAgent"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:MeansEnd" xmi:id="sweep-OrRefinementLink-DC" meansPlan="sweep" end="DC" actorMeansEndPointOfView="CleanerAgent"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:MeansEnd" xmi:id="loadBattery-OrRefinementLink-MBL" meansPlan="loadBattery" end="MBL" actorMeansEndPointOfView="CleanerAgent"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FContribution" xmi:id="mop-ContributionLink-efficiency" metric="-" contributer="mop" contributed="efficiency"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore.formalcore:FContribution" xmi:id="sweep-ContributionLink-efficiency" metric="+" contributer="sweep" contributed="efficiency"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:Dependency" xmi:id="RoomCleanDependum-dependency" depender="Stakeholder" dependee="CleanerAgent" goalDependum="RoomCleanDependum"/>
    <TroposRelations xsi:type="it.itc.sra.taom4e.model.core.informalcore:Dependency" xmi:id="efficiencyDependum-dependency" depender="Stakeholder" dependee="CleanerAgent" goalDependum="efficiencyDependum"/>
  </it.itc.sra.taom4e.model.core.informalcore.formalcore:FormalBusinessModel>
  <xmi:Extension extender="goal-controller" engine="tropos4as">
    <property of="WC" key="type" value="perform"/>
    <property of="DC" key="type" value="perform"/>
    <dependency of="RoomCleanDependum-dependency" depender="Stakeholder-DependencyLink-RoomCleanDependum" dependee="RoomCleanDependum-DependencyLink-CleanerAgent"/>
    <dependency of="efficiencyDependum-dependency" depender="Stakeholder-DependencyLink-efficiencyDependum" dependee="efficiencyDependum-DependencyLink-CleanerAgent"/>
    <order of="Stakeholder" ids=""/>
    <order of="CleanerAgent" ids="RC MBL WC DC mop sweep loadBattery efficiency"/>
    <order of="" ids=""/>
    <diagram>
      <property key="title" value="Cleaner Agent"/>
      <property key="author" value="goal-controller"/>
      <property key="source" value="AAMAS 2009, Morandini, Penserini, Perini, Fig. 1"/>
      <property key="lastUpdated" value="2026-10-15"/>
    </diagram>
  </xmi:Extension>
</xmi:XMI>
