<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:it.itc.sra.taom4e.model.project="http:///it/itc/sra/taom4e/model/project.ecore" xmlns:it.itc.sra.taom4e.model.core.informalcore="http:///it/itc/sra/taom4e/model/core/informalcore.ecore" xmlns:it.itc.sra.taom4e.model.core.informalcore.formalcore="http:///it/itc/sra/taom4e/model/core/informalcore/formalcore.ecore" xmlns:it.itc.sra.taom4e.model.diagram.goaldiagram="http:///it/itc/sra/taom4e/model/diagram/goaldiagram.ecore" xmlns:it.itc.sra.taom4e.model.diagram.actordiagram="http:///it/itc/sra/taom4e/model/diagram/actordiagram.ecore">
  <it.itc.sra.taom4e.model.project:Project name="Cleaner Agent" BusinessModel="business-model">
    <Diagram xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GoalDiagram" name="Stakehoder" xmi:id="Stakeholder-diagram" phase="LR" Actor="Stakeholder">
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_ActorUI" xmi:id="Stakeholder-figure" x="37" y="59" core="Stakeholder"/>
    </Diagram>
    <Diagram xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GoalDiagram" name="Cleaner Agent" xmi:id="CleanerAgent-diagram" phase="LR" Actor="CleanerAgent">
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_ActorUI" xmi:id="CleanerAgent-figure" x="324" y="53" core="CleanerAgent" children="RC-figure MBL-figure WC-figure DC-figure mop-figure sweep-figure loadBattery-figure efficiency-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_HardGoalUI" xmi:id="RC-figure" x="393" y="141" width="132" height="42" core="RC" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_HardGoalUI" xmi:id="MBL-figure" x="576" y="168" width="150" height="66" core="MBL" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_HardGoalUI" xmi:id="WC-figure" x="288" y="263" width="144" height="48" core="WC" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_HardGoalUI" xmi:id="DC-figure" x="458" y="258" width="141" height="48" core="DC" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_PlanUI" xmi:id="mop-figure" x="302" y="358" width="81" height="45" core="mop" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_PlanUI" xmi:id="sweep-figure" x="498" y="354" width="108" height="45" core="sweep" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_PlanUI" xmi:id="loadBattery-figure" x="580" y="303" width="183" height="48" core="loadBattery" container="CleanerAgent-figure"/>
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.goaldiagram:GD_SoftGoalUI" xmi:id="efficiency-figure" x="400" y="422" width="117" height="45" core="efficiency" container="CleanerAgent-figure"/>
    </Diagram>
    <Diagram xsi:type="it.itc.sra.taom4e.model.diagram.actordiagram:ActorDiagram" name="Actor diagram" xmi:id="actor-diagram" phase="ER">
      <DiagramNodes xsi:type="it.itc.sra.taom4e.model.diagram.actordiagram:AD_ActorUI" xmi:id="Stakeholder-actor-figure" x="37" y="59" core="Stakeholder"/>
