formula g18_achieved = (t19_achieved | t20_achieved);
formula G18_achievable = g18_chosen=1 ? T19_achievable : g18_chosen=2 ? T20_achievable : (T19_achievable + T20_achievable - (T19_achievable * T20_achievable));

// ID: G21
// Name: goal
// Type: sequence
