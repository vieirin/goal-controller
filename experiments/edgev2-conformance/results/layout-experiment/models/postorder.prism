// ID: G0
// Name: goal
// Type: degradation
// Relation to children: or
// Children: G1, G16


formula g0_achieved = (g1_achieved | (g1_failed=3 & g16_achieved));
formula G0_achievable = G1_achievable + G16_achievable - (G1_achievable * G16_achievable);

// ID: G1
// Name: goal
// Type: anyOrder
// Relation to children: and
// Children: G2, G9


formula g1_achieved = (g2_achieved & g9_achieved);
formula G1_achievable = g1_achieved ? 0 : (!g2_achieved ? G2_achievable : 1) * (!g9_achieved ? G9_achievable : 1);
formula G2_relative = g2_achieved ? 0 : G2_achievable/(G2_achievable + (g9_achieved ? 0 : G9_achievable));
formula G9_relative = g9_achieved ? 0 : G9_achievable/(G9_achievable + (g2_achieved ? 0 : G2_achievable));

// ID: G2
// Name: goal
// Type: interleaved
// Relation to children: and
// Children: G3, G6


formula g2_achieved = (g3_achieved & g6_achieved);
formula G2_achievable = g2_achieved ? 0 : (!g3_achieved ? G3_achievable : 1) * (!g6_achieved ? G6_achievable : 1);

// ID: G3
// Name: goal
// Type: degradation
// Relation to children: or
