module G3
  g3_state : [0..1] init 0;
  t4_failed : [0..3] init 0;

  [pursue_G3] !g3_achieved & g3_state=0 -> (g3_state'=1);
  [pursue_T4] !g3_achieved & g3_state=1 & t4_failed<3 & T4_achievable*N > decision_T4 -> (t4_failed'=t4_failed+1);
  [pursue_T4] !g3_achieved & g3_state=1 & t4_failed=3 & G3_achievable*N > decision_G3 & t5_state=0 & (T4_achievable/(T4_achievable+T5_achievable))*N > _decision_G3 -> true;
  [pursue_T5] !g3_achieved & g3_state=1 & t4_failed=3 & G3_achievable*N > decision_G3 & t4_state=0 & (T5_achievable/(T4_achievable+T5_achievable))*N > _decision_G3 & !((T4_achievable/(T4_achievable+T5_achievable))*N > _decision_G3) -> true;

  [achieved_G3] g3_state=1 & g3_achieved & t4_state=0 & t5_state=0 -> (g3_state'=0);
  
  [skip_G3] !g3_achieved & g3_state=1 & t4_state=0 & t4_failed<3 & T4_achievable*N <= decision_T4 -> (g3_state'=0);
  [skip_G3] t4_failed=3 & !g3_achieved & g3_state=1 & t4_state=0 & t5_state=0 & G3_achievable*N <= decision_G3 -> (g3_state'=0);
endmodule

