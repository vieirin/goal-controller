{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmitOnError": false,
    "lib": ["es2022", "dom"],
    // the dialect tests run the UI's React-free workbench modules (lib/workbench)
    "baseUrl": ".",
    "paths": {
      "@/*": ["../ui/*"],
      "langium": ["../goal-language/node_modules/langium/lib/index.d.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
