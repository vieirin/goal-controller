{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmitOnError": false,
    "lib": ["es2022", "dom"],
    // the dialect tests run the UI's React-free workbench modules (lib/workbench)
    "baseUrl": ".",
    "paths": {
      "@/*": ["../ui/*"],
      "langium": ["../goal-language/node_modules/langium/lib/index.d.ts"],
      "@istar-ts/dsm3-kaos/metamodel": [
        "./node_modules/@istar-ts/dsm3-kaos/dist/metamodel.d.cts"
      ],
      "@istar-ts/dsm3-nfr/metamodel": [
        "./node_modules/@istar-ts/dsm3-nfr/dist/metamodel.d.cts"
      ]
    }
  },
  "include": ["src/**/*", "test/dialect/**/*"]
}
