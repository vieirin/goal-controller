{
  "name": "@goal-controller/lib",
  "version": "1.0.0",
  "description": "Core transformation engines for goal models (PRISM/SLEEC)",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "bin": {
    "goal-controller": "out/index.js",
    "goal-controller-cli": "out/cli.js"
  },
  "scripts": {
    "build": "rm -rf out tsconfig.tsbuildinfo && node scripts/langium-generate.mjs && tsc && node build.mjs",
    "watch": "node build.mjs --watch & tsc --watch",
    "test": "TS_NODE_COMPILER_OPTIONS='{\"strict\":false,\"noImplicitAny\":false}' mocha && pnpm run test:dialect",
    "test:dialect": "TS_NODE_PROJECT=./tsconfig.dialect-test.json mocha --config .mocharc.dialect.json",
    "test:only": "TS_NODE_COMPILER_OPTIONS='{\"strict\":false,\"noImplicitAny\":false}' mocha --no-config -r ts-node/register -r ./test/support/langium.cjs --extension ts -n loader=ts-node/esm --timeout 10000 --reporter dot",
    "clean": "rm -rf out tsconfig.tsbuildinfo",
    "dev": "node --experimental-strip-types src/cli.ts",
    "generate": "node scripts/langium-generate.mjs src/engines test/dialect/support"
  },
  "dependencies": {
    "@goal-controller/dialect": "workspace:*",
    "@goal-controller/goal-language": "workspace:*",
    "@goal-controller/goal-tree": "workspace:*",
    "@istar-ts/dsm3-kaos": "0.15.0-beta.0",
    "@istar-ts/dsm3-nfr": "0.15.0-beta.0",
    "@rgrove/parse-xml": "4.2.3",
    "inquirer": "^12.5.2",
    "jsonc-parser": "^3.3",
    "lodash": "^4.17.21",
    "lodash.groupby": "^4.6.0",
    "lodash.mergewith": "^4.6.2",
    "minimatch": "^9.0.3",
    "yaml": "^2.9",
    "zod": "^4.1"
  },
  "devDependencies": {
    "@istar-ts/core": "0.15.0-beta.0",
    "@types/chai": "^4.3.11",
    "@types/inquirer": "^9.0.7",
    "@types/lodash": "^4.14.197",
    "@types/lodash.groupby": "^4.6.7",
    "@types/lodash.mergewith": "^4.6.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.6.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "babel-eslint": "^10.1.0",
    "chai": "^4.3.10",
    "esbuild": "^0.28.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-standard-with-typescript": "^37.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-n": "^16.0.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-rulesdir": "^0.2.2",
    "langium-cli": "4.4.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
