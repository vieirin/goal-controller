{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "webworker"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./out/esm",
    "rootDir": "./src"
  },
  // so editors prefer this package's .ts over a stale out/esm/*.d.ts (#222)
  "references": [{ "path": "../dialect" }],
  "include": ["src/**/*"]
}
