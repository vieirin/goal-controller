{
  "name": "@goal-controller/goal-language",
  "version": "0.1.0",
  "private": true,
  "description": "The goal language: one Langium grammar every dialect is written in (element lines, the RT notation's operator catalog, predefined value types), its parser and its dialect-aware validator",
  "type": "module",
  "main": "out/cjs/index.cjs",
  "types": "out/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/esm/index.d.ts",
      "import": "./out/esm/index.js",
      "require": "./out/cjs/index.cjs"
    },
    "./langium": {
      "types": "./out/esm/langium.d.ts",
      "import": "./out/esm/langium.js",
      "require": "./out/cjs/langium.cjs"
    },
    "./light": {
      "types": "./out/esm/light.d.ts",
      "import": "./out/esm/light.js",
      "require": "./out/cjs/light.cjs"
    },
    "./formats": {
      "types": "./out/esm/formats/index.d.ts",
      "import": "./out/esm/formats/index.js",
      "require": "./out/cjs/formats.cjs"
    },
    "./lsp": {
      "types": "./out/esm/lsp/server.d.ts",
      "import": "./out/esm/lsp/server.js",
      "require": "./out/cjs/lsp.cjs"
    },
    "./worker": {
      "types": "./out/esm/lsp/worker.d.ts",
      "import": "./out/esm/lsp/worker.js"
    }
  },
  "typesVersions": {
    "*": {
      "light": [
        "out/esm/light.d.ts"
      ],
      "lsp": [
        "out/esm/lsp/server.d.ts"
      ],
      "formats": [
        "out/esm/formats/index.d.ts"
      ]
    }
  },
  "scripts": {
    "generate": "langium generate",
    "build": "rm -rf out && tsc && node build.mjs",
    "watch": "tsc --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck && mocha",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@goal-controller/dialect": "workspace:*",
    "@xml-tools/ast": "^5.0.6",
    "@xml-tools/parser": "1.0.12",
    "chevrotain": "~13.2.0",
    "langium": "4.4.0",
    "vscode-languageserver": "~10.1.0",
    "zod": "^4.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.6.0",
    "chai": "^4.3.10",
    "esbuild": "^0.28.2",
    "langium-cli": "4.4.0",
    "mocha": "^10.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
