{
  "name": "@goal-controller/ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash -c 'pnpm --filter @goal-controller/lib run watch & trap \"kill 0\" EXIT; pnpm run dev:next'",
    "dev:next": "node scripts/examples-manifest.mjs --local && bash -c 'node scripts/examples-manifest.mjs --local --watch & trap \"kill 0\" EXIT; next dev --turbopack'",
    "build": "node scripts/examples-manifest.mjs && next build",
    "lint": "next lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@goal-controller/dialect": "workspace:*",
    "@goal-controller/goal-language": "workspace:*",
    "@goal-controller/goal-tree": "workspace:*",
    "@goal-controller/lib": "workspace:*",
    "@eclipse-glsp/server-mcp": "2.8.0",
    "@istar-ts/actions": "0.15.0-beta.3",
    "@istar-ts/agent": "0.15.0-beta.3",
    "@istar-ts/core": "0.15.0-beta.3",
    "@istar-ts/dsm3-kaos": "0.15.0-beta.3",
    "@istar-ts/dsm3-nfr": "0.15.0-beta.3",
    "@istar-ts/glsp": "0.15.0-beta.3",
    "@istar-ts/gmodel": "0.15.0-beta.3",
    "@istar-ts/react": "0.15.0-beta.3",
    "@lezer/highlight": "^1.2.4",
    "@tanstack/react-query": "^5.62.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.300.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.13.3",
    "zod": "^4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
